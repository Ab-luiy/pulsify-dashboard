+  console.log("PASS impersonation: mint, one-time exchange, read access, all write blocks, normal writes, expiry, audit, non-escalation, rate limit, and logout");
+} catch (error) {
+  console.error(`FAIL impersonation: ${error?.stack || error}`);
+  process.exitCode = 1;
+}

