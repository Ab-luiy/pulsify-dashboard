  gap: 24px;
  margin-top: 32px;
}
.wizard-form.two { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
.wizard-inline-status {
  min-height: 18px;
  margin-top: 6px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.5;
}
.wizard-inline-status.valid { color: var(--success); }
.wizard-inline-status.invalid { color: var(--failure); }
.wizard-inline-status.taken { color: var(--accent); }
.wizard-open-existing { margin-top: 4px; font-size: 11px; }
.wizard-card-grid {
