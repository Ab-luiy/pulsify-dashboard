diff --git a/output/standard-preview/migrations/0016_impersonation_sessions.sql b/output/standard-preview/migrations/0016_impersonation_sessions.sql
new file mode 100644
index 0000000000000000000000000000000000000000..20f72fb7b9f439a9ed4858ce76474c5d23835776
--- /dev/null
+++ b/output/standard-preview/migrations/0016_impersonation_sessions.sql
@@ -0,0 +1,18 @@
+-- Operator god-view Phase 2: short-lived, read-only client impersonation.
+
+CREATE TABLE IF NOT EXISTS impersonation_sessions (
+  id            INTEGER PRIMARY KEY AUTOINCREMENT,
+  token_hash    TEXT UNIQUE,
+  exchange_hash TEXT UNIQUE,
+  client_id     TEXT NOT NULL,
+  created_at    TEXT NOT NULL,
+  expires_at    TEXT NOT NULL,
+  created_by    TEXT NOT NULL,
+  consumed_at   TEXT
+);
+
+CREATE INDEX IF NOT EXISTS idx_impersonation_sessions_client_expiry
+  ON impersonation_sessions (client_id, expires_at);
+
+CREATE INDEX IF NOT EXISTS idx_impersonation_sessions_creator_time
+  ON impersonation_sessions (created_by, created_at DESC);
