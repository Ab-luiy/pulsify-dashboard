  flex: 0 0 8px;
  border-radius: 999px;
  background: var(--line);
}
.wizard-progress li.complete,
.wizard-progress li.current { background: var(--accent); }
.wizard-progress li.current { box-shadow: 0 0 0 3px var(--accent-soft); }
.wizard-body {
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 56px 0 40px;
  scrollbar-gutter: stable;
}
.wizard-step { animation: wizard-in .18s ease-out; }
@keyframes wizard-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}
.wizard-step h2 { margin-top: 8px; font-size: clamp(1.75rem, 5vw, 2.25rem); line-height: 1.08; }
.wizard-intro {
  max-width: 640px;
  margin-top: 8px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
}
.wizard-form {
