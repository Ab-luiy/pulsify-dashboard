+async function testEveryWriteRejectsImpersonation() {
+  const db = new MockDB();
+  const env = { ADMIN_KEY: "secret", DB: db, MEDIA: new MockMedia() };
+  const token = "impersonation-session";
+  await seedSession(db, token, true);
