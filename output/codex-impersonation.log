      this.db.proof.push({
        id,
        client_id: clientId,
        kind: "image",
        url,
        claim,
        permission: "unknown",
        created_at: createdAt,
      });
      return { meta: { changes: 1, last_row_id: id } };
    }
    throw new Error(`Unexpected run query: ${this.sql}`);
  }
}

class MockMedia {
  constructor() {
    this.objects = new Map();
    this.calls = { put: 0, get: 0, delete: 0, list: 0 };
  }

  async put(key, value, options = {}) {
    this.calls.put += 1;
    const body = value instanceof ReadableStream
      ? await new Response(value).arrayBuffer()
      : await new Response(value).arrayBuffer();
    this.objects.set(key, {
      body,
      httpMetadata: options.httpMetadata || {},
      customMetadata: options.customMetadata || {},
    });
  }

  async get(key) {
    this.calls.get += 1;
    const stored = this.objects.get(key);
    if (!stored) return null;
    return {
      body: stored.body.slice(0),
      httpMetadata: stored.httpMetadata,
      httpEtag: `"mock-${key}"`,
    };
  }

  async delete(keys) {
    this.calls.delete += 1;
    for (const key of Array.isArray(keys) ? keys : [keys]) this.objects.delete(key);
  }

  async list({ prefix = "" } = {}) {
    this.calls.list += 1;
    return {
      objects: [...this.objects.keys()].filter((key) => key.startsWith(prefix)).map((key) => ({ key })),
      truncated: false,
    };
  }
}

async function sha256Hex(value) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

function uploadRequest(token, file, claim = "") {
  const form = new FormData();
