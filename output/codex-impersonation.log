const CONTENT_STAGES = new Set(["production", "scheduled", "published"]);
const ASSET_KINDS = new Set(["script", "hook", "swipe", "doc", "other"]);

const FIELDS = {
  content: {
    table: "content_items",
    columns: ["title", "stage", "platform", "url", "notes", "scheduled_for"],
    timestampColumn: "updated_at",
    required: ["title"],
    normalize(item) {
      return {
        title: str(item.title),
        stage: CONTENT_STAGES.has(item.stage) ? item.stage : "production",
        platform: strOrNull(item.platform),
        url: strOrNull(item.url),
        notes: strOrNull(item.notes),
        scheduled_for: strOrNull(item.scheduled_for),
      };
    },
  },
  call: {
    table: "call_notes",
    columns: ["call_date", "title", "summary", "decisions", "actions", "recording_url"],
    timestampColumn: "created_at",
    required: [],
    normalize(item) {
      return {
        call_date: strOrNull(item.call_date),
        title: strOrNull(item.title),
        summary: strOrNull(item.summary),
        decisions: strOrNull(item.decisions),
        actions: strOrNull(item.actions),
        recording_url: strOrNull(item.recording_url),
      };
    },
  },
  asset: {
    table: "client_assets",
    columns: ["label", "kind", "url", "notes"],
    timestampColumn: "created_at",
    required: ["label"],
    normalize(item) {
      return {
        label: str(item.label),
        kind: ASSET_KINDS.has(item.kind) ? item.kind : "other",
        url: strOrNull(item.url),
        notes: strOrNull(item.notes),
      };
    },
  },
};

export async function onRequestGet({ request, env }) {
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const url = new URL(request.url);
  const access = await resolveAccess(request, env, url);
  if (access.error) return access.error;
  const client = access.client;

  const [content, calls, assets, integrations] = await Promise.all([
    safeAll(
      env.DB.prepare(
        `SELECT id,client,title,stage,platform,url,notes,scheduled_for,updated_at
           FROM content_items WHERE client=?
           ORDER BY CASE stage WHEN 'production' THEN 0 WHEN 'scheduled' THEN 1 WHEN 'published' THEN 2 ELSE 3 END,
                    updated_at DESC`,
      ).bind(client),
    ),
    safeAll(
      env.DB.prepare(
        `SELECT id,client,call_date,title,summary,decisions,actions,recording_url,created_at
           FROM call_notes WHERE client=? ORDER BY call_date DESC, created_at DESC`,
      ).bind(client),
    ),
    safeAll(
      env.DB.prepare(
        `SELECT id,client,label,kind,url,notes,created_at
           FROM client_assets WHERE client=? ORDER BY created_at DESC`,
      ).bind(client),
    ),
    getClientIntegrationStatuses(env, client).catch(() => []),
  ]);

  return json({
    ok: true,
    client,
    content: content.rows,
    calls: calls.rows,
    assets: assets.rows,
    integrations,
    pending: content.pending || calls.pending || assets.pending,
  });
}

export async function onRequestPost({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const client = cleanId(body.client || "");
  if (!client) return json({ ok: false, error: "valid client id required" }, 422);

  const type = body.type;
  const spec = FIELDS[type];
  if (!spec) return json({ ok: false, error: `unknown type: ${type}` }, 422);

  const item = body.item && typeof body.item === "object" ? body.item : {};
  const values = spec.normalize(item);
  for (const field of spec.required) {
    if (!values[field]) return json({ ok: false, error: `${field} is required` }, 422);
  }

  const now = new Date().toISOString();
  const id = item.id ? Number(item.id) : null;

  if (id) {
    const setClause = spec.columns.map((col) => `${col}=?`).join(",");
    const result = await env.DB.prepare(
      `UPDATE ${spec.table} SET ${setClause}, ${spec.timestampColumn}=? WHERE id=? AND client=?`,
    ).bind(...spec.columns.map((col) => values[col]), now, id, client).run();

    if (!result.meta?.changes) {
      return json({ ok: false, error: "not found for this client" }, 404);
    }
    return json({ ok: true, id, updated: true });
  }

  const insertColumns = ["client", ...spec.columns, spec.timestampColumn];
  const placeholders = insertColumns.map(() => "?").join(",");
  const result = await env.DB.prepare(
    `INSERT INTO ${spec.table} (${insertColumns.join(",")}) VALUES (${placeholders})`,
  ).bind(client, ...spec.columns.map((col) => values[col]), now).run();

  return json({ ok: true, id: result.meta?.last_row_id ?? null, created: true });
}

export async function onRequestDelete({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const client = cleanId(body.client || "");
  const type = body.type;
  const id = Number(body.id);
  const spec = FIELDS[type];
  if (!client || !spec || !id) {
    return json({ ok: false, error: "client, type, and id are required" }, 422);
  }

  const result = await env.DB.prepare(
    `DELETE FROM ${spec.table} WHERE id=? AND client=?`,
  ).bind(id, client).run();

  if (!result.meta?.changes) {
    return json({ ok: false, error: "not found for this client" }, 404);
  }
  return json({ ok: true, deleted: true });
}

export async function onRequestOptions() {
  return new Response(null, {
    headers: {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "GET, POST, DELETE, OPTIONS",
      "access-control-allow-headers": "content-type, x-admin-key, x-portal-token",
      "access-control-max-age": "86400",
    },
  });
}

/**
 * Same dual-auth pattern as functions/leads.js:
 * - x-portal-token: the token itself decides the client; ?client= is ignored.
 * - x-admin-key: operator, any client via ?client=.
 */
async function resolveAccess(request, env, url) {
  const portalToken = request.headers.get("x-portal-token");
  if (portalToken) {
    const hash = await sha256Hex(portalToken.trim());
    const row = await env.DB.prepare(
      "SELECT client FROM client_config WHERE portal_token_hash=?",
    ).bind(hash).first();
    if (!row) {
      return { error: json({ ok: false, error: "invalid or expired portal link" }, 401) };
    }
    return { client: cleanId(row.client), scope: "client" };
  }

  if (!env.ADMIN_KEY) return { error: json({ ok: false, error: "ADMIN_KEY not configured" }, 500) };
  if (request.headers.get("x-admin-key") !== env.ADMIN_KEY) {
    return { error: json({ ok: false, error: "unauthorized" }, 401) };
  }
  return { client: cleanId(url.searchParams.get("client") || "unknown"), scope: "admin" };
}

function checkAdmin(request, env) {
  if (!env.ADMIN_KEY) return json({ ok: false, error: "ADMIN_KEY not configured" }, 500);
  if (request.headers.get("x-admin-key") !== env.ADMIN_KEY) {
    return json({ ok: false, error: "unauthorized" }, 401);
  }
  return null;
}

async function safeAll(stmt) {
  try {
    const result = await stmt.all();
    return { rows: result.results || [], pending: false };
  } catch (e) {
    return { rows: [], pending: true };
  }
}

async function sha256Hex(value) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

function str(value) {
  return String(value ?? "").trim();
}

function strOrNull(value) {
  const s = str(value);
  return s || null;
}

function cleanId(value) {
  return String(value || "unknown").toLowerCase().replace(/[^a-z0-9_-]/g, "").slice(0, 64) || "unknown";
}

function json(object, status = 200) {
  return new Response(JSON.stringify(object), {
    status,
    headers: {
      "content-type": "application/json",
      "access-control-allow-origin": "*",
      "cache-control": "no-store",
    },
  });
}

ONBOARD ROUTE
import { resolveClientAccess } from "../_shared/client-auth.js";

export async function onRequest(context) {
  const path = readPath(context.params);
  if (path && path !== "index.html") return context.next();

  const access = await resolveClientAccess(context.request, context.env, {
    allowHeaderToken: false,
    allowQueryToken: true,
  });
  if (access.error) {
    return new Response("This onboarding link is invalid or no longer active.", {
      status: 401,
      headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store" },
    });
  }

  return serveAsset(context.env, context.request, "/onboard/index.html");
}

async function serveAsset(env, request, assetPath) {
  if (!env.ASSETS) return new Response("Not found", { status: 404 });
  let url = new URL(assetPath, request.url);
  for (let hop = 0; hop < 3; hop += 1) {
    const response = await env.ASSETS.fetch(new Request(url, { headers: request.headers }));
    const location = response.headers.get("location");
    if (response.status >= 301 && response.status <= 308 && location) {
      url = new URL(location, url);
      continue;
    }
    return response;
  }
  return new Response("Not found", { status: 404 });
}

function readPath(params) {
  const value = params?.path;
  if (Array.isArray(value)) return value.join("/").replace(/^\/+|\/+$/g, "");
  return String(value || "").replace(/^\/+|\/+$/g, "");
}

CLIENT EMAIL CODE
import { constantTimeEqual, json, normalizeEmail, nowIso, sha256Hex } from "../_shared/common.js";
import { consumeSetupToken } from "../_shared/client-auth.js";

const CODE_TTL_MINUTES = 10;
const MAX_ATTEMPTS = 5;

export async function onRequestPost({ request, env }) {
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const setupToken = String(body.setup_token || "");
  if (!setupToken) return json({ ok: false, error: "setup token is required" }, 422);

  const setup = await consumeSetupToken(env, setupToken);
  if (!setup) {
    return json({ ok: false, error: "this setup link is invalid or expired" }, 401);
  }

  if (!env.RESEND_API_KEY) {
    return json({ ok: true, requires_code: false, sent: false });
  }
  if (!env.EMAIL_FROM) {
    return json({ ok: false, error: "EMAIL_FROM is not configured" }, 500);
  }

  const email = normalizeEmail(setup.email);
  if (!email) {
    return json({ ok: false, error: "setup email is invalid" }, 422);
  }

  await purgeExpiredCodes(env);
  const code = createCode();
  const codeHash = await sha256Hex(code);
  const expiresAt = new Date(Date.now() + CODE_TTL_MINUTES * 60 * 1000).toISOString();
  const createdAt = nowIso();

  await env.DB.prepare(
    `INSERT INTO client_email_codes (client_id, email, purpose, code_hash, expires_at, attempts, created_at)
     VALUES (?, ?, 'setup', ?, ?, 0, ?)
     ON CONFLICT(client_id, email, purpose) DO UPDATE SET
       code_hash=excluded.code_hash,
       expires_at=excluded.expires_at,
       attempts=0,
       created_at=excluded.created_at`,
  ).bind(setup.client_id, email, codeHash, expiresAt, createdAt).run();

  try {
    await sendSetupCodeEmail(env, {
      email,
      clientId: setup.client_id,
      code,
      expiresAt,
    });
  } catch (error) {
    return json({ ok: false, error: `could not send email code: ${safeMessage(error)}` }, 502);
  }

  return json({
    ok: true,
    requires_code: true,
    sent: true,
    email,
    expires_at: expiresAt,
    max_attempts: MAX_ATTEMPTS,
  });
}

export async function onRequestOptions() {
  return new Response(null, {
    headers: {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "POST, OPTIONS",
      "access-control-allow-headers": "content-type",
      "access-control-max-age": "86400",
    },
  });
}

export async function readSetupCodeRecord(env, clientId, email) {
  await purgeExpiredCodes(env);
  const normalized = normalizeEmail(email || "");
  if (!normalized) return null;
  return env.DB.prepare(
    `SELECT client_id, email, purpose, code_hash, expires_at, attempts, created_at
       FROM client_email_codes
      WHERE client_id=? AND email=? AND purpose='setup'`,
  ).bind(clientId, normalized).first();
}

export async function verifySetupCode(env, setup, code) {
  const row = await readSetupCodeRecord(env, setup.client_id, setup.email);
  if (!row) {
    return { ok: false, error: "email verification code not found. Reload the page and request a new code." };
  }
  if (String(row.expires_at || "") <= nowIso()) {
    await deleteSetupCode(env, setup.client_id, setup.email);
    return { ok: false, error: "email verification code expired. Reload the page and request a new code." };
  }
  if (Number(row.attempts || 0) >= MAX_ATTEMPTS) {
    return { ok: false, error: "too many incorrect code attempts. Reload the page and request a new code." };
  }

  const actual = await sha256Hex(String(code || "").trim());
  if (!constantTimeEqual(actual, row.code_hash || "")) {
    await env.DB.prepare(
      `UPDATE client_email_codes
          SET attempts=attempts + 1
        WHERE client_id=? AND email=? AND purpose='setup'`,
    ).bind(setup.client_id, normalizeEmail(setup.email),).run();
    const refreshed = await readSetupCodeRecord(env, setup.client_id, setup.email);
    const attemptsLeft = Math.max(0, MAX_ATTEMPTS - Number(refreshed?.attempts || 0));
    return {
      ok: false,
      error: attemptsLeft
        ? `Incorrect code. ${attemptsLeft} attempt${attemptsLeft === 1 ? "" : "s"} left.`
        : "Too many incorrect code attempts. Reload the page and request a new code.",
    };
  }

  return { ok: true };
}

export async function deleteSetupCode(env, clientId, email) {
  const normalized = normalizeEmail(email || "");
  if (!normalized) return;
  await env.DB.prepare(
    "DELETE FROM client_email_codes WHERE client_id=? AND email=? AND purpose='setup'",
  ).bind(clientId, normalized).run();
}

async function purgeExpiredCodes(env) {
  await env.DB.prepare(
    "DELETE FROM client_email_codes WHERE expires_at<?",
  ).bind(nowIso()).run();
}

function createCode() {
  return String(Math.floor(Math.random() * 1000000)).padStart(6, "0");
}

async function sendSetupCodeEmail(env, payload) {
  const response = await fetch("https://api.resend.com/emails", {
    method: "POST",
    headers: {
      authorization: `Bearer ${env.RESEND_API_KEY}`,
      "content-type": "application/json",
    },
    body: JSON.stringify({
      from: env.EMAIL_FROM,
      to: [payload.email],
      subject: `Your Pulsify setup code for ${payload.clientId}`,
      text: [
        `Your Pulsify setup code is ${payload.code}.`,
        "It expires in 10 minutes.",
        "If you did not request this code, ignore this email.",
      ].join("\n\n"),
    }),
  });
  if (!response.ok) {
    throw new Error(`${response.status}: ${(await response.text()).slice(0, 400)}`);
  }
}

function safeMessage(error) {
  return String(error?.message || error || "unknown error").slice(0, 400);
}


