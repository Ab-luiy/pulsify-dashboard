diff --git a/output/standard-preview/tests/impersonation.test.mjs b/output/standard-preview/tests/impersonation.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..68498f483a0f0b34bc6d2435aae7466bb355132f
