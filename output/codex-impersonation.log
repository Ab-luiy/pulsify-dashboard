  grid-template-rows: auto minmax(0, 1fr);
  border-left: 1px solid var(--line);
  background: var(--bg);
  box-shadow: -24px 0 70px rgba(0, 0, 0, .18);
}
.activity-drawer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 24px;
  border-bottom: 1px solid var(--line);
  background: var(--surface);
}
.activity-drawer-head h2 { margin: 4px 0; }
.activity-drawer-head p:last-child { color: var(--muted); font-size: 11px; }
.activity-drawer-body { overflow-y: auto; padding: 24px; }
.activity-summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.viewer-list { display: grid; gap: 12px; margin-top: 16px; }
.viewer-card {
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}
.viewer-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}
.viewer-card-head strong,
.viewer-card-head small { display: block; }
.viewer-card-head strong { font-size: 12px; overflow-wrap: anywhere; }
.viewer-card-head small { margin-top: 3px; color: var(--muted); font-size: 9px; overflow-wrap: anywhere; }
.viewer-metrics {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin: 16px 0 0;
}
.viewer-metrics div {
  min-width: 0;
  padding: 10px;
  border-radius: 8px;
  background: var(--surface-2);
}
.viewer-metrics dt { color: var(--muted); font-size: 9px; }
.viewer-metrics dd { margin: 4px 0 0; color: var(--ink); font-size: 11px; font-weight: 800; }

body.wizard-open,
body.modal-open { overflow: hidden; }
.wizard-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  min-width: 0;
  background:
    radial-gradient(circle at 78% -12%, var(--accent-soft) 0, transparent 30rem),
    var(--bg);
}
.wizard-dialog {
  width: 100%;
  min-width: 0;
  min-height: 100vh;
  min-height: 100dvh;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr) auto;
  background: color-mix(in srgb, var(--surface) 96%, transparent);
}
.wizard-head,
.wizard-progress,
.wizard-body,
.wizard-footer {
  width: min(100% - 32px, 760px);
  margin-inline: auto;
}
.wizard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 0 16px;
}
