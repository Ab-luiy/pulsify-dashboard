+++ b/output/standard-preview/portal/index.html
@@ -839,6 +839,87 @@
       opacity: .95;
     }
     .sequence-bar span { position: relative; color: var(--ui-ink); font-size: 10px; font-weight: 800; }
+    .sequence-row.has-retest { border-color: color-mix(in srgb, var(--ui-indigo) 34%, var(--ui-line)); }
+    .retest-lineage {
+      display: flex;
+      align-items: stretch;
+      gap: 8px;
+      flex-wrap: wrap;
+      margin: 14px 0 4px;
+      padding: 12px;
+      border: 1px solid var(--ui-line);
+      border-radius: 14px;
+      background: color-mix(in srgb, var(--ui-panel-2) 92%, transparent);
+    }
+    .retest-variant {
+      min-width: 116px;
+      flex: 1 1 116px;
+      padding: 10px 11px;
+      border: 1px solid var(--ui-line);
+      border-radius: 11px;
+      background: var(--ui-panel);
+    }
+    .retest-variant.won { border-color: color-mix(in srgb, var(--ui-accent) 55%, var(--ui-line)); background: var(--ui-accent-soft); }
+    .retest-variant.lost { opacity: .68; }
+    .retest-variant.testing { border-color: color-mix(in srgb, var(--ui-indigo) 55%, var(--ui-line)); }
