        })),
      }) }] } }],
    }), { status: 200, headers: { "content-type": "application/json" } });
  };
  try {
    const response = await carouselApi.onRequestPost({
      request: request("POST", {
        action: "generate",
        manual_mode: false,
        structure: "philosophy",
        topic: "Beliefs that change the work",
        goal: "dms",
      }, { "x-portal-token": alphaToken }),
