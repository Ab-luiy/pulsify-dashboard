+  assert.match(portal, /function getSequenceRead\(\) \{[\s\S]*?const activeRetest = state\.performance\.variantGroups[\s\S]*?return \{ rows, title, text, tab, label, leak, best, activeRetest, resolvedRetest \};/);
+}
+
+try {
