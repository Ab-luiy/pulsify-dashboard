 {n:'Notion',cat:'Automation and CRM',l:'N',c:'#111',on:0,blurb:'Push call notes and content plans into the client workspace.',syncs:['Pages and databases'],scopes:['Read and write pages'],fields:[{label:'Internal token',ph:'secret_...'}]},
 {n:'HubSpot',cat:'Automation and CRM',l:'H',c:'#ff7a59',on:0,blurb:'Enterprise CRM for clients who already live in it.',syncs:['Contacts and deals'],scopes:['Read contacts'],fields:[{label:'Private app token',ph:'pat-...'}]},
 {n:'Google Analytics',cat:'Analytics',l:'G',c:'#e37400',on:0,blurb:'Funnel and landing-page traffic behind the numbers.',syncs:['Sessions and sources','Funnel steps'],scopes:['Read reports'],fields:[{label:'Measurement id',ph:'G-...'}]},
 {n:'Meta Pixel',cat:'Analytics',l:'M',c:'#0866ff',on:0,blurb:'Conversion tracking for when paid ads switch on.',syncs:['Page views and conversions'],scopes:['Read events'],fields:[{label:'Pixel id',ph:'...'}]}
];
const AUTOS=[
 {trig:'Payment lands',trigIc:'ti-currency-dollar',act:'Fire onboarding, create login',on:1,runs:'2 runs'},
 {trig:'DM with trigger word',trigIc:'ti-message-2',act:'Tag in Kit, notify setter',on:1,runs:'41 runs'},
 {trig:'Completion drops below 40%',trigIc:'ti-trending-down',act:'Flag it, draft a retest',on:1,runs:'3 runs'},
 {trig:'New booked call',trigIc:'ti-calendar-event',act:'Alert the team in Slack',on:1,runs:'6 runs'},
 {trig:'Every Monday',trigIc:'ti-mail',act:'Email the client their weekly read',on:0,runs:'paused'}
];
const SETNAV=[['workspace','Workspace'],['brand','Brand voice'],['content','Content'],['notifications','Notifications'],['access','Access'],['billing','Billing']];

/* ---------- nav ---------- */
document.querySelectorAll('.nav-item[data-tab]').forEach(b=>b.onclick=()=>go(b.dataset.tab));
function go(tab){document.querySelectorAll('.nav-item[data-tab]').forEach(n=>n.classList.toggle('active',n.dataset.tab===tab));document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.dataset.panel===tab));$('crumb').textContent=tab.charAt(0).toUpperCase()+tab.slice(1).replace('-',' ');window.scrollTo({top:0})}
function scrollToEl(id){document.getElementById(id).scrollIntoView({behavior:'smooth',block:'start'})}

/* ---------- profile ---------- */
function openBioModal(){show('bioModal')}

/* ---------- studio type cards ---------- */
$('studioGrid').innerHTML=TYPES.map((t,i)=>`<button class="type-card" onclick="openType(${i})"><span class="go"><i class="ti ti-arrow-up-right"></i></span><div class="ic" style="background:${t.bg};color:${t.c}"><i class="ti ${t.ic}"></i></div><b>${t.k}</b><p>${t.d}</p><div class="chips">${t.chips.map((c,j)=>`<span class="badge ${j===0?'b-green':'b-gray'}">${c}</span>`).join('')}</div></button>`).join('');
function openType(i){const t=TYPES[i];$('tmIc').style.background=t.bg;$('tmIc').style.color=t.c;$('tmIc').innerHTML=`<i class="ti ${t.ic}"></i>`;$('tmTitle').textContent=t.k+' sequence';$('tmSub').textContent=t.d;show('typeModal')}
function openCarouselCreate(){toast('Carousel builder','Methodology, taxonomy, or philosophy set')}

/* ---------- pipeline ---------- */
$('pipe').innerHTML=PIPE.map((s,i)=>`${i>0?'<div class="pipe-flow"><i class="ti ti-chevron-right"></i></div>':''}<button class="pipe-stage" data-stage="${s.k}" onclick="filterStage('${s.k}',this)"><div class="st-top"><span class="dotb" style="background:${s.c}"></span> ${s.lab}</div><div class="n mono">${s.n}</div><div class="lb">${s.k==='live'?'tracking now':s.k==='testing'?'variant running':'items'}</div></button>`).join('');
let curStage=null;
function filterStage(k,el){const on=curStage===k;curStage=on?null:k;document.querySelectorAll('.pipe-stage').forEach(p=>p.classList.remove('on'));if(!on)el.classList.add('on');const map={live:'live',review:'review',testing:'testing',scheduled:'review',draft:'review',idea:'all'};seqFilter=on?'all':(map[k]||'all');document.querySelectorAll('#seqSeg button').forEach(b=>b.classList.toggle('on',b.dataset.f===seqFilter));renderSeq();if(!on){scrollToEl('seqLib');toast('Filtered','Showing '+k+' sequences')}}

/* ---------- frames ---------- */
$('frames').innerHTML=FRAMES.map((f,i)=>`<div class="frame"><div class="ft"><i class="ti ${f.ic}"></i> ${f.type}</div><h4>${f.title}</h4><div class="fm"><span>used <b>${f.used}x</b></span><span>avg <b>${f.avg}%</b></span><span><b>${f.steps}</b> slides</span></div><div class="steps">${Array.from({length:f.steps}).map(()=>'<i></i>').join('')}</div><button class="btn btn-soft frame-cta" onclick="openType(${f.seed})"><i class="ti ti-copy"></i> Create from this frame</button></div>`).join('');

/* ---------- sequence library ---------- */
let seqFilter='all';
function miniSpark(curve){const mx=Math.max(...curve);return `<div class="mini-spark">${curve.map((v,i)=>`<i class="${curve[i]<curve[i-1]-20?'drop':''}" style="height:${Math.max(12,v/mx*100)}%"></i>`).join('')}</div>`}
function seqCard(s,i){
 const testing=s.status==='testing';
 const lineage=s.variants?`<div class="lineage">${s.variants.map((v,j)=>`${j>0?'<span class="arr"><i class="ti ti-arrow-right"></i></span>':''}<div class="v ${v.testing?'':(v.comp>=s.comp&&j>0?'win':'')}"><b>${v.v}</b> ${v.testing?'<span class="badge b-rose">testing</span>':v.comp+'%'}</div>`).join('')}</div>`:'';
 const widgets=testing?`<span class="badge b-rose"><i class="ti ti-flask"></i> retest live</span><i class="ti ti-chevron-down fold-chev"></i>`
   :(s.comp===null?`<span class="badge b-amber">awaiting approval</span><i class="ti ti-chevron-down fold-chev"></i>`
   :`<div class="mini-w"><b>${s.comp}%</b><span>done</span></div><div class="mini-w"><b>${s.dm}</b><span>DMs</span></div>${miniSpark(s.curve)}<i class="ti ti-chevron-down fold-chev"></i>`);
 const dc={rose:'var(--rose-soft);color:var(--rose-ink)',amber:'var(--amber-soft);color:var(--amber-ink)',accent:'var(--accent-soft);color:var(--accent-ink)',indigo:'var(--indigo-soft);color:var(--indigo-ink)'}[s.diag.c];
 const stc=s.statusc==='b-green'?'var(--accent-ink)':s.statusc==='b-rose'?'var(--rose-ink)':'var(--amber-ink)';
 return `<div class="fold" id="sf${i}"><div class="fold-head" role="button" tabindex="0" aria-expanded="false" onclick="toggleFold('sf${i}')" onkeydown="foldKey(event,'sf${i}')">
   <div class="fold-tag">${s.date}<span class="status" style="color:${stc}">${s.status}</span></div>
   <div class="fold-title"><b>${s.topic}</b><div class="sub"><span class="badge b-gray">${s.type}</span><span>${s.views} views</span></div></div>
   <div class="fold-widgets">${widgets}</div></div>
   <div class="fold-body"><div><div class="fold-inner">
     <div class="fold-diag"><div class="di" style="background:${dc}"><i class="ti ${s.diag.ic}"></i></div><div>${s.diag.t}</div></div>
     ${lineage}
     <div class="mini-slides">${s.slides.map(sl=>`<div class="mini-slide ${sl.leak?'leak':''}"><div class="n">${sl.n}</div><div class="t">${sl.t}</div>${sl.r?`<span class="ret">${sl.r}%</span>`:''}</div>`).join('')}</div>
     <div class="fold-actions">${testing?`<button class="btn btn-ghost btn-sm"><i class="ti ti-git-compare"></i> Compare variants</button>`:`<button class="btn btn-ghost btn-sm"><i class="ti ti-edit"></i> Edit slides</button>`}<button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();openType(${Math.max(0,TYPES.findIndex(t=>t.k===s.type))})"><i class="ti ti-copy"></i> Make another like this</button>${s.slides.some(sl=>sl.leak)?`<button class="btn btn-soft btn-sm" onclick="event.stopPropagation();openRetest(${i})"><i class="ti ti-flask"></i> Retest hook</button>`:''}<button class="btn btn-ghost btn-sm"><i class="ti ti-external-link"></i> View full</button></div>
   </div></div></div></div>`;
}
function renderSeq(){const list=SEQS.filter(s=>seqFilter==='all'||s.status===seqFilter);$('seqLib').innerHTML=list.length?list.map((s)=>seqCard(s,SEQS.indexOf(s))).join(''):`<div class="empty"><div class="ei"><i class="ti ti-mood-search"></i></div><h4>Nothing here yet</h4><p>No ${seqFilter} sequences right now. Create one from a type above or a winning frame.</p><button class="btn btn-primary" onclick="scrollToEl('createRow')"><i class="ti ti-plus"></i> Create a sequence</button></div>`}
document.querySelectorAll('#seqSeg button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#seqSeg button').forEach(x=>x.classList.remove('on'));b.classList.add('on');seqFilter=b.dataset.f;renderSeq()});
renderSeq();

/* ---------- carousels ---------- */
$('carLib').innerHTML=CARS.map((c,i)=>`
 <div class="fold" id="cf${i}"><div class="fold-head" role="button" tabindex="0" aria-expanded="false" onclick="toggleFold('cf${i}')" onkeydown="foldKey(event,'cf${i}')">
   <div class="fold-tag">Carousel ${c.num}</div>
   <div class="fold-title"><b>${c.title}</b><div class="sub"><span class="badge b-indigo">${c.type}</span><span>${c.date}</span><span>${c.slides.length} slides</span></div></div>
   <div class="fold-widgets"><div class="mini-w"><b>${c.saves}</b><span>saves</span></div><div class="mini-w"><b>${c.reach}</b><span>reach</span></div><i class="ti ti-chevron-down fold-chev"></i></div></div>
   <div class="fold-body"><div><div class="fold-inner">
     <div class="car-slides">${c.slides.map((sl,j)=>`<div class="car-slide"><div class="num">${String(j+1).padStart(2,'0')}</div><div class="cap">${sl}</div></div>`).join('')}</div>
     <div class="fold-actions"><button class="btn btn-ghost btn-sm"><i class="ti ti-edit"></i> Edit</button><button class="btn btn-ghost btn-sm" onclick="openCarouselCreate()"><i class="ti ti-copy"></i> Make another like this</button><button class="btn btn-ghost btn-sm"><i class="ti ti-external-link"></i> View full</button></div>
   </div></div></div></div>`).join('');
function toggleFold(id){const el=$(id);el.classList.toggle('open');const h=el.querySelector('.fold-head');if(h)h.setAttribute('aria-expanded',el.classList.contains('open'))}

/* ---------- reels: capture to content ---------- */
const ANGLES=[
 {from:'A win',ic:'ti-trophy',to:'Credibility sequence or a proof reel'},
 {from:'A new strategy',ic:'ti-bulb',to:'Value-driven sequence or a breakdown'},
 {from:'A recurring belief',ic:'ti-refresh',to:'Philosophy carousel or a reframe reel'},
 {from:'An objection you heard',ic:'ti-message-2',to:'Q and A sequence or a myth-buster reel'},
 {from:'A behind-the-scenes moment',ic:'ti-camera',to:'Day-in-the-life story or a lifestyle reel'},
 {from:'A client transformation',ic:'ti-chart-arrows-vertical',to:'Proof pin post plus a long-form breakdown'}
];
$('angleLib').innerHTML=ANGLES.map(a=>`<div class="angle-card"><div class="from"><i class="ti ${a.ic}" style="color:var(--accent-ink)"></i> ${a.from}</div><div class="to"><i class="ti ti-arrow-right"></i> ${a.to}</div></div>`).join('');
const REFRAMES=[
 {tag:'reel',t:'A 20-second talking head: "Everyone chases followers. Here is why that is backwards."'},
 {tag:'story',t:'A value-driven sequence walking through one profile fix, slide by slide.'},
 {tag:'carousel',t:'A philosophy set: 5 reasons a small converting audience beats a big passive one.'},
 {tag:'long-form',t:'A breakdown video: the profile funnel math, 10k followers to 18 buyers.'},
 {tag:'hook',t:'"I grew slower than everyone in my niche and out-earned all of them. Here is how."'}
];
$('rotList').innerHTML=REFRAMES.map(r=>`<div class="rot-item"><span class="tag">${r.tag}</span><div>${r.t}</div></div>`).join('');
const FMTS=[{ic:'ti-video',lab:'Reel',c:'var(--accent-ink)'},{ic:'ti-layers-subtract',lab:'Story sequence',c:'var(--indigo-ink)'},{ic:'ti-layout-grid',lab:'Carousel',c:'var(--indigo-ink)'},{ic:'ti-brand-youtube',lab:'Long-form segment',c:'var(--rose-ink)'}];
const THOUGHTS=[
 {t:'Closed a client who was skeptical about paying upfront',angle:'A win to credibility',ic:'ti-trophy',fmts:['A 20-second story of the objection and how it flipped.','The skeptic-to-client arc across 8 slides.','3 objections buyers have about upfront pricing, handled.','A breakdown of how you price and de-risk the first payment.']},
 {t:'Most people set their bio to a job title and get skipped',angle:'A belief to reframe',ic:'ti-refresh',fmts:['"Your bio is a job title. That is why you get skipped."','The 3-second bio test, slide by slide.','Category-of-one naming, 5 examples.','The full bio doctrine breakdown for long form.']}
];
function renderThoughts(){$('thoughtList').innerHTML=THOUGHTS.map((th,i)=>`<div class="thought" id="th${i}"><div class="thought-head" role="button" tabindex="0" aria-expanded="false" onclick="toggleThought(${i})" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();toggleThought(${i})}"><div class="tic"><i class="ti ${th.ic}"></i></div><div><div class="txt">${th.t}</div><div class="angle"><i class="ti ti-route-2"></i> ${th.angle}</div></div><i class="ti ti-chevron-down fold-chev"></i></div><div class="thought-body"><div><div class="translate">${th.fmts.map((f,j)=>`<div class="fmt"><div class="ft"><i class="ti ${FMTS[j].ic}" style="color:${FMTS[j].c}"></i> ${FMTS[j].lab}</div><p>${f}</p><button class="btn btn-ghost btn-sm" onclick="event.stopPropagation();toast('Drafted','${FMTS[j].lab} added to the pipeline')"><i class="ti ti-sparkles"></i> Draft</button></div>`).join('')}</div></div></div></div>`).join('')}
function toggleThought(i){const el=$('th'+i);el.classList.toggle('open');const h=el.querySelector('.thought-head');if(h)h.setAttribute('aria-expanded',el.classList.contains('open'))}
function addThought(){const v=$('captureInput').value.trim();if(!v)return;THOUGHTS.unshift({t:v,angle:'Routing to the best angle',ic:'ti-bulb',fmts:['A 20-second talking head built from this thought.','The same idea across 8 story slides.','This thought as a saveable carousel set.','The deeper breakdown for long form.']});$('captureInput').value='';renderThoughts();const first=$('th0');first.classList.add('open');first.querySelector('.thought-head').setAttribute('aria-expanded','true');toast('Captured','Translated into 4 formats')}
renderThoughts();
function foldKey(e,id){if(e.key==='Enter'||e.key===' '){e.preventDefault();toggleFold(id)}}

/* ---------- performance ---------- */
function drawCurve(){const w=560,h=150,pad=8,pts=[100,59,57,55,54,53,53];const n=pts.length;const x=i=>pad+i*((w-pad*2)/(n-1));const y=v=>h-pad-(v/100)*(h-pad*2);
 let line=pts.map((v,i)=>`${i?'L':'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' ');
 let area=line+` L${x(n-1).toFixed(1)} ${h-pad} L${pad} ${h-pad} Z`;
 const dots=pts.map((v,i)=>`<circle cx="${x(i).toFixed(1)}" cy="${y(v).toFixed(1)}" r="${i===1?4.5:3}" fill="${i===1?'var(--rose)':'var(--accent)'}" stroke="var(--panel)" stroke-width="2"/>`).join('');
 const labs=pts.map((v,i)=>`<text x="${x(i).toFixed(1)}" y="${h-1}" font-size="8.5" fill="var(--muted)" text-anchor="middle" font-family="JetBrains Mono">S${i+1}</text>`).join('');
 $('curveWrap').innerHTML=`<svg class="curve-svg" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none"><defs><linearGradient id="cg" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--accent)" stop-opacity=".22"/><stop offset="1" stop-color="var(--accent)" stop-opacity="0"/></linearGradient></defs><path d="${area}" fill="url(#cg)"/><path d="${line}" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>${dots}${labs}</svg>`}
$('leaderboard').innerHTML=LB.map(([nm,v,dim])=>`<div class="lb-row"><span class="nm">${nm}</span><div class="lb-track"><i class="${dim?'dim':''}" style="width:${v||3}%"></i></div><span class="lb-val">${v?v+'%':'n/a'}</span></div>`).join('');
drawCurve();

/* ---------- todos ---------- */
function renderTodos(){$('todoList').innerHTML=TODOS.map((t,i)=>`<div class="todo ${t.done?'done':''}" style="${t.locked?'opacity:.72':''}" ${t.locked?'':`onclick="toggleTodo(${i})"`}><div class="chk" ${t.locked?'style="border-style:dashed;cursor:default"':''}><i class="ti ti-check"></i></div><div style="flex:1"><div class="t">${t.t}</div><div class="m">${t.m}</div></div><span class="owner ${t.owner}">${t.owner==='you'?'You':'Pulsify'}</span></div>`).join('')}
function toggleTodo(i){TODOS[i].done=!TODOS[i].done;renderTodos()}
renderTodos();

/* ---------- team ---------- */
$('teamGrid').innerHTML=TEAM.map((m,i)=>`<div class="member"><div class="member-top"><div class="avatar" style="background:${m.c}">${m.av}</div><div><h4>${m.n}</h4><div class="role">${m.r}</div></div></div><div class="contact"><a href="#" onclick="return false"><i class="ti ti-mail"></i> ${m.email}</a><a href="#" onclick="return false"><i class="ti ti-brand-slack"></i> ${m.mail}</a></div><div class="now"><div class="lab">Right now</div><div class="task"><i class="ti ti-player-play-filled"></i> ${m.task}</div></div><div class="day">${m.busy.map((b,j)=>`<div class="slot ${b?'busy':''}">${SLOTS[j]}</div>`).join('')}</div><button class="btn btn-ghost btn-sm" style="width:100%;justify-content:center;margin-top:13px" onclick="openMember(${i})">Open</button></div>`).join('');
function openMember(i){const m=TEAM[i];$('mmAv').style.background=m.c;$('mmAv').textContent=m.av;$('mmName').textContent=m.n;$('mmRole').textContent=m.r;$('mmContact').innerHTML=`<a href="#" onclick="return false" style="display:flex;gap:8px;color:var(--ink-2)"><i class="ti ti-mail"></i> ${m.email}</a><a href="#" onclick="return false" style="display:flex;gap:8px;color:var(--ink-2)"><i class="ti ti-brand-slack"></i> ${m.mail}</a>`;$('mmDay').innerHTML=m.busy.map((b,j)=>`<div class="slot ${b?'busy':''}">${SLOTS[j]}</div>`).join('');$('mmTasks').innerHTML=m.tasks.map(t=>`<div class="task-card" style="margin:0"><div class="t">${t}</div></div>`).join('');show('memberModal')}
const ROLES={operator:'Operator',content:'Content',setter:'Setter'};
$('board').innerHTML=Object.keys(ROLES).map(role=>{const tasks=TEAM.filter(m=>m.role===role).flatMap(m=>m.tasks.map(t=>({t,m})));return `<div><div class="col-h">${ROLES[role]} <span class="mono">${tasks.length}</span></div>${tasks.map(x=>`<div class="task-card"><div class="t">${x.t}</div><div class="who"><span class="av" style="background:${x.m.c}">${x.m.av}</span> ${x.m.n}</div></div>`).join('')}</div>`}).join('');

/* ---------- integrations ---------- */
$('autoList').innerHTML=AUTOS.map((a,i)=>`<div class="auto-row"><div class="auto-ic"><i class="ti ${a.trigIc}"></i></div><div class="auto-flow"><span class="step">${a.trig}</span><span class="arr"><i class="ti ti-arrow-right"></i></span><span class="step">${a.act}</span><div class="sub">${a.on?'Running automatically':'Paused'}</div></div><div class="auto-runs">${a.runs}</div><div class="switch ${a.on?'on':''}" role="switch" aria-checked="${a.on}" tabindex="0" onclick="toggleAuto(${i},this)" onkeydown="swKey(event,this,()=>toggleAuto(${i},this))"><i></i></div></div>`).join('');
function toggleAuto(i,el){AUTOS[i].on=!AUTOS[i].on;el.classList.toggle('on',AUTOS[i].on);el.setAttribute('aria-checked',AUTOS[i].on);toast(AUTOS[i].on?'Automation on':'Automation paused',AUTOS[i].trig)}
let svcCat='All',svcQ='';
$('catBar').innerHTML=CATS.map(c=>`<button class="cat-chip ${c==='All'?'on':''}" onclick="setCat('${c}',this)">${c}</button>`).join('');
function setCat(c,el){svcCat=c;document.querySelectorAll('.cat-chip').forEach(x=>x.classList.remove('on'));el.classList.add('on');renderSvc()}
function renderSvc(){const list=SERVICES.filter(s=>(svcCat==='All'||s.cat===svcCat)&&(s.n+' '+s.cat+' '+s.blurb).toLowerCase().includes(svcQ));
 $('svcGrid').innerHTML=list.length?list.map(s=>{const i=SERVICES.indexOf(s);return `<div class="svc"><div class="svc-top"><div class="svc-logo" style="background:${s.c};color:${s.ci||'#fff'}">${s.l}</div><div class="in"><b>${s.n}</b><div class="cat">${s.cat}</div></div></div><p>${s.blurb}</p><div class="svc-foot">${svcState(s)}<button class="btn ${s.on?'btn-ghost':'btn-soft'} btn-sm" onclick="openService(${i})">${s.on?'Manage':'Connect'}</button></div></div>`}).join('')
 :`<div class="empty" style="grid-column:1/-1"><div class="ei"><i class="ti ti-plug"></i></div><h4>No tools match</h4><p>Try another category or clear the search.</p></div>`}
function svcState(s){return s.connecting?`<span class="stt"><span class="spin"></span> Connecting</span>`:s.on?`<span class="stt on"><span class="dot"></span> Connected, ${s.sync}</span>`:`<span class="stt">Available</span>`}
$('svcSearch').addEventListener('input',e=>{svcQ=e.target.value.toLowerCase();renderSvc()});
renderSvc();
let svcIdx=0;
function openService(i){svcIdx=i;const s=SERVICES[i];$('svLogo').style.background=s.c;$('svLogo').style.color=s.ci||'#fff';$('svLogo').textContent=s.l;$('svTitle').textContent=s.n;$('svCat').textContent=s.cat;
 const fields=s.fields.length?`<div class="det-block"><h5>Connection</h5>${s.fields.map(f=>`<div class="field"><label>${f.label}</label><input placeholder="${f.ph}"></div>`).join('')}</div>`:`<div class="det-block"><h5>Connection</h5><div class="note">Connects with one click over OAuth. No keys to paste.</div></div>`;
 $('svBody').innerHTML=`<p style="font-size:13.5px;color:var(--ink-2);line-height:1.55;margin:0 0 4px">${s.blurb}</p>
   <div class="det-block"><h5>What it syncs</h5><div class="det-syncs">${s.syncs.map(x=>`<div class="det-sync"><i class="ti ti-check"></i> ${x}</div>`).join('')}</div></div>
   <div class="det-block"><h5>Permissions</h5><div class="det-scope">${s.scopes.map(x=>`<span class="badge b-gray">${x}</span>`).join('')}</div></div>
   ${fields}`;
 $('svState').textContent=s.on?`Connected, last sync ${s.sync}`:'Not connected yet';
 $('svActions').innerHTML=s.on?`<button class="btn btn-ghost" onclick="syncOne(${i})"><i class="ti ti-refresh"></i> Sync now</button><button class="btn btn-danger" onclick="disconnectSvc(${i})">Disconnect</button>`:`<button class="btn btn-primary" onclick="connectSvc(${i})"><i class="ti ti-plug-connected"></i> Connect ${s.n}</button>`;
 show('svcModal')}
function connectSvc(i){const s=SERVICES[i];s.connecting=1;renderSvc();closeAll();toast('sync','Connecting to '+s.n,'Authorizing and running first sync');setTimeout(()=>{s.connecting=0;s.on=1;s.sync='just now';renderSvc();updateIntgSummary();toast('Connected',s.n+' is live and syncing')},1400)}
function disconnectSvc(i){const s=SERVICES[i];s.on=0;s.sync=null;renderSvc();updateIntgSummary();closeAll();toast('Disconnected',s.n+' no longer syncs')}
function syncOne(i){closeAll();toast('sync','Syncing '+SERVICES[i].n,'Pulling the latest');setTimeout(()=>toast('Synced',SERVICES[i].n+' up to date'),900)}
function syncAll(){toast('sync','Syncing all connections','Pulling the latest metrics');setTimeout(()=>{$('sumSync').textContent='just now';toast('Synced','All connections up to date')},1100)}
function updateIntgSummary(){const on=SERVICES.filter(s=>s.on).length;$('sumConnected').innerHTML=`<span class="dotb" style="background:var(--accent)"></span> ${on}`;$('sumAvailable').textContent=SERVICES.length-on}
updateIntgSummary();

/* ---------- settings ---------- */
$('setNav').innerHTML=SETNAV.map((s,i)=>`<button class="subtab ${i===0?'on':''}" data-set="${s[0]}" onclick="setSec('${s[0]}',this)">${s[1]}</button>`).join('');
function setSec(k,el){document.querySelectorAll('.subtab').forEach(x=>x.classList.remove('on'));el.classList.add('on');document.querySelectorAll('.set-sec').forEach(s=>s.classList.toggle('on',s.dataset.set===k))}
function tSwitch(el){const on=el.classList.toggle('on');el.setAttribute('aria-checked',on)}
function swKey(e,el,fn){if(e.key==='Enter'||e.key===' '){e.preventDefault();fn?fn():tSwitch(el)}}

/* ---------- overlays ---------- */
let lastFocus=null;
function show(id){lastFocus=document.activeElement;bd.classList.add('show');$(id).classList.add('show');const f=$(id).querySelector('input,textarea,button');if(f)setTimeout(()=>f.focus(),60)}
function closeAll(){bd.classList.remove('show');document.querySelectorAll('.modal').forEach(m=>m.classList.remove('show'));if(lastFocus&&lastFocus.focus)lastFocus.focus()}
function toggleTheme(){document.body.classList.toggle('dark');toast('Theme',document.body.classList.contains('dark')?'Dark mode':'Light mode')}

/* ---------- toasts ---------- */
function toast(title,sub,extra){let s=sub,cls='';if(title==='sync'){cls='sync';title=sub;s=extra}const el=document.createElement('div');el.className='toast '+cls;el.innerHTML=`<div class="ti-ic"><i class="ti ${cls==='sync'?'ti-refresh':'ti-check'}"></i></div><div><b>${title}</b>${s?`<span>${s}</span>`:''}</div>`;$('toasts').appendChild(el);setTimeout(()=>{el.classList.add('out');setTimeout(()=>el.remove(),240)},2600)}

/* ---------- reload skeleton ---------- */
function reloadLib(){const lib=$('seqLib');lib.innerHTML=Array.from({length:3}).map(()=>'<div class="sk sk-fold"></div>').join('');toast('sync','Syncing','Pulling the latest metrics');setTimeout(()=>{renderSeq();toast('Synced','Metrics up to date')},900)}

/* ---------- retest ---------- */
let retestIdx=0;
function openRetest(i){retestIdx=i;const s=SEQS[i];const leak=s.slides.find(sl=>sl.leak);$('rtTitle').textContent='Retest, '+s.topic;$('rtOld').textContent=leak?leak.t:'the current opener';show('retestModal')}
function launchRetest(){const s=SEQS[retestIdx];if(s.status!=='testing'){s.status='testing';s.statusc='b-rose';s.variants=[{v:'v1',comp:s.comp,note:'original'},{v:'v2',comp:null,note:'testing',testing:1}];renderSeq()}closeAll();toast('Retest launched','Variant v2 is tracking, compare in 48h')}
function openLog(){show('logModal')}

/* ---------- command palette ---------- */
const CMDS=[
 {g:'Go to',ic:'ti-layout-grid',t:'Home',s:'This week overview',run:()=>go('home')},
 {g:'Go to',ic:'ti-currency-dollar',t:'Revenue',s:'Payments and goal',run:()=>go('revenue')},
 {g:'Go to',ic:'ti-chart-histogram',t:'Performance',s:'Drop-off and leaderboard',run:()=>go('performance')},
 {g:'Go to',ic:'ti-user-search',t:'Profile',s:'Bio, proof, and CTA routing',run:()=>go('profile')},
 {g:'Go to',ic:'ti-sparkles',t:'Studio',s:'The content engine',run:()=>go('studio')},
 {g:'Go to',ic:'ti-plug-connected',t:'Integrations',s:'Connect your tools',run:()=>go('integrations')},
 {g:'Go to',ic:'ti-settings',t:'Settings',s:'Workspace config',run:()=>go('settings')},
 {g:'Go to',ic:'ti-map-2',t:'Plans',s:'Game plan by phase',run:()=>go('plans')},
 {g:'Go to',ic:'ti-users',t:'Team',s:'Who is on your build',run:()=>go('team')},
 {g:'Create',ic:'ti-trophy',t:'New credibility sequence',s:'Best type, 74%',run:()=>{go('studio');openType(1)}},
 {g:'Create',ic:'ti-bulb',t:'New value-driven sequence',s:'Expertise play',run:()=>{go('studio');openType(0)}},
 {g:'Create',ic:'ti-rocket',t:'New story launch',s:'The money sequence',run:()=>{go('studio');openType(8)}},
 {g:'Create',ic:'ti-layout-grid',t:'New carousel',s:'Methodology or taxonomy',run:()=>{go('studio');openCarouselCreate()}},
 {g:'Act',ic:'ti-user-search',t:'Rewrite the bio',s:'Run the 3-second test',run:()=>{go('profile');openBioModal()}},
 {g:'Act',ic:'ti-flask',t:'Retest the leaking hook',s:'Value-driven, slide 2',run:()=>{go('studio');openRetest(0)}},
 {g:'Act',ic:'ti-chart-histogram',t:'Log a posted sequence',s:'Feed the engine',run:()=>{go('performance');openLog()}},
 {g:'Act',ic:'ti-refresh',t:'Sync all connections',s:'Pull latest metrics',run:()=>{go('integrations');syncAll()}},
 {g:'Connect',ic:'ti-brand-stripe',t:'Connect Stripe',s:'Payments',run:()=>{go('integrations');openService(0)}},
 {g:'Connect',ic:'ti-brand-instagram',t:'Connect Instagram',s:'Story metrics and DMs',run:()=>{go('integrations');openService(13)}},
 {g:'Connect',ic:'ti-mail',t:'Connect Kit',s:'Email sequences',run:()=>{go('integrations');openService(5)}},
 {g:'Connect',ic:'ti-robot',t:'View automations',s:'Triggers and actions',run:()=>{go('integrations');scrollToEl('autoList')}},
 {g:'Go to',ic:'ti-video',t:'Reels',s:'Capture and clip',run:()=>go('reels')},
 {g:'Create',ic:'ti-bulb',t:'Capture a thought',s:'Turn an idea into content',run:()=>{go('reels');setTimeout(()=>$('captureInput').focus(),90)}},
 {g:'Create',ic:'ti-scissors',t:'Clip a video',s:'Long-form or a call into reels',run:()=>{go('reels');toast('Clip a video','Paste a YouTube or call link, demo')}},
 {g:'Act',ic:'ti-moon',t:'Toggle theme',s:'Light or dark',run:toggleTheme}
];
let cmdkI=0,cmdkView=CMDS;
function openCmdk(){$('cmdkWrap').classList.add('show');$('cmdkInput').value='';cmdkFilter('');setTimeout(()=>$('cmdkInput').focus(),50)}
function closeCmdk(){$('cmdkWrap').classList.remove('show')}
function cmdkFilter(q){q=q.toLowerCase();cmdkView=CMDS.filter(c=>(c.t+' '+c.s+' '+c.g).toLowerCase().includes(q));cmdkI=0;renderCmdk()}
function renderCmdk(){const l=$('cmdkList');if(!cmdkView.length){l.innerHTML='<div class="cmdk-empty">No matches. Try connect, retest, or a section name.</div>';return}
 let html='',lastG=null;cmdkView.forEach((c,i)=>{if(c.g!==lastG){html+=`<div class="cmdk-group">${c.g}</div>`;lastG=c.g}html+=`<div class="cmdk-item ${i===cmdkI?'active':''}" data-i="${i}" onclick="runCmd(${i})" onmousemove="setCmd(${i})"><div class="ci"><i class="ti ${c.ic}"></i></div><div class="cmain"><b>${c.t}</b><div class="csub">${c.s}</div></div>${i===cmdkI?'<span class="kbd">enter</span>':''}</div>`});l.innerHTML=html;const act=l.querySelector('.cmdk-item.active');if(act)act.scrollIntoView({block:'nearest'})}
function setCmd(i){cmdkI=i;renderCmdk()}
function runCmd(i){const c=cmdkView[i];closeCmdk();if(c)c.run()}
$('cmdkInput').addEventListener('input',e=>cmdkFilter(e.target.value));
$('cmdkWrap').addEventListener('click',e=>{if(e.target===$('cmdkWrap'))closeCmdk()});

/* ---------- keyboard ---------- */
document.addEventListener('keydown',e=>{
 if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();$('cmdkWrap').classList.contains('show')?closeCmdk():openCmdk();return}
 if($('cmdkWrap').classList.contains('show')){
   if(e.key==='ArrowDown'){e.preventDefault();cmdkI=Math.min(cmdkI+1,cmdkView.length-1);renderCmdk()}
   else if(e.key==='ArrowUp'){e.preventDefault();cmdkI=Math.max(cmdkI-1,0);renderCmdk()}
   else if(e.key==='Enter'){e.preventDefault();runCmd(cmdkI)}
   else if(e.key==='Escape'){closeCmdk()}
   return}
 if(e.key==='Escape')closeAll();
});
</script>
</body>
</html>

