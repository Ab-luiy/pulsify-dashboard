+    ok: true,
+    sequence_ref: sequenceRef,
+    leaking_slide: diagnostic.biggestDropSlide,
+    leak_loss_pct: diagnostic.biggestDropPct,
+    original_hook: baseline?.hook_text || normalizeHook(sequence.topic) || "Original hook",
+    variant: {
