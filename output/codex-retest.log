+       started_at, resolved_at, created_at
+     ) VALUES (?, ?, ?, ?, 'testing', NULL, ?, NULL, ?)`,
+  ).bind(client, sequenceRef, `v${nextNumber}`, newHook, timestamp, timestamp));
