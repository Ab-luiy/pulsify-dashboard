export function json(object, status = 200, extraHeaders = {}) {
  return new Response(JSON.stringify(object), {
    status,
    headers: {
      "content-type": "application/json",
      "access-control-allow-origin": "*",
      "cache-control": "no-store",
      ...extraHeaders,
    },
  });
}

export function cleanId(value, fallback = "") {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9_-]/g, "")
    .slice(0, 64) || fallback;
}

export function hasOwn(object, key) {
  return Object.prototype.hasOwnProperty.call(object || {}, key);
}

export function parseJson(value, fallback = {}) {
  if (!value) return fallback;
  try {
    const parsed = JSON.parse(value);
    return parsed && typeof parsed === "object" ? parsed : fallback;
  } catch {
    return fallback;
  }
}

export function str(value) {
  return String(value ?? "").trim();
}

export function strOrNull(value) {
  const text = str(value);
  return text || null;
}

export function nowIso() {
  return new Date().toISOString();
}

export async function sha256Hex(value) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

export function checkAdmin(request, env) {
  if (!env.ADMIN_KEY) return json({ ok: false, error: "ADMIN_KEY not configured" }, 500);
  if (request.headers.get("x-admin-key") !== env.ADMIN_KEY) {
    return json({ ok: false, error: "unauthorized" }, 401);
  }
  return null;
}

export function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

export function titleCase(slug) {
  return String(slug || "")
    .split(/[-_]+/)
    .filter(Boolean)
    .map((part) => part[0].toUpperCase() + part.slice(1))
    .join(" ") || "Pulsify";
}

export function generateOpaqueToken(byteLength = 18) {
  const bytes = new Uint8Array(byteLength);
  crypto.getRandomValues(bytes);
  let binary = "";
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

export function constantTimeEqual(a, b) {
  if (!a || !b || a.length !== b.length) return false;
  let mismatch = 0;
  for (let i = 0; i < a.length; i += 1) mismatch |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return mismatch === 0;
}

export function normalizeEmail(value) {
  const email = String(value || "").trim().toLowerCase();
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : null;
}

export function numberOrNull(value) {
  if (value == null || value === "") return null;
  const number = Number(value);
  return Number.isFinite(number) ? number : null;
}

export function amountToCents(value) {
  if (value == null || value === "") return null;
  if (typeof value === "number" && Number.isInteger(value)) return value;
  const number = Number(value);
  return Number.isFinite(number) ? Math.round(number * 100) : null;
}

export function centsToAmount(cents) {
  return (Number(cents || 0) / 100).toFixed(2);
}

export function humanCurrency(amountCents, currency) {
  const normalized = String(currency || "USD").toUpperCase();
  return `${centsToAmount(amountCents)} ${normalized}`;
}

import {
  cleanId,
  constantTimeEqual,
  generateOpaqueToken,
  json,
  normalizeEmail,
  nowIso,
  sha256Hex,
} from "./common.js";

export const CLIENT_SESSION_COOKIE = "pulsify_client_session";
export const PBKDF2_ITERATIONS = 100000;
const SESSION_TTL_DAYS = 30;
const SETUP_TOKEN_TTL_HOURS = 72;
const FAILED_LOGIN_LIMIT = 5;
const FAILED_LOGIN_WINDOW_MINUTES = 15;
export const IMPERSONATION_TTL_MINUTES = 30;

export async function hashPassword(password, salt, iterations = PBKDF2_ITERATIONS) {
  const encoder = new TextEncoder();
  const passwordKey = await crypto.subtle.importKey(
    "raw",
    encoder.encode(password),
    "PBKDF2",
    false,
    ["deriveBits"],
  );
  const bits = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      hash: "SHA-256",
      salt: encoder.encode(salt),
      iterations,
    },
    passwordKey,
    256,
  );
  return bytesToHex(new Uint8Array(bits));
}

export function createPasswordSalt() {
  return generateOpaqueToken(24);
}

export async function verifyPassword(password, row) {
  const salt = row?.pass_salt || "pulsify-client-auth-dummy-salt";
  const iterations = Number(row?.iterations || PBKDF2_ITERATIONS);
  const expected = row?.pass_hash || "0".repeat(64);
  const actual = await hashPassword(password, salt, iterations);
  return constantTimeEqual(actual, expected) && Boolean(row?.pass_hash);
}

export async function countRecentFailedLogins(env, email) {
  const threshold = isoMinutesAgo(FAILED_LOGIN_WINDOW_MINUTES);
  const row = await env.DB.prepare(
    `SELECT COUNT(*) AS total
       FROM client_login_attempts
      WHERE email=? AND attempted_at>=?`,
  ).bind(email, threshold).first();
  return Number(row?.total || 0);
}

export async function recordFailedLogin(env, email) {
  await env.DB.prepare(
    "INSERT INTO client_login_attempts (email, attempted_at) VALUES (?, ?)",
  ).bind(email, nowIso()).run();
}

export async function clearFailedLogins(env, email) {
  await env.DB.prepare(
    "DELETE FROM client_login_attempts WHERE email=?",
  ).bind(email).run();
}

export function isRateLimited(count) {
  return count >= FAILED_LOGIN_LIMIT;
}

export function rateLimitPayload(count) {
  const attemptsLeft = Math.max(0, FAILED_LOGIN_LIMIT - count);
  return {
    ok: false,
    error: attemptsLeft
      ? `Incorrect password. ${attemptsLeft} attempt${attemptsLeft === 1 ? "" : "s"} left before the login pauses.`
      : "Too many failed login attempts. Wait 15 minutes and try again.",
    rate_limited: attemptsLeft === 0,
    attempts_left: attemptsLeft,
  };
}

export async function issueClientSession(env, clientId) {
  const token = generateOpaqueToken(32);
  const tokenHash = await sha256Hex(token);
  const createdAt = nowIso();
  const expiresAt = isoDaysFromNow(SESSION_TTL_DAYS);

  await env.DB.prepare(
    `INSERT INTO client_sessions (token_hash, client_id, expires_at, created_at)
     VALUES (?, ?, ?, ?)`,
  ).bind(tokenHash, clientId, expiresAt, createdAt).run();

  return {
    token,
    expiresAt,
    cookie: serializeCookie(CLIENT_SESSION_COOKIE, token, {
      path: "/",
      httpOnly: true,
      sameSite: "Lax",
      secure: true,
      maxAge: SESSION_TTL_DAYS * 24 * 60 * 60,
    }),
  };
}

export async function issueImpersonationExchange(env, clientId, createdBy = "admin") {
  const exchangeToken = generateOpaqueToken(32);
  const exchangeHash = await sha256Hex(exchangeToken);
  const createdAt = nowIso();
  const expiresAt = new Date(
    new Date(createdAt).getTime() + IMPERSONATION_TTL_MINUTES * 60 * 1000,
  ).toISOString();

  const sessionStatement = env.DB.prepare(
    `INSERT INTO impersonation_sessions (
       token_hash, exchange_hash, client_id, created_at, expires_at, created_by, consumed_at
     ) VALUES (NULL, ?, ?, ?, ?, ?, NULL)`,
  ).bind(exchangeHash, clientId, createdAt, expiresAt, createdBy);
  const eventStatement = env.DB.prepare(
    `INSERT INTO operator_events (actor, action, client, detail, created_at)
     VALUES (?, 'impersonate-start', ?, ?, ?)`,
  ).bind(createdBy, clientId, JSON.stringify({ surface: "command-center" }), createdAt);
  const results = await env.DB.batch([sessionStatement, eventStatement]);

  return {
    exchangeToken,
    createdAt,
    expiresAt,
    eventId: results?.[1]?.meta?.last_row_id ?? null,
  };
}

export async function consumeImpersonationExchange(env, exchangeToken) {
  const rawToken = String(exchangeToken || "").trim();
  if (!rawToken || !env.DB) return null;

  const exchangeHash = await sha256Hex(rawToken);
  const sessionToken = generateOpaqueToken(32);
  const tokenHash = await sha256Hex(sessionToken);
  const consumedAt = nowIso();
  const row = await env.DB.prepare(
    `UPDATE impersonation_sessions
        SET token_hash=?, exchange_hash=NULL, consumed_at=?
      WHERE exchange_hash=? AND token_hash IS NULL AND consumed_at IS NULL AND expires_at>?
      RETURNING client_id, expires_at, created_by`,
  ).bind(tokenHash, consumedAt, exchangeHash, consumedAt).first();
  if (!row) return null;

  try {
    await env.DB.prepare(
      `INSERT INTO operator_events (actor, action, client, detail, created_at)
       VALUES (?, 'impersonate-use', ?, ?, ?)`,
    ).bind(
      row.created_by || "admin",
      row.client_id,
      JSON.stringify({ surface: "portal" }),
      consumedAt,
    ).run();
  } catch {
    await env.DB.prepare(
      "DELETE FROM impersonation_sessions WHERE token_hash=?",
    ).bind(tokenHash).run().catch(() => null);
    return null;
  }

  const secondsRemaining = Math.max(
    0,
    Math.min(
      IMPERSONATION_TTL_MINUTES * 60,
      Math.floor((new Date(row.expires_at).getTime() - Date.now()) / 1000),
    ),
  );
  if (!secondsRemaining) return null;

  return {
    client: cleanId(row.client_id),
    expiresAt: row.expires_at,
    cookie: serializeCookie(CLIENT_SESSION_COOKIE, sessionToken, {
      path: "/",
      httpOnly: true,
      sameSite: "Lax",
      secure: true,
      maxAge: secondsRemaining,
    }),
  };
}

export function clearClientSessionCookie() {
  return serializeCookie(CLIENT_SESSION_COOKIE, "", {
    path: "/",
    httpOnly: true,
    sameSite: "Lax",
    secure: true,
    maxAge: 0,
  });
}

export async function purgeExpiredClientSessions(env) {
  const cutoff = nowIso();
  await Promise.all([
    env.DB.prepare(
      "DELETE FROM client_sessions WHERE expires_at<?",
    ).bind(cutoff).run(),
    env.DB.prepare(
      "DELETE FROM impersonation_sessions WHERE expires_at<?",
    ).bind(cutoff).run().catch(() => null),
  ]);
}

export async function createSetupLink(env, origin, clientId, email) {
  const safeClient = cleanId(clientId);
  const normalizedEmail = normalizeEmail(email);
  if (!safeClient) return { ok: false, error: "valid client id required" };
  if (!normalizedEmail) return { ok: false, error: "valid email required" };

  const existingByEmail = await env.DB.prepare(
    "SELECT client_id FROM client_auth WHERE email=?",
  ).bind(normalizedEmail).first();
  if (existingByEmail && cleanId(existingByEmail.client_id) !== safeClient) {
    return { ok: false, error: "this email is already assigned to another client" };
  }

  const existing = await env.DB.prepare(
    `SELECT client_id, pass_hash, pass_salt, iterations, created_at
       FROM client_auth WHERE client_id=?`,
  ).bind(safeClient).first();

  const createdAt = existing?.created_at || nowIso();
  await env.DB.prepare(
    `INSERT INTO client_auth (client_id, email, pass_hash, pass_salt, iterations, created_at, updated_at)
     VALUES (?, ?, ?, ?, ?, ?, ?)
     ON CONFLICT(client_id) DO UPDATE SET
       email=excluded.email,
       pass_hash=excluded.pass_hash,
       pass_salt=excluded.pass_salt,
       iterations=excluded.iterations,
       updated_at=excluded.updated_at`,
  ).bind(
    safeClient,
    normalizedEmail,
    existing?.pass_hash || null,
    existing?.pass_salt || null,
    Number(existing?.iterations || PBKDF2_ITERATIONS),
    createdAt,
    nowIso(),
  ).run();

  await env.DB.prepare(
    "DELETE FROM client_setup_tokens WHERE client_id=?",
  ).bind(safeClient).run();

  const token = generateOpaqueToken(32);
  const tokenHash = await sha256Hex(token);
  const expiresAt = isoHoursFromNow(SETUP_TOKEN_TTL_HOURS);
  await env.DB.prepare(
    `INSERT INTO client_setup_tokens (token_hash, client_id, email, expires_at, created_at)
     VALUES (?, ?, ?, ?, ?)`,
  ).bind(tokenHash, safeClient, normalizedEmail, expiresAt, nowIso()).run();

  return {
    ok: true,
    client: safeClient,
    email: normalizedEmail,
    link: `${origin}/portal/login?client=${encodeURIComponent(safeClient)}&setup=${encodeURIComponent(token)}`,
    expires_at: expiresAt,
    note: "Shown once. Generating a new setup link turns off the previous one.",
  };
}

export async function consumeSetupToken(env, token) {
  const tokenHash = await sha256Hex(token);
  const row = await env.DB.prepare(
    `SELECT token_hash, client_id, email, expires_at
       FROM client_setup_tokens
      WHERE token_hash=?`,
  ).bind(tokenHash).first();
  if (!row) return null;
  if (String(row.expires_at || "") <= nowIso()) {
    await env.DB.prepare(
      "DELETE FROM client_setup_tokens WHERE token_hash=?",
    ).bind(tokenHash).run();
    return null;
  }
  return row;
}

export async function invalidateSetupTokensForClient(env, clientId) {
  await env.DB.prepare(
    "DELETE FROM client_setup_tokens WHERE client_id=?",
  ).bind(clientId).run();
}

export async function resolveClientAccess(request, env, options = {}) {
  if (!env.DB) {
    return { error: json({ ok: false, error: "no database bound" }, 500) };
  }

  const url = new URL(request.url);
  const clientHint = cleanId(options.clientHint ?? url.searchParams.get("client"), "");

  const sessionAccess = await resolveSessionAccess(request, env);
  if (sessionAccess?.impersonated) {
    if (clientHint && sessionAccess.client !== clientHint) {
      return { error: json({ ok: false, error: "unauthorized" }, 403) };
    }
    if (options.allowImpersonated !== true) {
      return { error: json({ error: "read only" }, 403) };
    }
    return sessionAccess;
  }

  const tokenAccess = await resolveTokenAccess(request, env, {
    allowHeaderToken: options.allowHeaderToken !== false,
    allowQueryToken: Boolean(options.allowQueryToken),
  });
  if (tokenAccess) {
    if (clientHint && tokenAccess.client !== clientHint) {
      return { error: json({ ok: false, error: "unauthorized" }, 403) };
    }
    return tokenAccess;
  }

  if (sessionAccess) {
    if (clientHint && sessionAccess.client !== clientHint) {
      return { error: json({ ok: false, error: "unauthorized" }, 403) };
    }
    return sessionAccess;
  }

  return { error: json({ ok: false, error: "unauthorized" }, 401) };
}

export async function rejectImpersonatedSession(request, env) {
  if (!env.DB) return null;
  const access = await resolveSessionAccess(request, env);
  return access?.impersonated
    ? json({ error: "read only" }, 403)
    : null;
}

export async function resolveSessionAccess(request, env) {
  const token = parseCookies(request.headers.get("cookie")).get(CLIENT_SESSION_COOKIE);
  if (!token) return null;

  await purgeExpiredClientSessions(env);
  const hash = await sha256Hex(token);
  const impersonation = await env.DB.prepare(
    `SELECT s.client_id, s.expires_at, s.created_by, c.client_name
       FROM impersonation_sessions s
       LEFT JOIN client_config c ON c.client=s.client_id
      WHERE s.token_hash=? AND s.consumed_at IS NOT NULL AND s.expires_at>?`,
  ).bind(hash, nowIso()).first().catch(() => null);
  if (impersonation) {
    return {
      client: cleanId(impersonation.client_id),
      client_name: impersonation.client_name || cleanId(impersonation.client_id),
      auth_mode: "session",
      impersonated: true,
      expires_at: impersonation.expires_at,
      created_by: impersonation.created_by || "admin",
    };
  }

  const row = await env.DB.prepare(
    `SELECT s.client_id, s.expires_at, c.client_name
       FROM client_sessions s
       LEFT JOIN client_config c ON c.client=s.client_id
      WHERE s.token_hash=? AND s.expires_at>?`,
  ).bind(hash, nowIso()).first();
  if (!row) return null;

  return {
    client: cleanId(row.client_id),
    client_name: row.client_name || cleanId(row.client_id),
    auth_mode: "session",
    impersonated: false,
  };
}

export async function resolveTokenAccess(request, env, options = {}) {
  const url = new URL(request.url);
  const headerToken = options.allowHeaderToken === false
    ? null
    : request.headers.get("x-portal-token");
  const queryToken = options.allowQueryToken ? url.searchParams.get("t") : null;
  const rawToken = String(headerToken || queryToken || "").trim();
  if (!rawToken) return null;

  const hash = await sha256Hex(rawToken);
  const row = await env.DB.prepare(
    `SELECT client, COALESCE(client_name, client) AS client_name
       FROM client_config
      WHERE portal_token_hash=?`,
  ).bind(hash).first();
  if (!row) return null;

  return {
    client: cleanId(row.client),
    client_name: row.client_name || cleanId(row.client),
    auth_mode: "token",
  };
}

export function parseCookies(header) {
  const map = new Map();
  for (const part of String(header || "").split(";")) {
    const [name, ...rest] = part.trim().split("=");
    if (!name) continue;
    map.set(name, rest.join("="));
  }
  return map;
}

function serializeCookie(name, value, options = {}) {
  const parts = [`${name}=${value}`];
  if (options.maxAge != null) parts.push(`Max-Age=${Math.max(0, Math.floor(options.maxAge))}`);
  if (options.path) parts.push(`Path=${options.path}`);
  if (options.httpOnly) parts.push("HttpOnly");
  if (options.secure) parts.push("Secure");
  if (options.sameSite) parts.push(`SameSite=${options.sameSite}`);
  return parts.join("; ");
}

function isoMinutesAgo(minutes) {
  return new Date(Date.now() - minutes * 60 * 1000).toISOString();
}

function isoHoursFromNow(hours) {
  return new Date(Date.now() + hours * 60 * 60 * 1000).toISOString();
}

function isoDaysFromNow(days) {
  return new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();
}

function bytesToHex(bytes) {
  return [...bytes].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

/**
 * Per-client integration settings.
 *
 * GET/POST/DELETE /api/settings?client=<client-id>
 * Header: x-admin-key: <ADMIN_KEY>
 */

import { checkAdmin, cleanId, json } from "../_shared/common.js";
import { deleteClientMedia } from "../_shared/media-storage.js";

const CLIENT_TABLES = [
  ["client_config", "client"],
  ["client_auth", "client_id"],
  ["client_sessions", "client_id"],
  ["client_setup_tokens", "client_id"],
  ["client_email_codes", "client_id"],
  ["client_dashboard_content", "client_id"],
  ["studio_sequences", "client_id"],
  ["studio_carousels", "client_id"],
  ["sequence_log", "client_id"],
  ["account_snapshots", "client_id"],
  ["client_brain", "client_id"],
  ["proof_items", "client_id"],
  ["content_items", "client"],
  ["call_notes", "client"],
  ["client_assets", "client"],
  ["payments", "client"],
  ["integrations", "client_id"],
  ["integration_events", "client"],
  ["delivery_failures", "client"],
  ["email_drafts", "client"],
  ["page_events", "client"],
];

export async function onRequestGet({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const url = new URL(request.url);
  const client = cleanId(url.searchParams.get("client"), "unknown");
  const row = await env.DB.prepare(
    `SELECT client,client_name,wistia_media_id,typeform_url,typeform_webhook_secret,
            kit_tag_id,kit_api_key,allowed_origin,proof_images_json,
            template_variant,page_content_json,updated_at
       FROM client_config WHERE client=?`,
  ).bind(client).first();
  const authRow = await env.DB.prepare(
    `SELECT email, pass_hash, updated_at
       FROM client_auth
      WHERE client_id=?`,
  ).bind(client).first();
  const dashboardRows = await env.DB.prepare(
    `SELECT section, json, updated_at
       FROM client_dashboard_content
      WHERE client_id=?`,
  ).bind(client).all();

  if (!row) {
    return json({
      ok: true,
      client,
      config: null,
      dashboard_auth: authRow ? {
        email: authRow.email || "",
        has_password: Boolean(authRow.pass_hash),
        updated_at: authRow.updated_at || null,
        email_delivery_available: Boolean(env.RESEND_API_KEY && env.EMAIL_FROM),
        email_delivery_enabled: Boolean(env.RESEND_API_KEY),
        email_delivery_hint: env.RESEND_API_KEY
          ? (env.EMAIL_FROM
            ? `Setup links can be emailed from ${env.EMAIL_FROM}.`
            : "RESEND_API_KEY is set but EMAIL_FROM is missing.")
          : "Setup-link emails are off until RESEND_API_KEY is set.",
      } : null,
      dashboard_content: parseDashboardRows(dashboardRows.results || []),
    });
  }
  row.kit_api_key_set = Boolean(row.kit_api_key);
  row.typeform_webhook_secret_set = Boolean(row.typeform_webhook_secret);
  row.proof_images = parseJson(row.proof_images_json);
  row.page_content = parseJson(row.page_content_json);
  row.template_variant = row.template_variant || "canonical";
  delete row.kit_api_key;
  delete row.typeform_webhook_secret;
  delete row.proof_images_json;
  delete row.page_content_json;
  return json({
    ok: true,
    client,
    config: row,
    dashboard_auth: authRow ? {
      email: authRow.email || "",
      has_password: Boolean(authRow.pass_hash),
      updated_at: authRow.updated_at || null,
      email_delivery_available: Boolean(env.RESEND_API_KEY && env.EMAIL_FROM),
      email_delivery_enabled: Boolean(env.RESEND_API_KEY),
      email_delivery_hint: env.RESEND_API_KEY
        ? (env.EMAIL_FROM
          ? `Setup links can be emailed from ${env.EMAIL_FROM}.`
          : "RESEND_API_KEY is set but EMAIL_FROM is missing.")
        : "Setup-link emails are off until RESEND_API_KEY is set.",
    } : null,
    dashboard_content: parseDashboardRows(dashboardRows.results || []),
  });
}

export async function onRequestPost({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const client = cleanId(body.client, "unknown");
  if (client === "unknown") return json({ ok: false, error: "valid client id required" }, 422);

  const existing = await env.DB.prepare(
    `SELECT client_name,wistia_media_id,typeform_url,typeform_webhook_secret,
            kit_tag_id,kit_api_key,allowed_origin,proof_images_json,
            template_variant,page_content_json
       FROM client_config WHERE client=?`,
  ).bind(client).first();
  const kitKey = body.kit_api_key || existing?.kit_api_key || null;
  const webhookSecret =
    body.typeform_webhook_secret || existing?.typeform_webhook_secret || null;

  const proofImages = hasOwn(body, "proof_images") && body.proof_images && typeof body.proof_images === "object"
    ? JSON.stringify(
        Object.fromEntries(
          Object.entries(body.proof_images).filter(([, url]) => url && String(url).trim()),
        ),
      )
    : existing?.proof_images_json || null;

  const pageContent = hasOwn(body, "page_content") && body.page_content && typeof body.page_content === "object"
    ? JSON.stringify(
        Object.fromEntries(
          Object.entries(body.page_content).filter(([, val]) => val != null && String(val).trim()),
        ),
      )
    : existing?.page_content_json || null;

  const templateVariant = hasOwn(body, "template_variant")
    ? (body.template_variant === "variant-02" ? "variant-02" : "canonical")
    : existing?.template_variant || "canonical";
  const keep = (key, fallback = null) => hasOwn(body, key) ? (body[key] || null) : (existing?.[key] ?? fallback);

  await env.DB.prepare(
    `INSERT INTO client_config (
      client,client_name,wistia_media_id,typeform_url,typeform_webhook_secret,
      kit_tag_id,kit_api_key,allowed_origin,proof_images_json,
      template_variant,page_content_json,updated_at
    ) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
    ON CONFLICT(client) DO UPDATE SET
      client_name=excluded.client_name,
      wistia_media_id=excluded.wistia_media_id,
      typeform_url=excluded.typeform_url,
      typeform_webhook_secret=excluded.typeform_webhook_secret,
      kit_tag_id=excluded.kit_tag_id,
      kit_api_key=excluded.kit_api_key,
      allowed_origin=excluded.allowed_origin,
      proof_images_json=excluded.proof_images_json,
      template_variant=excluded.template_variant,
      page_content_json=excluded.page_content_json,
      updated_at=excluded.updated_at`,
  ).bind(
    client,
    keep("client_name", client) || client,
    keep("wistia_media_id"),
    keep("typeform_url"),
    webhookSecret,
    keep("kit_tag_id"),
    kitKey,
    keep("allowed_origin"),
    proofImages,
    templateVariant,
    pageContent,
    new Date().toISOString(),
  ).run();

  if (hasOwn(body, "dashboard_content") && body.dashboard_content && typeof body.dashboard_content === "object") {
    const now = new Date().toISOString();
    const sectionStatements = [];
    for (const section of ["plans", "todos", "team", "momentum"]) {
      if (!hasOwn(body.dashboard_content, section)) continue;
      const value = body.dashboard_content[section];
      if (value == null) {
        sectionStatements.push(
          env.DB.prepare(
            "DELETE FROM client_dashboard_content WHERE client_id=? AND section=?",
          ).bind(client, section),
        );
        continue;
      }
      sectionStatements.push(
        env.DB.prepare(
          `INSERT INTO client_dashboard_content (client_id, section, json, updated_at)
           VALUES (?, ?, ?, ?)
           ON CONFLICT(client_id, section) DO UPDATE SET
             json=excluded.json,
             updated_at=excluded.updated_at`,
        ).bind(client, section, JSON.stringify(value), now),
      );
    }
    if (sectionStatements.length) await env.DB.batch(sectionStatements);
  }

  return json({
    ok: true,
    saved: true,
    webhook_url: `${new URL(request.url).origin}/event?client=${encodeURIComponent(client)}`,
  });
}

export async function onRequestDelete({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const client = cleanId(new URL(request.url).searchParams.get("client"), "unknown");
  const exists = await env.DB.prepare(
    "SELECT 1 AS found FROM client_config WHERE client=?",
  ).bind(client).first();

  if (!exists) return json({ ok: false, error: "client not found" }, 404);

  const mediaDeleted = await deleteClientMedia(env, client);
  const proofMediaDeleted = await deleteClientProofMedia(env, client);
  const results = await env.DB.batch(
    CLIENT_TABLES.map(([table, column]) =>
      env.DB.prepare(`DELETE FROM ${table} WHERE ${column}=?`).bind(client),
    ),
  );
  const deleted = Object.fromEntries(
    CLIENT_TABLES.map(([table], index) => [table, Number(results[index]?.meta?.changes || 0)]),
  );
  deleted.media = mediaDeleted;
  deleted.proof_media = proofMediaDeleted;

  return json({ ok: true, deleted });
}

export async function onRequestOptions() {
  return new Response(null, {
    headers: {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "GET, POST, DELETE, OPTIONS",
      "access-control-allow-headers": "content-type, x-admin-key",
      "access-control-max-age": "86400",
    },
  });
}

function parseJson(value) {
  if (!value) return {};
  try { return JSON.parse(value); } catch { return {}; }
}

function parseDashboardRows(rows) {
  const content = {};
  for (const row of rows) {
    if (!row?.section) continue;
    try {
      content[row.section] = JSON.parse(row.json);
    } catch {
      content[row.section] = null;
    }
  }
  return content;
}

function hasOwn(object, key) {
  return Object.prototype.hasOwnProperty.call(object || {}, key);
}

export async function deleteClientProofMedia(env, client) {
  if (!env.MEDIA) return 0;
  const prefix = `${client}/`;
  let cursor;
  let deleted = 0;

  do {
    const page = await env.MEDIA.list({ prefix, ...(cursor ? { cursor } : {}) });
    const keys = (page?.objects || []).map((object) => object?.key).filter(Boolean);
    if (keys.length) {
      await env.MEDIA.delete(keys);
      deleted += keys.length;
    }
    cursor = page?.truncated ? page.cursor : undefined;
  } while (cursor);

  return deleted;
}


