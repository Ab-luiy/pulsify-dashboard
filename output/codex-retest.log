  let called = false;
  globalThis.fetch = async () => {
    called = true;
    return new Response(JSON.stringify({
      candidates: [{ content: { parts: [{ text: JSON.stringify({
        structure: "philosophy",
        title: "Beliefs",
        slides: Array.from({ length: 7 }, (_, index) => ({
