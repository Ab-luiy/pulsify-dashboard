import { checkAdmin, cleanId, json, nowIso } from "../_shared/common.js";
import { resolveClientAccess } from "../_shared/client-auth.js";

const VARIANT_COLUMNS = `id, client_id, sequence_ref, label, hook_text, status,
  completion_pct, started_at, resolved_at, created_at`;

export async function onRequestGet({ request, env }) {
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const url = new URL(request.url);
  const adminRequested = url.searchParams.get("admin") === "1";
  const hasAdminKey = Boolean(env.ADMIN_KEY) && request.headers.get("x-admin-key") === env.ADMIN_KEY;
  let client = "";
  let authMode = "client";

  if (adminRequested || hasAdminKey) {
    const auth = checkAdmin(request, env);
    if (auth) return auth;
    client = cleanId(url.searchParams.get("client"), "");
    authMode = "admin";
  } else {
    const access = await resolveClientAccess(request, env, {
      allowHeaderToken: true,
      allowImpersonated: true,
    });
    if (access.error) return access.error;
    client = cleanId(access.client);
    authMode = access.auth_mode;
  }

  const variants = await listVariants(env, client);
  const sequences = await listSequences(env, client);
  return json({
    ok: true,
    auth_mode: authMode,
    rows: groupLineage(variants, sequences),
  });
}

export async function onRequestPost({ request, env }) {
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const action = String(body.action || "").trim().toLowerCase();
  const access = await resolveClientAccess(request, env, { allowHeaderToken: true });
  if (access.error) return access.error;
  const client = cleanId(access.client);

  if (action === "start") return startRetest(env, client, body);
  if (action === "log") return logOutcome(env, client, body);
  if (action === "resolve") return resolveRetest(env, client, body);
  return json({ ok: false, error: "unknown action" }, 422);
}

export async function onRequestOptions() {
  return new Response(null, {
    headers: {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": "GET, POST, OPTIONS",
      "access-control-allow-headers": "content-type, x-admin-key, x-portal-token",
      "access-control-max-age": "86400",
    },
  });
}

async function startRetest(env, client, body) {
  const sequenceRef = positiveInteger(body.sequence_ref);
  const newHook = normalizeHook(body.new_hook);
  if (!sequenceRef) return json({ ok: false, error: "sequence_ref is required" }, 422);
  if (!newHook) return json({ ok: false, error: "new_hook is required" }, 422);

  const sequence = await env.DB.prepare(
    `SELECT id, client_id, posted_on, type, topic, slide_count, slide_views_json
       FROM sequence_log
      WHERE id=?`,
  ).bind(sequenceRef).first();
  if (!sequence || cleanId(sequence.client_id) !== client) {
    return json({ ok: false, error: "sequence log not found" }, 404);
  }

  const diagnostic = computeDiagnostic(sequence.slide_views_json, sequence.slide_count);
  if (diagnostic.name !== "hook failed") {
    return json({ ok: false, error: "only a diagnosed hook failure can start a hook retest" }, 422);
  }

  const existing = await env.DB.prepare(
    `SELECT ${VARIANT_COLUMNS}
       FROM sequence_variants
      WHERE client_id=? AND sequence_ref=?
      ORDER BY id`,
  ).bind(client, sequenceRef).all();
  const variants = existing.results || [];
  if (variants.some((variant) => variant.status === "testing")) {
    return json({ ok: false, error: "a retest is already running for this sequence" }, 409);
  }

  const timestamp = nowIso();
  const baseline = variants.filter((variant) => variant.status === "won").at(-1) || null;
  const nextNumber = nextVariantNumber(variants);
  const statements = [];

  if (baseline) {
    statements.push(env.DB.prepare(
      `UPDATE sequence_variants
          SET status='testing', resolved_at=NULL, started_at=?
        WHERE id=? AND client_id=? AND sequence_ref=? AND status='won'`,
    ).bind(timestamp, Number(baseline.id), client, sequenceRef));
  } else {
    statements.push(env.DB.prepare(
      `INSERT INTO sequence_variants (
         client_id, sequence_ref, label, hook_text, status, completion_pct,
         started_at, resolved_at, created_at
       ) VALUES (?, ?, 'v1', ?, 'testing', ?, ?, NULL, ?)`,
    ).bind(
      client,
      sequenceRef,
      normalizeHook(sequence.topic) || "Original hook",
      diagnostic.completionPct,
      timestamp,
      timestamp,
    ));
  }

  statements.push(env.DB.prepare(
    `INSERT INTO sequence_variants (
       client_id, sequence_ref, label, hook_text, status, completion_pct,
       started_at, resolved_at, created_at
     ) VALUES (?, ?, ?, ?, 'testing', NULL, ?, NULL, ?)`,
  ).bind(client, sequenceRef, `v${nextNumber}`, newHook, timestamp, timestamp));

  const results = await env.DB.batch(statements);
  const createdId = Number(results.at(-1)?.meta?.last_row_id || 0);
  return json({
    ok: true,
    sequence_ref: sequenceRef,
    leaking_slide: diagnostic.biggestDropSlide,
    leak_loss_pct: diagnostic.biggestDropPct,
    original_hook: baseline?.hook_text || normalizeHook(sequence.topic) || "Original hook",
    variant: {
      id: createdId,
      label: `v${nextNumber}`,
      hook_text: newHook,
      status: "testing",
      completion_pct: null,
    },
  });
}

async function logOutcome(env, client, body) {
  const variantId = positiveInteger(body.variant_id);
  const completionPct = validCompletion(body.completion_pct);
  if (!variantId) return json({ ok: false, error: "variant_id is required" }, 422);
  if (completionPct == null) {
    return json({ ok: false, error: "completion_pct must be between 0 and 100" }, 422);
  }

  const variant = await env.DB.prepare(
    `SELECT ${VARIANT_COLUMNS}
       FROM sequence_variants
      WHERE id=?`,
  ).bind(variantId).first();
  if (!variant || cleanId(variant.client_id) !== client) {
    return json({ ok: false, error: "variant not found" }, 404);
  }
  if (variant.status !== "testing") {
    return json({ ok: false, error: "only a testing variant can receive an outcome" }, 422);
  }

  await env.DB.prepare(
    `UPDATE sequence_variants
        SET completion_pct=?
      WHERE id=? AND client_id=? AND status='testing'`,
  ).bind(completionPct, variantId, client).run();
  return json({ ok: true, id: variantId, completion_pct: completionPct, status: "testing" });
}

async function resolveRetest(env, client, body) {
  const sequenceRef = positiveInteger(body.sequence_ref);
  if (!sequenceRef) return json({ ok: false, error: "sequence_ref is required" }, 422);

  const sequence = await env.DB.prepare(
    "SELECT id, client_id FROM sequence_log WHERE id=?",
  ).bind(sequenceRef).first();
  if (!sequence || cleanId(sequence.client_id) !== client) {
    return json({ ok: false, error: "sequence log not found" }, 404);
  }

  const result = await env.DB.prepare(
    `SELECT ${VARIANT_COLUMNS}
       FROM sequence_variants
      WHERE client_id=? AND sequence_ref=? AND status='testing'
      ORDER BY id`,
  ).bind(client, sequenceRef).all();
  const testing = result.results || [];
  if (testing.length !== 2) {
    return json({ ok: false, error: "a retest needs exactly two testing variants" }, 422);
  }
  if (testing.some((variant) => validCompletion(variant.completion_pct) == null)) {
    return json({ ok: false, error: "log both completion results before resolving" }, 422);
  }

  const [first, second] = testing;
  const firstCompletion = Number(first.completion_pct);
  const secondCompletion = Number(second.completion_pct);
  if (firstCompletion === secondCompletion) {
    return json({ ok: false, error: "the variants are tied; collect another result before resolving" }, 422);
  }
  const winner = firstCompletion > secondCompletion ? first : second;
  const loser = winner.id === first.id ? second : first;
  const timestamp = nowIso();
  const results = await env.DB.batch([
    env.DB.prepare(
      `UPDATE sequence_variants
          SET status='won', resolved_at=?
        WHERE id=? AND client_id=? AND sequence_ref=? AND status='testing'`,
    ).bind(timestamp, Number(winner.id), client, sequenceRef),
    env.DB.prepare(
      `UPDATE sequence_variants
          SET status='lost', resolved_at=?
        WHERE id=? AND client_id=? AND sequence_ref=? AND status='testing'`,
    ).bind(timestamp, Number(loser.id), client, sequenceRef),
  ]);
  if (results.some((entry) => Number(entry?.meta?.changes || 0) !== 1)) {
    return json({ ok: false, error: "the retest changed before it could be resolved" }, 409);
  }

  return json({
    ok: true,
    sequence_ref: sequenceRef,
    winner: serializeVariant({ ...winner, status: "won", resolved_at: timestamp }),
    loser: serializeVariant({ ...loser, status: "lost", resolved_at: timestamp }),
  });
}

async function listVariants(env, client) {
  const query = client
    ? `SELECT ${VARIANT_COLUMNS} FROM sequence_variants WHERE client_id=? ORDER BY sequence_ref DESC, id`
    : `SELECT ${VARIANT_COLUMNS} FROM sequence_variants ORDER BY client_id, sequence_ref DESC, id`;
  const statement = env.DB.prepare(query);
  const result = client ? await statement.bind(client).all() : await statement.all();
  return result.results || [];
}

async function listSequences(env, client) {
  const columns = "id, client_id, posted_on, type, topic, slide_count, slide_views_json";
  const query = client
    ? `SELECT ${columns} FROM sequence_log WHERE client_id=? ORDER BY id DESC`
    : `SELECT ${columns} FROM sequence_log ORDER BY client_id, id DESC`;
  const statement = env.DB.prepare(query);
  const result = client ? await statement.bind(client).all() : await statement.all();
  return result.results || [];
}

function groupLineage(variants, sequences) {
  const sequenceByKey = new Map(sequences.map((sequence) => [lineageKey(sequence.client_id, sequence.id), sequence]));
  const groups = new Map();
  for (const variant of variants) {
    const key = lineageKey(variant.client_id, variant.sequence_ref);
    if (!groups.has(key)) {
      const sequence = sequenceByKey.get(key) || {};
      const diagnostic = computeDiagnostic(sequence.slide_views_json, sequence.slide_count);
      groups.set(key, {
        client_id: variant.client_id,
        sequence_ref: Number(variant.sequence_ref || 0),
        sequence: {
          posted_on: sequence.posted_on || "",
          type: sequence.type || "",
          topic: sequence.topic || "",
        },
        leaking_slide: diagnostic.biggestDropSlide,
        leak_loss_pct: diagnostic.biggestDropPct,
        active: false,
        resolved: false,
        winner: null,
        variants: [],
      });
    }
    const group = groups.get(key);
    const serialized = serializeVariant(variant);
    group.variants.push(serialized);
    if (serialized.status === "testing") group.active = true;
    if (serialized.status === "won") group.winner = serialized;
  }
  for (const group of groups.values()) group.resolved = Boolean(group.winner) && !group.active;
  return Array.from(groups.values()).sort((a, b) => b.sequence_ref - a.sequence_ref);
}

function computeDiagnostic(slideViewsJson, slideCount) {
  const views = parseSlideViews(slideViewsJson, slideCount);
  const first = Number(views[0] || 0);
  const last = Number(views.at(-1) || 0);
  const completionPct = first > 0 ? round1((last / first) * 100) : null;
  let biggestDrop = 0;
  let biggestDropSlide = null;
  let biggestDropPct = null;
  for (let index = 1; index < views.length; index += 1) {
    const prior = Number(views[index - 1] || 0);
    const current = Number(views[index] || 0);
    const drop = prior - current;
    if (drop > biggestDrop) {
      biggestDrop = drop;
      biggestDropSlide = index + 1;
      biggestDropPct = prior > 0 ? round1((drop / prior) * 100) : null;
    }
  }
  const name = completionPct != null && completionPct >= 70
    ? "healthy"
    : (biggestDropSlide === 2
      ? "hook failed"
      : (biggestDropSlide != null && biggestDropSlide >= 6 && biggestDropSlide <= 8
        ? "body failed before the ask"
        : "monitor"));
  return { name, completionPct, biggestDropSlide, biggestDropPct };
}

function parseSlideViews(value, slideCount) {
  try {
    const parsed = JSON.parse(value || "[]");
    if (!Array.isArray(parsed)) return [];
    return parsed
      .map(Number)
      .filter((item) => Number.isFinite(item) && item >= 0)
      .slice(0, Math.max(0, Number(slideCount || parsed.length)));
  } catch {
    return [];
  }
}

function serializeVariant(variant) {
  return {
    id: Number(variant.id || 0),
    client_id: variant.client_id,
    sequence_ref: Number(variant.sequence_ref || 0),
    label: variant.label || "",
    hook_text: variant.hook_text || "",
    status: variant.status || "testing",
    completion_pct: variant.completion_pct == null ? null : Number(variant.completion_pct),
    started_at: variant.started_at || "",
    resolved_at: variant.resolved_at || "",
    created_at: variant.created_at || "",
  };
}

function nextVariantNumber(variants) {
  const numbers = variants.map((variant) => Number(String(variant.label || "").match(/^v(\d+)$/i)?.[1] || 0));
  return Math.max(1, ...numbers) + 1;
}

function normalizeHook(value) {
  return String(value || "").trim().replace(/\s+/g, " ").slice(0, 1000);
}

function positiveInteger(value) {
  const number = Number(value);
  return Number.isInteger(number) && number > 0 ? number : null;
}

function validCompletion(value) {
  if (value == null || value === "") return null;
  const number = Number(value);
  return Number.isFinite(number) && number >= 0 && number <= 100 ? round1(number) : null;
}

function lineageKey(client, sequenceRef) {
  return `${cleanId(client)}:${Number(sequenceRef || 0)}`;
}

function round1(value) {
  return Math.round(Number(value || 0) * 10) / 10;
}

-- Controlled hook retests tied to logged sequence metrics.

CREATE TABLE IF NOT EXISTS sequence_variants (
  id               INTEGER PRIMARY KEY AUTOINCREMENT,
  client_id        TEXT NOT NULL,
  sequence_ref     INTEGER NOT NULL,
  label            TEXT NOT NULL,
  hook_text        TEXT NOT NULL,
  status           TEXT NOT NULL CHECK (status IN ('testing', 'won', 'lost', 'retired')),
  completion_pct   REAL CHECK (completion_pct IS NULL OR (completion_pct >= 0 AND completion_pct <= 100)),
  started_at       TEXT NOT NULL,
  resolved_at      TEXT,
  created_at       TEXT NOT NULL,
  UNIQUE (client_id, sequence_ref, label)
);

CREATE INDEX IF NOT EXISTS idx_sequence_variants_client_status
  ON sequence_variants (client_id, status, started_at);

CREATE INDEX IF NOT EXISTS idx_sequence_variants_sequence
  ON sequence_variants (client_id, sequence_ref, id);

import { strict as assert } from "node:assert";
import { readFile } from "node:fs/promises";
import * as variantsApi from "../functions/api/sequence-variants.js";
import { CLIENT_SESSION_COOKIE } from "../functions/_shared/client-auth.js";

class MockDB {
  constructor() {
    this.configs = [];
    this.clientSessions = [];
    this.impersonationSessions = [];
    this.sequences = [];
    this.variants = [];
    this.nextVariantId = 1;
  }

  prepare(sql) {
    return new MockStatement(this, sql);
  }

  async batch(statements) {
    const results = [];
    for (const statement of statements) results.push(await statement.run());
    return results;
  }
}

class MockStatement {
  constructor(db, sql) {
    this.db = db;
    this.sql = sql.replace(/\s+/g, " ").trim();
    this.values = [];
  }

  bind(...values) {
    this.values = values;
    return this;
  }

  async first() {
    if (this.sql.includes("FROM impersonation_sessions s")) {
      const [tokenHash, cutoff] = this.values;
      const row = this.db.impersonationSessions.find((entry) =>
        entry.token_hash === tokenHash && entry.consumed_at && entry.expires_at > cutoff);
      if (!row) return null;
      const config = this.db.configs.find((entry) => entry.client === row.client_id);
      return { ...row, client_name: config?.client_name || row.client_id };
    }
    if (this.sql.includes("FROM client_sessions s")) {
      const [tokenHash, cutoff] = this.values;
      const row = this.db.clientSessions.find((entry) => entry.token_hash === tokenHash && entry.expires_at > cutoff);
      if (!row) return null;
      const config = this.db.configs.find((entry) => entry.client === row.client_id);
      return { ...row, client_name: config?.client_name || row.client_id };
    }
    if (this.sql.includes("FROM client_config") && this.sql.includes("portal_token_hash=?")) {
      const row = this.db.configs.find((entry) => entry.portal_token_hash === this.values[0]);
      return row ? { client: row.client, client_name: row.client_name || row.client } : null;
    }
    if (this.sql.includes("FROM sequence_log") && this.sql.includes("WHERE id=?")) {
      const row = this.db.sequences.find((entry) => entry.id === Number(this.values[0]));
      if (!row) return null;
      if (this.sql === "SELECT id, client_id FROM sequence_log WHERE id=?") {
        return { id: row.id, client_id: row.client_id };
      }
      return { ...row };
    }
    if (this.sql.includes("FROM sequence_variants") && this.sql.includes("WHERE id=?")) {
      const row = this.db.variants.find((entry) => entry.id === Number(this.values[0]));
      return row ? { ...row } : null;
    }
    throw new Error(`Unexpected first query: ${this.sql}`);
  }

  async all() {
    if (this.sql.includes("FROM sequence_variants")) {
      let rows = [...this.db.variants];
      if (this.sql.includes("WHERE client_id=? AND sequence_ref=? AND status='testing'")) {
        rows = rows.filter((row) => row.client_id === this.values[0]
          && row.sequence_ref === Number(this.values[1]) && row.status === "testing");
      } else if (this.sql.includes("WHERE client_id=? AND sequence_ref=?")) {
        rows = rows.filter((row) => row.client_id === this.values[0]
          && row.sequence_ref === Number(this.values[1]));
      } else if (this.sql.includes("WHERE client_id=?")) {
        rows = rows.filter((row) => row.client_id === this.values[0]);
      }
      return { results: rows.sort((a, b) => a.id - b.id).map((row) => ({ ...row })) };
    }
    if (this.sql.includes("FROM sequence_log")) {
      let rows = [...this.db.sequences];
      if (this.sql.includes("WHERE client_id=?")) rows = rows.filter((row) => row.client_id === this.values[0]);
      return { results: rows.map((row) => ({ ...row })) };
    }
    throw new Error(`Unexpected all query: ${this.sql}`);
  }

  async run() {
    if (this.sql === "DELETE FROM client_sessions WHERE expires_at<?") {
      this.db.clientSessions = this.db.clientSessions.filter((row) => row.expires_at >= this.values[0]);
      return changed(0);
    }
    if (this.sql === "DELETE FROM impersonation_sessions WHERE expires_at<?") {
      this.db.impersonationSessions = this.db.impersonationSessions.filter((row) => row.expires_at >= this.values[0]);
      return changed(0);
    }
    if (this.sql.startsWith("INSERT INTO sequence_variants")) {
      let clientId;
      let sequenceRef;
      let label;
      let hookText;
      let completionPct;
      let startedAt;
      let createdAt;
      if (this.sql.includes("VALUES (?, ?, 'v1'")) {
        [clientId, sequenceRef, hookText, completionPct, startedAt, createdAt] = this.values;
        label = "v1";
      } else {
        [clientId, sequenceRef, label, hookText, startedAt, createdAt] = this.values;
        completionPct = null;
      }
      const id = this.db.nextVariantId++;
      this.db.variants.push({
        id,
        client_id: clientId,
        sequence_ref: Number(sequenceRef),
        label,
        hook_text: hookText,
        status: "testing",
        completion_pct: completionPct,
        started_at: startedAt,
        resolved_at: null,
        created_at: createdAt,
      });
      return { meta: { changes: 1, last_row_id: id } };
    }
    if (this.sql.includes("SET completion_pct=?")) {
      const [completionPct, id, clientId] = this.values;
      const row = this.db.variants.find((entry) => entry.id === Number(id)
        && entry.client_id === clientId && entry.status === "testing");
      if (!row) return changed(0);
      row.completion_pct = completionPct;
      return changed(1);
    }
    if (this.sql.includes("SET status='won'")) return updateResolvedVariant(this.db, this.values, "won");
    if (this.sql.includes("SET status='lost'")) return updateResolvedVariant(this.db, this.values, "lost");
    if (this.sql.includes("SET status='testing', resolved_at=NULL")) {
      const [startedAt, id, clientId, sequenceRef] = this.values;
      const row = this.db.variants.find((entry) => entry.id === Number(id)
        && entry.client_id === clientId && entry.sequence_ref === Number(sequenceRef) && entry.status === "won");
      if (!row) return changed(0);
      Object.assign(row, { status: "testing", resolved_at: null, started_at: startedAt });
      return changed(1);
    }
    throw new Error(`Unexpected run query: ${this.sql}`);
  }
}

function updateResolvedVariant(db, values, status) {
  const [resolvedAt, id, clientId, sequenceRef] = values;
  const row = db.variants.find((entry) => entry.id === Number(id)
    && entry.client_id === clientId && entry.sequence_ref === Number(sequenceRef) && entry.status === "testing");
  if (!row) return changed(0);
  Object.assign(row, { status, resolved_at: resolvedAt });
  return changed(1);
}

function changed(changes) {
  return { meta: { changes } };
}

async function sha256Hex(value) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((byte) => byte.toString(16).padStart(2, "0")).join("");
}

function request(method, body, headers = {}, query = "") {
  return new Request(`https://funnels.test/api/sequence-variants${query}`, {
    method,
    headers: { "content-type": "application/json", ...headers },
    body: body == null ? undefined : JSON.stringify(body),
  });
}

async function createFixture() {
  const db = new MockDB();
  const alphaToken = "alpha-portal-token";
  const betaToken = "beta-portal-token";
  db.configs.push(
    { client: "alpha", client_name: "Alpha Coach", portal_token_hash: await sha256Hex(alphaToken) },
    { client: "beta", client_name: "Beta Coach", portal_token_hash: await sha256Hex(betaToken) },
  );
  db.sequences.push(
    {
      id: 11,
      client_id: "alpha",
      posted_on: "2026-07-15",
      type: "value-driven",
      topic: "The profile fix that changed the DMs",
      slide_count: 4,
      slide_views_json: JSON.stringify([1000, 500, 450, 400]),
    },
    {
      id: 22,
      client_id: "beta",
      posted_on: "2026-07-15",
      type: "credibility",
      topic: "Beta private hook",
      slide_count: 4,
      slide_views_json: JSON.stringify([900, 300, 280, 250]),
    },
  );
  return { env: { DB: db, ADMIN_KEY: "operator-secret" }, db, alphaToken, betaToken };
}

async function testLifecycleAndIsolation() {
  const { env, db, alphaToken } = await createFixture();
  const started = await variantsApi.onRequestPost({
    request: request("POST", {
      action: "start",
      sequence_ref: 11,
      new_hook: "The DMs changed after one profile line moved.",
    }, { "x-portal-token": alphaToken }),
    env,
  });
  assert.equal(started.status, 200);
  const startedBody = await started.json();
  assert.equal(startedBody.leaking_slide, 2);
  assert.equal(startedBody.leak_loss_pct, 50);
  assert.equal(startedBody.variant.label, "v2");
  assert.equal(db.variants.length, 2);
  assert.deepEqual(db.variants.map((row) => row.client_id), ["alpha", "alpha"]);
  assert.equal(db.variants[0].sequence_ref, 11);
  assert.equal(db.variants[0].label, "v1");
  assert.equal(db.variants[0].hook_text, "The profile fix that changed the DMs");
  assert.equal(db.variants[0].completion_pct, 40);
  assert.equal(db.variants[1].label, "v2");
  assert.equal(db.variants[1].hook_text, "The DMs changed after one profile line moved.");
  assert.equal(db.variants[1].status, "testing");

  const crossClient = await variantsApi.onRequestPost({
    request: request("POST", {
      action: "start",
      sequence_ref: 22,
      new_hook: "This must stay blocked.",
    }, { "x-portal-token": alphaToken }),
    env,
  });
  assert.equal(crossClient.status, 404);

  const logged = await variantsApi.onRequestPost({
    request: request("POST", {
      action: "log",
      variant_id: db.variants[1].id,
      completion_pct: 61.5,
    }, { "x-portal-token": alphaToken }),
    env,
  });
  assert.equal(logged.status, 200);

  const resolved = await variantsApi.onRequestPost({
    request: request("POST", { action: "resolve", sequence_ref: 11 }, { "x-portal-token": alphaToken }),
    env,
  });
  assert.equal(resolved.status, 200);
  const resolvedBody = await resolved.json();
  assert.equal(resolvedBody.winner.label, "v2");
  assert.equal(resolvedBody.winner.status, "won");
  assert.equal(resolvedBody.loser.label, "v1");
  assert.equal(resolvedBody.loser.status, "lost");
  assert.equal(db.variants.find((row) => row.label === "v2").status, "won");
  assert.equal(db.variants.find((row) => row.label === "v1").status, "lost");
}

async function testImpersonationReadOnlyAndClientRead() {
  const { env, db } = await createFixture();
  db.variants.push({
    id: db.nextVariantId++,
    client_id: "alpha",
    sequence_ref: 11,
    label: "v1",
    hook_text: "Original hook",
    status: "testing",
    completion_pct: 40,
    started_at: new Date().toISOString(),
    resolved_at: null,
    created_at: new Date().toISOString(),
  });
  const rawToken = "impersonated-retest-session";
  db.impersonationSessions.push({
    token_hash: await sha256Hex(rawToken),
    client_id: "alpha",
    consumed_at: new Date().toISOString(),
    created_by: "admin",
    expires_at: new Date(Date.now() + 30 * 60 * 1000).toISOString(),
  });
  const headers = { cookie: `${CLIENT_SESSION_COOKIE}=${rawToken}` };
  const read = await variantsApi.onRequestGet({ request: request("GET", null, headers), env });
  assert.equal(read.status, 200);
  assert.equal((await read.json()).rows[0].sequence_ref, 11);

  for (const body of [
    { action: "start", sequence_ref: 11, new_hook: "Blocked" },
    { action: "log", variant_id: 1, completion_pct: 60 },
    { action: "resolve", sequence_ref: 11 },
  ]) {
    const write = await variantsApi.onRequestPost({ request: request("POST", body, headers), env });
    assert.equal(write.status, 403, `${body.action} must reject impersonated sessions`);
    assert.deepEqual(await write.json(), { error: "read only" });
  }
}

async function testAdminReadAuthAndCrossClientCoverage() {
  const { env, db } = await createFixture();
  db.variants.push(
    { id: db.nextVariantId++, client_id: "alpha", sequence_ref: 11, label: "v1", hook_text: "Alpha", status: "won", completion_pct: 50, started_at: "a", resolved_at: "b", created_at: "a" },
    { id: db.nextVariantId++, client_id: "beta", sequence_ref: 22, label: "v1", hook_text: "Beta", status: "won", completion_pct: 55, started_at: "a", resolved_at: "b", created_at: "a" },
  );

  const denied = await variantsApi.onRequestGet({ request: request("GET", null, {}, "?admin=1"), env });
  assert.equal(denied.status, 401);

  const allowed = await variantsApi.onRequestGet({
    request: request("GET", null, { "x-admin-key": "operator-secret" }, "?admin=1"),
    env,
  });
  assert.equal(allowed.status, 200);
  const body = await allowed.json();
  assert.deepEqual(new Set(body.rows.map((row) => row.client_id)), new Set(["alpha", "beta"]));
}

async function testMigrationAndPortalContract() {
  const sql = await readFile(new URL("../migrations/0019_sequence_variants.sql", import.meta.url), "utf8");
  assert.match(sql, /CREATE TABLE IF NOT EXISTS sequence_variants/);
  assert.match(sql, /sequence_ref\s+INTEGER NOT NULL/);
  assert.match(sql, /UNIQUE \(client_id, sequence_ref, label\)/);
  assert.match(sql, /CHECK \(status IN \('testing', 'won', 'lost', 'retired'\)\)/);
  assert.doesNotMatch(sql, /\b(?:DROP|ALTER|DELETE|UPDATE)\b/i);

  const portal = await readFile(new URL("../portal/index.html", import.meta.url), "utf8");
  assert.match(portal, /\/api\/sequence-variants/);
  assert.match(portal, /data-retest-sequence/);
  assert.match(portal, /How the retest works/);
  assert.match(portal, /Keep every other slide identical/);
  assert.match(portal, /data-log-variant/);
  assert.match(portal, /data-resolve-retest/);
  assert.match(portal, /A hook retest is running on/);
  assert.match(portal, /won the hook retest on/);
}

try {
  await testLifecycleAndIsolation();
  await testImpersonationReadOnlyAndClientRead();
  await testAdminReadAuthAndCrossClientCoverage();
  await testMigrationAndPortalContract();
  console.log("PASS sequence variants: start, capture, isolation, impersonation, logging, resolution, admin auth, portal, and migration");
} catch (error) {
  console.error(`FAIL sequence variants: ${error?.stack || error}`);
  process.exitCode = 1;
}

