    "proof-wall",
    "real-workspace",
  ].includes(sanitized.slides[0].design.image_class.type));
  assert.doesNotMatch(sanitized.slides[0].design.image_class.artifact, /supercar|luxury|hotel/i);

  const taxonomy = sanitizeCarouselOutput({
