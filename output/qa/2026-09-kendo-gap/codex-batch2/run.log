.int-hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1.2fr .8fr;gap:24px;padding:28px;border:1px solid hsl(var(--border));border-radius:16px;background:linear-gradient(135deg,hsl(var(--card)) 0%,hsl(var(--card-raised)) 60%,hsl(var(--primary)/.08) 100%)}
.int-hero:before{content:"";position:absolute;inset:0;pointer-events:none;background:radial-gradient(hsl(var(--foreground)/.05) 1px,transparent 1px);background-size:16px 16px;opacity:.5}
.int-hero>*{position:relative}
.int-eyebrow{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:hsl(var(--muted-foreground));border:1px solid hsl(var(--border));border-radius:999px;padding:4px 10px}
.int-hero-title{display:flex;align-items:center;gap:12px;margin-top:16px}
.int-hero-title h2{margin:0;font:600 20px Inter,system-ui}
.int-hero p{color:hsl(var(--muted-foreground));margin:12px 0 0;max-width:46ch}
.int-hero-actions{display:flex;gap:8px;margin-top:20px;flex-wrap:wrap}
.int-hero-side{border:1px solid hsl(var(--border));border-radius:12px;padding:16px;background:hsl(var(--background)/.6);backdrop-filter:blur(8px)}
.int-hero-side ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.int-hero-side li{font-size:14px;padding-left:22px;position:relative}
.int-hero-side li:before{content:"";position:absolute;left:0;top:5px;width:12px;height:12px;border-radius:50%;background:hsl(var(--primary)/.2);box-shadow:inset 0 0 0 1px hsl(var(--primary))}
.int-icon{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:10px;border:1px solid hsl(var(--border));background:hsl(var(--background));font:600 13px Inter,system-ui;letter-spacing:.02em;color:hsl(var(--primary))}
.ps-card.int-icon,.int-card .int-icon{width:36px;height:36px;margin-bottom:16px}
.int-strip{display:flex;gap:6px;overflow-x:auto;padding:12px 0 4px;margin:16px 0 8px;scrollbar-width:none}
.int-strip::-webkit-scrollbar{display:none}
.int-chip{flex:none;display:inline-flex;align-items:center;gap:8px;border:1px solid hsl(var(--border));background:hsl(var(--card));color:inherit;border-radius:8px;padding:8px 12px;font:500 13px Inter,system-ui;cursor:pointer;transition:background-color var(--dur) var(--ease),border-color var(--dur) var(--ease)}
.int-chip.active,.int-chip:hover{background:hsl(var(--muted))}
.int-dot{width:7px;height:7px;border-radius:50%;background:hsl(var(--muted-foreground)/.4)}
.int-dot-connected{background:hsl(var(--primary))}.int-dot-attention{background:hsl(var(--warning))}
.int-card{position:relative}.int-card .int-pill{position:absolute;top:18px;right:18px}
.int-pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;border:1px solid hsl(var(--border));padding:3px 9px;font:600 10px Inter,system-ui;letter-spacing:.06em;text-transform:uppercase;color:hsl(var(--muted-foreground));background:hsl(var(--muted)/.4)}
.int-pill:before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.7}
.int-pill-ok{color:hsl(var(--primary));border-color:hsl(var(--primary)/.35)}.int-pill-warn{color:hsl(var(--warning));border-color:hsl(var(--warning)/.33)}
.int-note{font-size:13px;color:hsl(var(--muted-foreground))}
.int-note code,.int-table code,.int-secret{font:12px ui-monospace,SFMono-Regular,Menlo,monospace;background:hsl(var(--muted));border-radius:4px;padding:2px 6px}
.int-secret{display:block;padding:12px;word-break:break-all;margin:12px 0}

.int-table{border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));overflow:hidden}
.int-table table,.int-mini{width:100%;border-collapse:collapse;font-size:13px}
.int-table th,.int-mini th{text-align:left;font:600 10px Inter,system-ui;letter-spacing:.08em;text-transform:uppercase;color:hsl(var(--muted-foreground));padding:10px 14px;background:hsl(var(--muted)/.5);border-bottom:1px solid hsl(var(--border))}
.int-table td,.int-mini td{padding:12px 14px;border-bottom:1px solid hsl(var(--border)/.5);vertical-align:middle;font-variant-numeric:tabular-nums}
.int-table tr:last-child td{border-bottom:0}
.int-table td small{display:block;color:hsl(var(--muted-foreground));font-size:11px;margin-top:2px}
.int-empty{color:hsl(var(--muted-foreground));text-align:center;padding:28px 14px!important}
.int-muted{opacity:.5}
.int-row-actions{display:flex;gap:6px;justify-content:flex-end;white-space:nowrap}
.int-table .int-actions{padding:12px 14px;border-top:1px solid hsl(var(--border));display:flex;justify-content:flex-end}

.int-form h2{margin:0 0 12px;font:600 18px Inter,system-ui}
.int-form label{display:block;font:500 12px Inter,system-ui;margin:12px 0 0;color:hsl(var(--muted-foreground))}
.int-form input:not([type=checkbox]):not([type=radio]){display:block;width:100%;margin-top:6px}

.int-events{border:1px solid hsl(var(--border));border-radius:8px;padding:8px 12px;margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:4px}
.int-events legend{font-size:12px;color:hsl(var(--muted-foreground));padding:0 4px}
.int-check{display:flex;align-items:center;gap:8px;font:13px Inter,system-ui!important;color:inherit!important;margin:2px 0!important}
.int-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
.int-msg{color:hsl(var(--destructive));font-size:13px;margin:12px 0 0}
@media(max-width:900px){.int-hero{grid-template-columns:1fr}.int-events{grid-template-columns:1fr}.int-row-actions{flex-wrap:wrap;justify-content:flex-start}}
/* Leads view */
.leads-search{min-width:240px}

.int-tabs .leads-search,.int-tabs .ps-control{margin-left:6px}
.leads-filters{display:flex;gap:6px;padding:10px 12px;border-bottom:1px solid hsl(var(--border))}
.leads-chip{border:1px solid hsl(var(--border));background:hsl(var(--card));color:hsl(var(--muted-foreground));border-radius:999px;padding:4px 11px;font:500 12px Inter,system-ui;cursor:pointer}
