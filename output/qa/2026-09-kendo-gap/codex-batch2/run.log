.ot-stat-warn b{color:hsl(var(--warning))}.ot-stat-muted b{color:hsl(var(--muted-foreground))}
.ot-tabs{margin-bottom:14px}
.ot-activity{display:flex;gap:14px;align-items:center;flex-wrap:wrap;padding:10px 14px;border:1px solid hsl(var(--border));border-radius:10px;background:hsl(var(--card));margin-bottom:14px;font-size:12px}
.ot-activity strong{color:hsl(var(--muted-foreground));font-weight:600;font-size:11px;letter-spacing:.06em;text-transform:uppercase}
.ot-event{white-space:nowrap}.ot-event small{color:hsl(var(--muted-foreground))}
.ot-group{margin-bottom:22px}
.ot-group h2{display:flex;align-items:baseline;gap:8px;font:600 13px Inter,system-ui!important;letter-spacing:.02em;margin:0 0 8px!important;color:hsl(var(--foreground))}
.ot-group h2 span{color:hsl(var(--muted-foreground));font-weight:500}.ot-group h2 small{color:hsl(var(--muted-foreground));font-weight:400;font-size:12px}
.ot-card{border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));margin-bottom:8px;overflow:hidden;transition:border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.ot-card.due{border-color:hsl(var(--warning)/.4)}.ot-card.open{box-shadow:var(--shadow-card-hover)}
.ot-row{display:grid;grid-template-columns:40px minmax(160px,1.1fr) minmax(0,2fr) auto 24px;gap:14px;align-items:center;padding:12px 16px;cursor:pointer}
.ot-row:hover{background:hsl(var(--card-raised))}
.ot-avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:hsl(var(--muted));color:hsl(var(--foreground));font:600 13px Inter,system-ui;object-fit:cover;flex:none}
.ot-who strong{display:block;font:500 14px Inter,system-ui}.ot-who small,.ot-last small,.ot-meta small{display:block;color:hsl(var(--muted-foreground));font-size:11.5px;margin-top:2px}
.ot-last span{display:block;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:hsl(var(--foreground)/.85)}
.ot-meta{display:flex;flex-direction:column;align-items:flex-end;gap:4px;text-align:right}
.ot-meta .int-pill{white-space:nowrap}
.ot-stage-replied{color:hsl(var(--warning));border-color:hsl(var(--warning)/.33)}.ot-stage-ok{color:hsl(var(--primary));border-color:hsl(var(--primary)/.35)}.ot-stage-off{opacity:.6}
.ot-chevron{color:hsl(var(--muted-foreground));font-size:18px;text-align:center}
.ot-detail{border-top:1px solid hsl(var(--border));padding:14px 16px;display:grid;gap:12px;background:hsl(var(--background)/.4)}
.ot-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.ot-actions .ps-control.active{background:hsl(var(--primary)/.15);border-color:hsl(var(--primary)/.5)}
.ot-actions-label{font-size:11px;color:hsl(var(--muted-foreground));text-transform:uppercase;letter-spacing:.06em;margin:0 4px 0 6px}
.ot-actions-label:first-child{margin-left:0}
.ot-messages{display:grid;gap:8px;max-height:360px;overflow:auto;padding:12px;border:1px solid hsl(var(--border));border-radius:10px;background:hsl(var(--background))}
.ot-msg{max-width:78%;padding:9px 12px;border-radius:12px;background:hsl(var(--muted));justify-self:start}
.ot-msg.outbound{justify-self:end;background:hsl(var(--primary)/.15)}
.ot-msg p{margin:0 0 4px;font-size:13.5px;white-space:pre-wrap;word-break:break-word}.ot-msg small{font-size:11px;color:hsl(var(--muted-foreground))}
.ot-note{display:flex;gap:8px;align-items:flex-start}
.ot-note textarea{flex:1}
@media(max-width:1000px){.ot-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.ot-row{grid-template-columns:40px 1fr 24px}.ot-last{grid-column:2}.ot-meta{grid-column:2;flex-direction:row;flex-wrap:wrap;align-items:center;text-align:left}.ot-chevron{grid-row:1}}
/* Search */
.sr-form{display:flex;gap:8px;max-width:760px;margin:8px 0 12px}
.sr-input{flex:1}

.sr-filters{display:flex;gap:6px;align-items:center;margin-bottom:18px}.sr-filters small{margin-left:8px}
.sr-examples{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px}
.sr-results{max-width:860px}
.sr-group h2{font:600 13px Inter,system-ui!important;letter-spacing:.02em;margin:18px 0 8px!important}.sr-group h2 span{color:hsl(var(--muted-foreground));font-weight:500}
.sr-hit{display:flex;gap:12px;align-items:flex-start;width:100%;text-align:left;padding:12px 14px;margin-bottom:6px;border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));color:inherit;cursor:pointer;transition:background-color var(--dur) var(--ease)}
.sr-hit:hover{background:hsl(var(--card-raised))}
.sr-hit strong{font:500 14px Inter,system-ui}.sr-hit small{color:hsl(var(--muted-foreground));font-size:11.5px}.sr-hit p{margin:4px 0 0;font-size:13px;color:hsl(var(--foreground)/.85);line-height:1.45}
.sr-hit .ot-avatar{width:32px;height:32px;font-size:11px}
/* Today queue. Tokens come from shared/shell.css; this file only shapes rows. */
.qv-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;flex-wrap:wrap;margin-bottom:8px}
.qv-head .ps-subtitle{margin-bottom:12px;max-width:560px}
.qv-counters{display:grid;grid-template-columns:repeat(2,minmax(150px,1fr));gap:1px;border:1px solid hsl(var(--border));border-radius:12px;overflow:hidden;background:hsl(var(--border));box-shadow:inset 0 0 0 1px #ffffff0a;min-width:320px}
.qv-counter{background:hsl(var(--card));padding:14px 18px;min-height:92px;display:flex;flex-direction:column;justify-content:space-between}
.qv-counter small{font-size:11px;color:hsl(var(--muted-foreground))}
