.qv-section h2 span:empty{display:none}
.qv-section h2 small{color:hsl(var(--muted-foreground));font-weight:400;font-size:12px}
.qv-list{display:grid;gap:8px}
.qv-empty{margin:0;padding:22px 16px;border:1px dashed hsl(var(--border));border-radius:12px;color:hsl(var(--muted-foreground));font-size:13px;text-align:center}
/* Rows */
.qv-row{border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));box-shadow:inset 0 0 0 1px #ffffff08;outline:none;transition:border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease),background-color var(--dur) var(--ease)}
.qv-row.focus{border-color:hsl(var(--primary)/.55);box-shadow:inset 0 0 0 1px #ffffff08,0 0 0 1px hsl(var(--primary)/.25)}
.qv-row.open{box-shadow:inset 0 0 0 1px #ffffff08,0 4px 14px -6px #0006}
.qv-row.needs{border-color:#e0b05055}
.qv-follow{display:grid;grid-template-columns:40px minmax(140px,.9fr) minmax(0,2fr) auto auto;gap:14px;align-items:center;padding:12px 16px}
.qv-avatar{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;background:hsl(var(--muted));color:hsl(var(--foreground));font:600 13px Inter,system-ui;object-fit:cover;flex:none}
.qv-avatar.small{width:30px;height:30px;font-size:11px}
.qv-who{min-width:0}.qv-who strong{display:block;font:500 14px Inter,system-ui;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.qv-who small,.qv-last small{display:block;color:hsl(var(--muted-foreground));font-size:11.5px;margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.qv-last{min-width:0}.qv-last span{display:block;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:hsl(var(--foreground)/.85)}
.qv-actions{display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.qv-actions .ps-control{white-space:nowrap;text-decoration:none;box-shadow:inset 0 0 0 1px #ffffff0d,0 1px 2px 0 #0000004d;transition:filter var(--dur) var(--ease),color var(--dur) var(--ease),background-color var(--dur) var(--ease),border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.qv-actions .ps-control:hover{background:hsl(var(--card-raised))}
.qv-actions .ps-control:disabled{opacity:.6;cursor:default}
.qv-primary{background:hsl(var(--button-primary))!important;color:hsl(var(--button-primary-foreground))!important;border-color:transparent!important;box-shadow:0 1px 2px 0 #0006!important}
.qv-primary:hover{filter:brightness(1.08)}
.qv-primary.done{background:hsl(var(--primary))!important;color:hsl(var(--primary-foreground))!important}
.qv-quiet{color:hsl(var(--muted-foreground))}
.qv-stage-replied{color:#e0b050;border-color:#e0b05055}.qv-stage-ok{color:hsl(var(--primary));border-color:hsl(var(--primary)/.35)}.qv-stage-off{opacity:.6}
/* Openers */
.qv-opener{overflow:hidden}
.qv-opener-row{display:grid;grid-template-columns:40px minmax(140px,.9fr) minmax(0,2fr) auto 24px;gap:14px;align-items:center;padding:12px 16px;cursor:pointer;transition:background-color var(--dur) var(--ease)}
.qv-opener-row:hover{background:hsl(var(--card-raised))}
.qv-meta{display:flex;align-items:center;gap:6px}.qv-meta .int-pill{white-space:nowrap}
.qv-chevron{color:hsl(var(--muted-foreground));font-size:18px;text-align:center;line-height:1}
.qv-words{color:hsl(var(--muted-foreground));font-size:11.5px;font-variant-numeric:tabular-nums}.qv-words.off{color:#e0b050}
.qv-detail{border-top:1px solid hsl(var(--border));padding:14px 16px 16px;display:grid;gap:12px;background:hsl(var(--background)/.4);animation:ps-enter var(--dur) var(--ease)}
.qv-detail[hidden]{display:none}
.qv-field{display:grid;gap:6px;font:500 12px Inter,system-ui;color:hsl(var(--muted-foreground))}
.qv-field>small{font-weight:400;font-size:11.5px}
.qv-input{width:100%;height:38px;padding:0 12px;border-radius:8px;border:1px solid hsl(var(--input));background:hsl(var(--muted));color:hsl(var(--foreground));font:14px Inter,system-ui;box-shadow:inset 0 0 0 1px #ffffff0d,0 1px 2px #0000004d;transition:border-color var(--dur) var(--ease),box-shadow var(--dur) var(--ease)}
.qv-input:focus{outline:none;border-color:hsl(var(--primary)/.6);box-shadow:0 0 0 1px hsl(var(--primary)/.35)}
textarea.qv-input{height:auto;min-height:96px;padding:10px 12px;resize:vertical;line-height:1.5;font-size:14px}
.qv-draft-foot{display:flex;justify-content:space-between;gap:10px;align-items:baseline}
