.leads-msg small{font-size:11px;color:hsl(var(--muted-foreground))}
@media(max-width:900px){.leads-search{min-width:0;width:100%}.int-tabs{flex-wrap:wrap}.leads-text{max-width:180px}}
/* Outreach tracker */
.ot-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap}
.ot-head-actions{display:flex;gap:8px;align-items:center}
.ot-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;border:1px solid hsl(var(--border));border-radius:12px;overflow:hidden;background:hsl(var(--border));margin:8px 0 20px}
.ot-stat{background:hsl(var(--card));padding:16px 18px;min-height:96px;display:flex;flex-direction:column}
