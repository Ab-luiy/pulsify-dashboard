.qv-done{border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card)/.6);padding:0 6px}
.qv-done summary{cursor:pointer;padding:10px 10px;font:500 13px Inter,system-ui;color:hsl(var(--muted-foreground));list-style:none;display:flex;gap:8px;align-items:baseline}
