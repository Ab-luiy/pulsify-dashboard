.qv-done[open] summary:before{content:"âˆ’"}
.qv-done-row{display:flex;gap:10px;align-items:center;padding:8px 10px;border-top:1px solid hsl(var(--border)/.6);font-size:13px}
.qv-done-row strong{font-weight:500}.qv-done-row small{color:hsl(var(--muted-foreground))}
/* Add to today */
.qv-chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:8px}
.qv-chip{display:flex;gap:10px;align-items:center;padding:10px 12px;border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));box-shadow:inset 0 0 0 1px #ffffff08;min-width:0}
.qv-chip-text{flex:1;min-width:0}.qv-chip-text strong{display:block;font:500 13.5px Inter,system-ui;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.qv-chip-text small{display:block;color:hsl(var(--muted-foreground));font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.qv-source{font-size:11px;color:hsl(var(--muted-foreground));white-space:nowrap}
.qv-chip .ps-control{flex:none}
.qv-manual{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;padding:16px;border:1px solid hsl(var(--border));border-radius:12px;background:hsl(var(--card));margin-top:8px;align-items:end}
.qv-manual .qv-wide{grid-column:span 2}
