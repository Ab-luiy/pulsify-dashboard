@media(max-width:1100px){.qv-follow{grid-template-columns:40px minmax(120px,1fr) minmax(0,1.6fr) auto}.qv-follow .qv-actions{grid-column:2/-1}.qv-manual{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){
 .qv-head{flex-direction:column}.qv-counters{width:100%;min-width:0}.qv-counter{padding:12px 14px;min-height:82px}.qv-counter b{font-size:22px}
 .qv-follow{grid-template-columns:36px minmax(0,1fr) auto;gap:10px 12px;padding:12px}.qv-follow .qv-avatar{width:36px;height:36px}
 .qv-follow .qv-last{grid-column:1/-1}.qv-follow>.int-pill,.qv-follow>.qv-pill-sk{grid-column:3;grid-row:1;justify-self:end;align-self:center}.qv-follow .qv-actions{grid-column:1/-1}.qv-follow .qv-actions .ps-control{flex:1 1 auto;justify-content:center}
 .qv-opener-row{grid-template-columns:36px minmax(0,1fr) auto 20px;gap:8px 10px;padding:12px}.qv-opener-row .qv-avatar{width:36px;height:36px}
 .qv-opener-row .qv-last{grid-column:1/-1}.qv-opener-row .qv-meta{grid-column:3;grid-row:1}.qv-opener-row .qv-chevron{grid-column:4;grid-row:1}
 .qv-detail{padding:12px}.qv-actions .ps-control{flex:1 1 40%;justify-content:center}.qv-actions span[style]{display:none}
 .qv-chips{grid-template-columns:1fr}.qv-chip{flex-wrap:wrap}.qv-chip .ps-control{margin-left:auto}
 .qv-manual{grid-template-columns:1fr;padding:12px}.qv-manual .qv-wide{grid-column:auto}
 .qv-keys{display:none}
}

