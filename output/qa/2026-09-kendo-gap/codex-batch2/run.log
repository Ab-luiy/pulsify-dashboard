.qv-counter.warn b{color:#e0b050}
.qv-sk-num{width:48px;min-height:26px;margin:10px 0 8px}
.qv-section{margin-top:26px}
.qv-section h2{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;font:600 13px Inter,system-ui!important;letter-spacing:.02em;margin:0 0 10px!important}
