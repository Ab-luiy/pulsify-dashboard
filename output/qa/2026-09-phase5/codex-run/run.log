  const b=await exportWorkspace(env,'frank');
  assert.equal(b.client,'frank');
  assert.ok(b.tables.client_config?.length===1);assert.ok(b.tables.client_brain?.length===1);assert.ok(b.tables.client_sessions?.length===1);
