// Outreach tracker: a contact book for Instagram DMs, separate from the CRM.
// Follow-ups due sit on top. Outbound (we opened) and Inbound (they opened)
// are separate sections. Each contact expands into the full chat history.
// Sending happens on the phone; this only tracks.
(() => {
  const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  let TZ = "Europe/Istanbul";
  // The founder's spec: minutes 1-59, then hours 1-24, then days.
  function ago(iso, now = Date.now()) {
    if (!iso) return "";
    const s = Math.max(0, Math.round((now - new Date(iso).getTime()) / 1000));
    if (s < 60) return "just now";
    const m = Math.floor(s / 60);
    if (m < 60) return `${m} minute${m === 1 ? "" : "s"} ago`;
    const h = Math.floor(m / 60);
    if (h <= 24) return `${h} hour${h === 1 ? "" : "s"} ago`;
    const d = Math.floor(h / 24);
    return `${d} day${d === 1 ? "" : "s"} ago`;
  }
  const stamp = (iso) => (iso ? new Intl.DateTimeFormat("en-GB", { timeZone: TZ, day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }).format(new Date(iso)) : "");
  const initials = (t) => (t.name || t.handle || "?").replace(/^@/, "").split(/[\s._-]+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join("") || "?";
  const avatar = (t) => t.pfp_url ? `<img class="ot-avatar" src="${esc(t.pfp_url)}" alt="" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'ot-avatar',textContent:'${esc(initials(t))}'}))">` : `<span class="ot-avatar">${esc(initials(t))}</span>`;
  const pct = (v) => (v === null || v === undefined ? "n/a" : `${v}%`);
  async function api(path, init) {
    const r = await fetch(path, { headers: { "content-type": "application/json", "x-pulsify-operator": "1" }, ...init });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || `HTTP ${r.status}`);
    return d;
  }
  const STAGE_CLASS = { replied: "ot-stage-replied", booked: "ot-stage-ok", closed: "ot-stage-ok", lost: "ot-stage-off", hibernating: "ot-stage-off" };

  function render(root) {
    let data = null, section = "outbound", q = "", open = new Set(), timer = null;
    root.innerHTML = `
      <div class="ot-head"><div><h1>Outreach tracker</h1><p class="ps-subtitle">Every Instagram conversation as a contact. Follow-ups due sit on top. Send from your phone; this keeps the score.</p></div>
      <div class="ot-head-actions"><input id="ot-q" class="leads-search" placeholder="Search name or handle" autocomplete="off"><button class="ps-control" id="ot-refresh">Refresh</button></div></div>
      <div id="ot-stats" class="ot-stats"><div class="skeleton" style="min-height:120px;grid-column:1/-1"></div></div>
      <div class="int-tabs ot-tabs"><button data-section="outbound" class="active">Outbound <span id="ot-n-out"></span></button><button data-section="inbound">Inbound <span id="ot-n-in"></span></button><button data-section="hibernating">Hibernating <span id="ot-n-hib"></span></button><button data-section="won">Booked and closed <span id="ot-n-won"></span></button><span style="flex:1"></span><small id="ot-updated" class="int-note"></small></div>
      <div id="ot-activity" class="ot-activity" hidden></div>
      <div id="ot-list" class="ot-list"><div class="skeleton" style="min-height:240px"></div></div>`;

    let disposed = false, sequence = 0;
    async function load() {
      if (disposed || !root.isConnected) return;
      const current = ++sequence;
      try {
        const fresh = await api(`/api/outreach${q ? `?q=${encodeURIComponent(q)}` : ""}`);
        if (disposed || current !== sequence) return;
        data = fresh;
        TZ = data.timezone || TZ;
        drawStats(); drawList(); drawActivity();
        const handoff = sessionStorage.getItem("pulsify:open-thread");
        if (handoff) { sessionStorage.removeItem("pulsify:open-thread"); const t = data.threads.find((x) => x.id === handoff); if (t) { section = bucket(t); root.querySelectorAll("[data-section]").forEach((x) => x.classList.toggle("active", x.dataset.section === section)); drawStats(); drawList(); if (!open.has(handoff)) toggle(handoff); root.querySelector(`#ot-${CSS.escape(handoff)}`)?.scrollIntoView({ block: "center" }); } }
        root.querySelector("#ot-updated").textContent = `${window.PulsifyRealtime?.status() === "live" ? "Live · " : ""}Updated ${stamp(data.generated_at)} (${TZ.split("/")[1]})`;
      } catch (e) {
        if (disposed || current !== sequence) return;
        root.querySelector("#ot-list").innerHTML = `<p class="int-empty">${esc(e.message)}</p>`;
      }
    }

    function drawStats() {
      const s = data.stats, o = s.outbound, i = s.inbound, p = s.pipeline;
      const cell = (label, value, note, cls = "") => `<div class="ot-stat ${cls}"><small>${esc(label)}</small><b>${esc(String(value))}</b>${note ? `<small>${esc(note)}</small>` : ""}</div>`;
      root.querySelector("#ot-stats").innerHTML = section === "inbound"
        ? cell("Inbound conversations", i.conversations, "They messaged first") + cell("Waiting on you", i.awaiting_us, "Their last message is unanswered", i.awaiting_us ? "ot-stat-warn" : "") + cell("Answered", i.answered, "You replied at least once") + cell("Positive", i.positive, "Marked by you") + cell("Negative", i.negative, "Marked by you") + cell("Appointments booked", p.appointments_booked, "All sections") + cell("Closed", p.closed, "All sections") + cell("Close rate", pct(p.close_rate), "Closed / booked")
        : cell("DMs sent", o.dms_sent, `${o.messages_sent} messages across them`) + cell("Follow-ups due", o.follow_ups_due, "24 h passed, no reply", o.follow_ups_due ? "ot-stat-warn" : "") + cell("Replies", o.replies, `${pct(o.reply_rate)} reply rate`) + cell("Positive / negative", `${o.positive} / ${o.negative}`, "Marked by you") + cell("Ghosted", o.ghosted, `${pct(o.ghost_rate)} ghost rate · 4 touches, silence`) + cell("Appointments booked", p.appointments_booked, "All sections") + cell("Close rate", pct(p.close_rate), "Closed / booked") + cell("Open rate", o.seen_available ? pct(o.open_rate) : "n/a", o.seen_available ? `${o.left_on_read} left on read` : "Needs Meta read receipts. Not available yet.", "ot-stat-muted");
    }

    function bucket(t) {
      if (t.outcome === "booked" || t.outcome === "closed") return "won";
      if (t.stage === "hibernating" || t.outcome === "lost") return "hibernating";
      return t.origin;
    }

    function drawList() {
      const all = data.threads;
      const counts = { outbound: 0, inbound: 0, hibernating: 0, won: 0 };
      for (const t of all) counts[bucket(t)] += 1;
      root.querySelector("#ot-n-out").textContent = counts.outbound; root.querySelector("#ot-n-in").textContent = counts.inbound; root.querySelector("#ot-n-hib").textContent = counts.hibernating; root.querySelector("#ot-n-won").textContent = counts.won;
      const list = all.filter((t) => bucket(t) === section);
      const due = list.filter((t) => t.follow_up_due), waiting = list.filter((t) => !t.follow_up_due && t.awaiting_us), rest = list.filter((t) => !t.follow_up_due && !t.awaiting_us);
      const group = (title, items, note) => items.length ? `<div class="ot-group"><h2>${esc(title)} <span>${items.length}</span>${note ? `<small>${esc(note)}</small>` : ""}</h2>${items.map(card).join("")}</div>` : "";
      const empty = { outbound: "No outbound conversations yet. Open a DM from your phone and it shows up here within a minute.", inbound: "Nobody has messaged you first yet.", hibernating: "Nobody is hibernating. Four touches with no reply, or a manual move, puts them here.", won: "No appointments or closes marked yet. Use the buttons on a contact." }[section];
      root.querySelector("#ot-list").innerHTML = list.length
        ? group("Follow ups", due, "24 hours have passed since your last message") + group("Waiting on you", waiting, "They spoke last") + group(section === "outbound" ? "Everyone else" : section === "inbound" ? "Answered" : section === "won" ? "Booked and closed" : "Hibernating", rest)
        : `<p class="int-empty">${esc(empty)}</p>`;
      root.querySelectorAll("[data-toggle]").forEach((b) => (b.onclick = () => toggle(b.dataset.toggle)));
      root.querySelectorAll("[data-act]").forEach((b) => (b.onclick = (e) => { e.stopPropagation(); act(b.dataset.id, b.dataset.act, b); }));
      root.querySelectorAll("[data-note]").forEach((f) => f.addEventListener("submit", (e) => { e.preventDefault(); act(f.dataset.note, "note", f.querySelector("button"), { text: f.querySelector("textarea").value }); }));
      for (const id of open) fillThread(id);
    }

    function card(t) {
      const stageCls = STAGE_CLASS[t.stage] || "";
      const timerLine = t.awaiting_us
        ? `They replied ${ago(t.last_their_message_at)}`
        : t.last_our_message_at
          ? `Your last message ${ago(t.last_our_message_at)}${t.follow_up_due ? ` · ${t.hours_since_our_message} hours have passed` : ""}`
          : "";
      return `<article class="ot-card ${t.follow_up_due ? "due" : ""} ${open.has(t.id) ? "open" : ""}" id="ot-${esc(t.id)}">
        <div class="ot-row" data-toggle="${esc(t.id)}">
          ${avatar(t)}
          <div class="ot-who"><strong>${esc(t.name)}</strong><small>${t.handle ? `@${esc(t.handle)}` : "handle syncing"} · ${t.origin === "outbound" ? "you opened" : "they opened"} ${ago(t.first_message_at)}</small></div>
          <div class="ot-last"><span>${esc(t.last_text || "(attachment)")}</span><small>${esc(timerLine)}</small></div>
          <div class="ot-meta"><span class="int-pill ${stageCls}">${esc(t.stage_label)}</span>${t.sentiment ? `<span class="int-pill ${t.sentiment === "positive" ? "int-pill-ok" : "int-pill-warn"}">${t.sentiment}</span>` : ""}${t.seen_at ? `<span class="int-pill">seen ${esc(ago(t.seen_at))}</span>` : ""}<small>${t.our_messages} sent · ${t.their_messages} received</small></div>
          <span class="ot-chevron">${open.has(t.id) ? "−" : "+"}</span>
        </div>
        <div class="ot-detail" ${open.has(t.id) ? "" : "hidden"}>
          <div class="ot-actions">
            <span class="ot-actions-label">Reply</span>
            <button class="ps-control ${t.sentiment === "positive" ? "active" : ""}" data-id="${esc(t.id)}" data-act="sentiment:${t.sentiment === "positive" ? "clear" : "positive"}">Positive</button>
            <button class="ps-control ${t.sentiment === "negative" ? "active" : ""}" data-id="${esc(t.id)}" data-act="sentiment:${t.sentiment === "negative" ? "clear" : "negative"}">Negative</button>
            <span class="ot-actions-label">Outcome</span>
            <button class="ps-control ${t.outcome === "booked" ? "active" : ""}" data-id="${esc(t.id)}" data-act="outcome:${t.outcome === "booked" ? "clear" : "booked"}">Booked</button>
            <button class="ps-control ${t.outcome === "closed" ? "active" : ""}" data-id="${esc(t.id)}" data-act="outcome:${t.outcome === "closed" ? "clear" : "closed"}">Closed</button>
            <button class="ps-control ${t.outcome === "lost" ? "active" : ""}" data-id="${esc(t.id)}" data-act="outcome:${t.outcome === "lost" ? "clear" : "lost"}">Lost</button>
            <span style="flex:1"></span>
            ${t.hibernated_at ? `<button class="ps-control" data-id="${esc(t.id)}" data-act="wake">Wake up</button>` : `<button class="ps-control" data-id="${esc(t.id)}" data-act="hibernate">Hibernate</button>`}
            ${t.handle ? `<a class="ps-control" href="https://instagram.com/${encodeURIComponent(t.handle)}" target="_blank" rel="noopener">Open on Instagram</a>` : ""}
          </div>
          <div class="ot-thread" data-thread="${esc(t.id)}"><div class="skeleton" style="min-height:80px"></div></div>
          <form class="ot-note" data-note="${esc(t.id)}"><textarea rows="2" placeholder="Note for yourself: what they do, what they said, next angle">${esc(t.notes)}</textarea><button class="ps-control" type="submit">Save note</button></form>
        </div>
      </article>`;
    }

    async function fillThread(id) {
      const box = root.querySelector(`[data-thread="${id}"]`);
      if (!box) return;
      try {
        const { messages } = await api(`/api/outreach?id=${encodeURIComponent(id)}`);
        box.innerHTML = `<div class="ot-messages">${messages.map((m) => `<div class="ot-msg ${m.direction}"><p>${esc(m.text || "(attachment)")}</p><small>${m.direction === "outbound" ? "You" : "Them"} · ${esc(ago(m.sent_at))} · ${esc(stamp(m.sent_at))}</small></div>`).join("") || '<p class="int-empty">No messages stored.</p>'}</div>`;
        box.querySelector(".ot-messages").scrollTop = 1e9;
      } catch (e) { box.innerHTML = `<p class="int-empty">${esc(e.message)}</p>`; }
    }

    function toggle(id) {
      if (open.has(id)) open.delete(id); else open.add(id);
      const el = root.querySelector(`#ot-${CSS.escape(id)}`);
      if (!el) return;
      el.classList.toggle("open", open.has(id));
      el.querySelector(".ot-detail").hidden = !open.has(id);
      el.querySelector(".ot-chevron").textContent = open.has(id) ? "−" : "+";
      if (open.has(id)) fillThread(id);
    }

    async function act(id, action, button, extra = {}) {
      button.disabled = true;
      try {
        const { thread } = await api("/api/outreach", { method: "POST", body: JSON.stringify({ id, action, ...extra }) });
        const idx = data.threads.findIndex((t) => t.id === id);
        if (idx >= 0) data.threads[idx] = thread;
        data.stats = null;
        data = await api(`/api/outreach${q ? `?q=${encodeURIComponent(q)}` : ""}`);
        drawStats(); drawList();
      } catch (e) { button.disabled = false; button.textContent = e.message.slice(0, 30); }
    }

    function drawActivity() {
      const box = root.querySelector("#ot-activity");
      const events = data.events || [];
      box.hidden = !events.length;
      if (!events.length) return;
      const kindLabel = { reply: "replied", seen: "seen, no reply after 5 min", booked: "booked", closed: "closed", hibernated: "hibernating" };
      box.innerHTML = `<strong>Recent</strong>${events.slice(0, 8).map((e) => `<span class="ot-event"><b>${esc(e.name || e.handle || "Lead")}${e.handle ? `, @${esc(e.handle)}` : ""}</b> ${esc(kindLabel[e.kind] || e.kind)}${e.text ? `: ${esc(e.text.slice(0, 60))}` : ""} <small>${esc(ago(e.created_at))}</small></span>`).join("")}`;
    }

    root.querySelectorAll("[data-section]").forEach((b) => (b.onclick = () => { root.querySelectorAll("[data-section]").forEach((x) => x.classList.toggle("active", x === b)); section = b.dataset.section; drawStats(); drawList(); }));
    let debounce;
    root.querySelector("#ot-q").addEventListener("input", (e) => { clearTimeout(debounce); debounce = setTimeout(() => { q = e.target.value.trim(); load(); }, 150); });
    root.querySelector("#ot-refresh").onclick = load;
    load();
    // Live push: any change to a thread reloads the list within a second; the
    // 60 s poll below stays as the fallback when the socket is down.
    let pending = null, unsubscribe, paint;
    if (window.PulsifyRealtime) {
      const live = root.querySelector("#ot-updated");
      paint = () => { const s = PulsifyRealtime.status(); live.dataset.live = s; live.title = s === "live" ? "Live updates on" : s === "error" ? "Live updates unavailable, polling" : "Connecting live updates"; };
      document.addEventListener("pulsify:realtime", paint);
      unsubscribe = PulsifyRealtime.on("tracker.changed", () => { clearTimeout(pending); pending = setTimeout(load, 400); });
      paint();
    }
    // Timers tick without a network call; data refreshes each minute while the view is on screen.
    timer = setInterval(() => { if (!root.isConnected) { dispose(); return; } if (document.visibilityState === "visible") load(); }, 300000);
    function dispose() { disposed = true; clearInterval(timer); clearTimeout(debounce); clearTimeout(pending); unsubscribe?.(); if (paint) document.removeEventListener("pulsify:realtime", paint); }
    return dispose;
  }

  window.PulsifyOutreachView = { render, ago };
})();
// Operator Leads view: people, not pipeline. Two sources on one page:
// the Instagram inbox (every thread, handle, who spoke last, in CRM or not)
// and funnel contacts across every client (applied, opted in, booked, paid).
// CRM stays the outbound working list; this is where inbound lands first.
(() => {
  const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const money = (cents, cur = "USD") => new Intl.NumberFormat("en-US", { style: "currency", currency: cur || "USD", maximumFractionDigits: 0 }).format((cents || 0) / 100);
  const ago = (iso) => {
    if (!iso) return "";
    const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
    if (s < 60) return "just now";
    if (s < 3600) return `${Math.floor(s / 60)} min ago`;
    if (s < 86400) return `${Math.floor(s / 3600)} h ago`;
    if (s < 86400 * 14) return `${Math.floor(s / 86400)} d ago`;
    return new Date(iso).toLocaleDateString();
  };
  async function api(path, init) {
    const r = await fetch(path, { headers: { "content-type": "application/json", "x-pulsify-operator": "1", ...(init?.headers || {}) }, ...init });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || `HTTP ${r.status}`);
    return d;
  }
  const pill = (label, cls) => `<span class="int-pill ${cls || ""}">${esc(label)}</span>`;

  function render(root, ctx = {}) {
    let tab = ctx.section === "funnel" ? "funnel" : "inbox";
    let q = "";
    let filter = "all"; // all | awaiting | new
    root.innerHTML = `
      <h1>Leads</h1>
      <p class="ps-subtitle">Everyone who has reached you. Instagram conversations first, funnel contacts across every client below. The CRM is where you work them; this is where they arrive.</p>
      <div class="int-table" id="leads-box">
        <div class="int-tabs">
          <button data-tab="inbox" class="active">Instagram inbox <span id="leads-n-inbox"></span></button>
          <button data-tab="funnel">Funnel contacts <span id="leads-n-funnel"></span></button>
          <span style="flex:1"></span>
          <input id="leads-q" placeholder="Search handle, name or email" class="leads-search" autocomplete="off">
          <button class="ps-control" id="leads-refresh">Refresh</button>
        </div>
        <div id="leads-filters" class="leads-filters">
          <button class="leads-chip active" data-filter="all">All</button>
          <button class="leads-chip" data-filter="awaiting">Waiting on you</button>
          <button class="leads-chip" data-filter="new">Not in CRM</button>
        </div>
        <div id="leads-body"><div class="skeleton" style="min-height:220px;border-radius:0"></div></div>
      </div>`;
    const body = root.querySelector("#leads-body");
    let cache = { inbox: null, funnel: null };

    let sequence = 0;
    async function load(force) {
      const current = ++sequence;
      if (force) cache = { inbox: null, funnel: null };
      body.innerHTML = '<div class="skeleton" style="min-height:220px;border-radius:0"></div>';
      try {
        if (tab === "inbox") {
          if (!cache.inbox) cache.inbox = (await api("/api/spine/conversations")).conversations || [];
          if (current !== sequence || !root.isConnected) return;
          drawInbox(cache.inbox);
        } else {
          if (!cache.funnel) cache.funnel = (await api("/api/pipeline")).contacts || [];
          if (current !== sequence || !root.isConnected) return;
          drawFunnel(cache.funnel);
        }
        root.querySelector("#leads-n-inbox").textContent = cache.inbox ? cache.inbox.length : "";
        root.querySelector("#leads-n-funnel").textContent = cache.funnel ? cache.funnel.length : "";
      } catch (e) {
        if (current !== sequence || !root.isConnected) return;
        body.innerHTML = `<p class="int-empty">${esc(e.message)}</p>`;
      }
    }

    function matches(text) { return !q || String(text || "").toLowerCase().includes(q); }

    function drawInbox(rows) {
      let list = rows.filter((c) => matches(`${c.participant_username} ${c.participant_name} ${c.last_text}`));
      if (filter === "awaiting") list = list.filter((c) => c.last_direction === "inbound");
      if (filter === "new") list = list.filter((c) => !c.in_crm);
      root.querySelector("#leads-filters").hidden = false;
      body.innerHTML = `<table><thead><tr><th>Person</th><th>Last message</th><th>Who spoke last</th><th>Status</th><th>When</th><th></th></tr></thead><tbody>${list.length ? list.map((c) => {
        const handle = c.participant_username ? `@${c.participant_username}` : (c.participant_name || "Unknown");
        const missing = !c.participant_username && !c.participant_id;
        return `<tr data-thread="${esc(c.id)}">
          <td><strong>${esc(handle)}</strong>${c.participant_name && c.participant_username ? `<small>${esc(c.participant_name)}</small>` : ""}${missing ? '<small class="int-note">Handle not synced yet</small>' : ""}</td>
          <td class="leads-text">${esc(c.last_text || "")}<small>${c.message_count} message${c.message_count === 1 ? "" : "s"}</small></td>
          <td>${c.last_direction === "inbound" ? pill("Them", "int-pill-warn") : pill("You", "")}</td>
          <td>${c.in_crm ? pill("In CRM", "int-pill-ok") : pill("Not in CRM", "")}</td>
          <td><small>${esc(ago(c.last_message_at))}</small></td>
          <td class="int-row-actions"><button class="ps-control" data-open="${esc(c.id)}">Open</button>${c.in_crm || missing ? "" : `<button class="ps-control int-primary" data-add="${esc(c.id)}">Add to CRM</button>`}</td>
        </tr>`;
      }).join("") : `<tr><td colspan="6" class="int-empty">${rows.length ? "Nothing matches." : "No conversations synced yet. The inbox job runs every minute once Instagram is connected."}</td></tr>`}</tbody></table>`;
      body.querySelectorAll("[data-open]").forEach((b) => (b.onclick = () => openThread(b.dataset.open)));
      body.querySelectorAll("[data-add]").forEach((b) => (b.onclick = () => addToCrm(rows.find((c) => c.id === b.dataset.add), b)));
    }

    function drawFunnel(rows) {
      const list = rows.filter((c) => matches(`${c.contact_email} ${c.contact_name} ${c.client_name}`));
      root.querySelector("#leads-filters").hidden = true;
      body.innerHTML = `<table><thead><tr><th>Contact</th><th>Client</th><th>Stage</th><th>Touches</th><th>Paid</th><th>Last seen</th></tr></thead><tbody>${list.length ? list.map((c) => `<tr>
          <td><strong>${esc(c.contact_name || c.contact_email)}</strong>${c.contact_name ? `<small>${esc(c.contact_email)}</small>` : ""}</td>
          <td>${esc(c.client_name || c.client_id)}</td>
          <td>${pill(c.stage, c.stage === "Paid" ? "int-pill-ok" : c.stage === "Booked" ? "int-pill-warn" : "")}</td>
          <td><small>${[["applied", c.applications], ["opted in", c.optins], ["booked", c.bookings], ["paid", c.payments]].filter(([, n]) => n > 0).map(([k, n]) => `${n} ${k}`).join(" · ")}</small></td>
          <td>${c.paid_cents ? money(c.paid_cents) : ""}</td>
          <td><small>${esc(ago(c.last_seen))}</small></td>
        </tr>`).join("") : `<tr><td colspan="6" class="int-empty">${rows.length ? "Nothing matches." : "No funnel contacts yet. Applications, opt-ins, bookings and payments land here as clients connect their funnels."}</td></tr>`}</tbody></table>`;
    }

    async function openThread(id) {
      const d = document.createElement("dialog");
      d.className = "ps-popover int-dialog leads-thread";
      d.innerHTML = '<div class="skeleton" style="min-height:200px"></div>';
      document.body.append(d);
      d.addEventListener("close", () => d.remove());
      d.showModal();
      try {
        const { conversation: c, messages } = await api(`/api/spine/conversations?id=${encodeURIComponent(id)}`);
        const handle = c.participant_username ? `@${c.participant_username}` : (c.participant_name || "Unknown");
        d.innerHTML = `<div class="leads-thread-head"><div><h2>${esc(handle)}</h2><small class="int-note">${messages.length} messages · first ${esc(ago(c.first_message_at))} · last ${esc(ago(c.last_message_at))}</small></div><div class="int-row-actions">${c.participant_username ? `<a class="ps-control" href="https://instagram.com/${encodeURIComponent(c.participant_username)}" target="_blank" rel="noopener">Open on Instagram</a>` : ""}<button class="ps-control" data-close>Close</button></div></div>
          <div class="leads-messages">${messages.map((m) => `<div class="leads-msg ${m.direction}"><p>${esc(m.text || "(attachment)")}</p><small>${m.direction === "outbound" ? "You" : esc(handle)} · ${esc(new Date(m.sent_at).toLocaleString())}</small></div>`).join("")}</div>
          <p class="int-note">Replying from here is not on yet. Open the thread on Instagram to answer.</p>`;
        d.querySelector("[data-close]").onclick = () => d.close();
        d.querySelector(".leads-messages").scrollTop = 1e9;
      } catch (e) {
        d.innerHTML = `<p class="int-empty">${esc(e.message)}</p><div class="int-actions"><button class="ps-control" data-close>Close</button></div>`;
        d.querySelector("[data-close]").onclick = () => d.close();
      }
    }

    async function addToCrm(c, button) {
      if (!c) return;
      button.disabled = true;
      const name = c.participant_username || c.participant_id;
      const ts = Date.now();
      try {
        // Same record shape the inbox job writes for outreach threads.
        await api("/api/crm-sync", { method: "POST", body: JSON.stringify({ added: { [name]: { n: c.participant_name || name, h: c.participant_username || name, niche: "", dms: c.message_count || 0, stage: "new-lead", src: "instagram", igConversationId: c.id, _ts: ts } } }) });
        c.in_crm = true;
        drawInbox(cache.inbox);
      } catch (e) {
        button.disabled = false;
        button.textContent = e.message.slice(0, 40);
      }
    }

    root.querySelectorAll("[data-tab]").forEach((t) => (t.onclick = () => { root.querySelectorAll("[data-tab]").forEach((x) => x.classList.toggle("active", x === t)); tab = t.dataset.tab; load(); }));
    root.querySelectorAll("[data-filter]").forEach((f) => (f.onclick = () => { root.querySelectorAll("[data-filter]").forEach((x) => x.classList.toggle("active", x === f)); filter = f.dataset.filter; load(); }));
    let debounce;
    root.querySelector("#leads-q").addEventListener("input", (e) => { clearTimeout(debounce); debounce = setTimeout(() => { q = e.target.value.trim().toLowerCase(); load(); }, 120); });
    root.querySelector("#leads-refresh").onclick = () => load(true);
    load();
  }

  window.PulsifyLeadsView = { render };
})();
// Semantic search across DMs and client brains. Ask in plain words
// ("who mentioned prop firm payouts", "clients selling to day traders"); the
// answer is the messages and brain fields that mean that, not just contain it.
// Ctrl+K anywhere in the console opens this view with the box focused.
(() => {
  const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const ago = (iso) => { if (!iso) return ""; const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000); if (s < 3600) return `${Math.max(1, Math.floor(s / 60))} min ago`; if (s < 86400) return `${Math.floor(s / 3600)} h ago`; return `${Math.floor(s / 86400)} d ago`; };
  async function api(path) {
    const r = await fetch(path, { headers: { "x-pulsify-operator": "1" } });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(d.error || `HTTP ${r.status}`);
    return d;
  }
  const EXAMPLES = ["who mentioned blowing an account", "anyone asking about pricing", "clients who sell to dropshippers", "people who said they would think about it", "offers built around a signal service"];

  function render(root, ctx = {}) {
    root.innerHTML = `
      <h1>Search</h1><p class="ps-subtitle">Ask in plain words. This finds what people meant across every DM and every client brain, not just the exact words.</p>
      <form class="sr-form" id="sr-form"><input id="sr-q" class="sr-input" placeholder="who mentioned prop firm payouts" autocomplete="off" autofocus><button class="ps-control int-primary" type="submit">Search</button></form>
      <div class="sr-filters"><label class="leads-chip active"><input type="checkbox" name="kind" value="dm" checked hidden>DMs</label><label class="leads-chip active"><input type="checkbox" name="kind" value="brain" checked hidden>Client brains</label><small id="sr-status" class="int-note"></small></div>
      <div class="sr-examples" id="sr-examples">${EXAMPLES.map((e) => `<button class="ps-control" data-example="${esc(e)}">${esc(e)}</button>`).join("")}</div>
      <div id="sr-results" class="sr-results"></div>`;
    const q = root.querySelector("#sr-q"), results = root.querySelector("#sr-results"), status = root.querySelector("#sr-status");
    root.querySelectorAll(".sr-filters label").forEach((l) => l.addEventListener("click", (e) => { e.preventDefault(); const c = l.querySelector("input"); c.checked = !c.checked; l.classList.toggle("active", c.checked); if (q.value.trim()) run(); }));
    root.querySelectorAll("[data-example]").forEach((b) => (b.onclick = () => { q.value = b.dataset.example; run(); }));
    root.querySelector("#sr-form").addEventListener("submit", (e) => { e.preventDefault(); run(); });
    api("/api/search?status=1").then((s) => {
      const dm = s.indexed?.dm?.count || 0, br = s.indexed?.brain?.count || 0;
      status.textContent = s.ready ? `${dm} of ${s.totals?.dms || 0} messages and ${br} of ${s.totals?.brain || 0} brain fields indexed${dm < (s.totals?.dms || 0) ? ", filling in" : ""}` : "Search index is not bound yet.";
    }).catch(() => {});
    if (ctx.q) { q.value = ctx.q; run(); }
    q.focus();

    let sequence = 0;
    async function run() {
      const current = ++sequence;
      const text = q.value.trim();
      if (text.length < 2) return;
      const kinds = [...root.querySelectorAll('input[name="kind"]:checked')].map((c) => c.value);
      results.innerHTML = '<div class="skeleton" style="min-height:160px;border-radius:12px"></div>';
      root.querySelector("#sr-examples").hidden = true;
      try {
        const d = await api(`/api/search?q=${encodeURIComponent(text)}&kinds=${kinds.join(",")}&limit=20`);
        if (current !== sequence || !root.isConnected) return;
        const dms = d.hits.filter((h) => h.kind === "dm"), brains = d.hits.filter((h) => h.kind === "brain");
        const group = (title, items, row) => items.length ? `<section class="sr-group"><h2>${esc(title)} <span>${items.length}</span></h2>${items.map(row).join("")}</section>` : "";
        results.innerHTML = d.hits.length
          ? group("Conversations", dms, (h) => `<button class="sr-hit" data-thread="${esc(h.conversation_id)}"><span class="ot-avatar">${esc((h.name || h.handle || "?").slice(0, 2).toUpperCase())}</span><div><strong>@${esc(h.handle || h.name)}</strong> <small>${h.direction === "outbound" ? "you wrote" : "they wrote"} · ${esc(ago(h.sent_at))} · match ${Math.round(h.score * 100)}%</small><p>${esc(h.snippet)}</p></div></button>`)
            + group("Client brains", brains, (h) => `<button class="sr-hit" data-brain="${esc(h.client_id)}"><span class="ot-avatar">${esc((h.client_name || "?").slice(0, 2).toUpperCase())}</span><div><strong>${esc(h.client_name)}</strong> <small>${esc(h.section)} · ${esc(String(h.field).replace(/_/g, " "))} · match ${Math.round(h.score * 100)}%</small><p>${esc(h.snippet)}</p></div></button>`)
            + `<p class="int-note">${d.hits.length} results in ${d.took_ms} ms</p>`
          : `<p class="int-empty">Nothing close to that yet. If the index is still filling in, try again in a minute.</p>`;
        results.querySelectorAll("[data-thread]").forEach((b) => (b.onclick = () => { sessionStorage.setItem("pulsify:open-thread", b.dataset.thread); window.PulsifyOperatorShell?.go("outreach"); }));
        results.querySelectorAll("[data-brain]").forEach((b) => (b.onclick = () => { sessionStorage.setItem("pulsify:brain-client", b.dataset.brain); window.PulsifyOperatorShell?.go("brain"); }));
      } catch (e) { if (current !== sequence || !root.isConnected) return; results.innerHTML = `<p class="int-empty">${esc(e.message)}</p>`; }
    }
  }

  // Ctrl+K / Cmd+K from anywhere in the console.
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") { e.preventDefault(); window.PulsifyOperatorShell?.go("search"); setTimeout(() => document.getElementById("sr-q")?.focus(), 150); }
  });

  window.PulsifySearchView = { render };
})();

