// Semantic search over what Pulsify knows: every Instagram DM and every client
// brain field. Embeddings from Workers AI (bge-base, 768 dims), vectors in
// Cloudflare Vectorize (index pulsify-search), bookkeeping in D1. No keys, no
// second database. The indexer runs from the Worker; the query runs from Pages.
import { nowIso, sha256Hex, str } from "./common.js";

export const EMBED_MODEL = "@cf/baai/bge-base-en-v1.5";
export const MAX_TEXT = 1500;        // characters per document
export const BATCH = 50;             // documents embedded per indexer run

// ---- documents ----
// Every document: { id, kind: "dm"|"brain", scope: "operator"|client id, text, meta }
// meta is what search results show without a second query, kept small.

// Vectorize ids are capped at 64 bytes; Instagram message ids run past 150.
// Documents get a hashed id and carry their source id in metadata.
export async function docId(prefix, source) {
  return `${prefix}:${(await sha256Hex(source)).slice(0, 48)}`;
}

export async function pendingDmDocs(env, limit = BATCH) {
  const rows = (await env.DB.prepare(
    `SELECT m.id, m.conversation_id, m.direction, m.sent_at, m.text,
            c.participant_username AS handle, c.participant_name AS name
       FROM ig_messages m JOIN ig_conversations c ON c.id=m.conversation_id
      WHERE m.text IS NOT NULL AND length(m.text)>=12
        AND NOT EXISTS (SELECT 1 FROM search_index_state s WHERE s.source_id=m.id)
      ORDER BY m.sent_at DESC LIMIT ?`,
  ).bind(limit).all()).results || [];
  const out = [];
  for (const r of rows) out.push(await dmDoc(await docId("dm", r.id), r));
  return out;
}

async function dmDoc(id, r) {
  return {
    id,
    source: r.id,
    kind: "dm",
    scope: "operator",
    text: `${r.direction === "outbound" ? "We wrote to" : "Message from"} @${r.handle || r.name || "unknown"}: ${str(r.text).slice(0, MAX_TEXT)}`,
    meta: { kind: "dm", message_id: r.id, conversation_id: r.conversation_id, handle: r.handle || "", name: r.name || "", direction: r.direction, sent_at: r.sent_at, snippet: str(r.text).slice(0, 180) },
  };
}

export async function pendingBrainDocs(env, limit = BATCH) {
  const rows = (await env.DB.prepare(
    `SELECT b.id, b.client_id, b.section, b.field, b.value_json, b.updated_at,
            (SELECT client_name FROM client_config c WHERE c.client=b.client_id) AS client_name
       FROM client_brain b
      WHERE length(b.value_json)>4 ORDER BY b.updated_at DESC LIMIT 500`,
  ).all()).results || [];
  const out = [];
  for (const r of rows) {
    let value = r.value_json;
    try { const parsed = JSON.parse(r.value_json); value = typeof parsed === "string" ? parsed : Array.isArray(parsed) ? parsed.map((v) => (typeof v === "string" ? v : JSON.stringify(v))).join("; ") : JSON.stringify(parsed); } catch { /* raw */ }
    value = str(value);
    if (value.length < 8) continue;
    const id = await docId("brain", `${r.client_id}:${r.section}:${r.field}`);
    const hash = await sha256Hex(value);
    const state = await env.DB.prepare("SELECT content_hash FROM search_index_state WHERE doc_id=?").bind(id).first();
    if (state?.content_hash === hash) continue;
    out.push({
      id, source: `${r.client_id}:${r.section}:${r.field}`, kind: "brain", scope: r.client_id, hash,
      text: `${r.client_name || r.client_id}, ${r.section} ${r.field.replace(/_/g, " ")}: ${value.slice(0, MAX_TEXT)}`,
      meta: { kind: "brain", client_id: r.client_id, client_name: r.client_name || r.client_id, section: r.section, field: r.field, updated_at: r.updated_at, snippet: value.slice(0, 180) },
    });
    if (out.length >= limit) break;
  }
  return out;
}

export async function embed(env, texts) {
  const result = await env.AI.run(EMBED_MODEL, { text: texts });
  return result?.data || [];
}

// One indexer pass: embed up to BATCH pending docs, upsert to Vectorize, record state.
export async function indexPending(env) {
  if (!env.AI || !env.VECTORIZE) return { indexed: 0, skipped: "no bindings" };
  const docs = [...(await pendingDmDocs(env, BATCH)), ...(await pendingBrainDocs(env, Math.max(5, BATCH / 5)))].slice(0, BATCH);
  if (!docs.length) return { indexed: 0 };
  const vectors = await embed(env, docs.map((d) => d.text));
  const upserts = [];
  const now = nowIso();
  for (let i = 0; i < docs.length; i += 1) {
    const values = vectors[i];
    if (!values || !values.length) continue;
    const d = docs[i];
    upserts.push({ id: d.id, values, metadata: { ...d.meta, scope: d.scope } });
  }
  if (upserts.length) await env.VECTORIZE.upsert(upserts);
  for (let i = 0; i < docs.length; i += 1) {
    const d = docs[i];
    if (!upserts.some(vector => vector.id === d.id)) continue;
    await env.DB.prepare(
      "INSERT INTO search_index_state (doc_id, kind, scope, content_hash, indexed_at, source_id) VALUES (?,?,?,?,?,?) ON CONFLICT(doc_id) DO UPDATE SET content_hash=excluded.content_hash, indexed_at=excluded.indexed_at, source_id=excluded.source_id",
    ).bind(d.id, d.kind, d.scope, d.hash || (await sha256Hex(d.text)), now, d.source).run();
  }
  return { indexed: upserts.length, remaining: docs.length >= BATCH };
}

// Query. scope "operator" sees everything; a client sees only its own brain
// (DMs belong to the operator account today).
export async function search(env, { q, scope = "operator", kinds = ["dm", "brain"], topK = 12 }) {
  const query = str(q).slice(0, 500);
  if (!query || !env.AI || !env.VECTORIZE) return [];
  const [vector] = await embed(env, [query]);
  if (!vector) return [];
  const filter = scope === "operator"
    ? { kind: kinds.length === 1 ? kinds[0] : { $in: kinds } }
    : { kind: "brain", scope };
  const res = await env.VECTORIZE.query(vector, { topK: Math.min(50, topK), filter, returnMetadata: "all" });
  return (res?.matches || []).map((m) => ({ id: m.id, score: Math.round(m.score * 1000) / 1000, ...(m.metadata || {}) }));
}
// Workspace archive. Archiving hides a workspace everywhere (lists, landing
// page, portal login) and freezes it; nothing is deleted. Every row that
// belongs to the workspace is exported first to R2 under
// archive/workspaces/<client>/<timestamp>.json so it can be inspected or
// restored later. Restore flips the status back; the export stays.
import { cleanId, nowIso, str } from "./common.js";

// Tables keyed by client, with the column that holds it. Discovered from the
// live schema at call time so new tables are never missed.
async function clientTables(env) {
  const rows = (await env.DB.prepare(
    "SELECT m.name AS tbl, p.name AS col FROM sqlite_master m JOIN pragma_table_info(m.name) p WHERE m.type='table' AND m.name NOT LIKE 'sqlite_%' AND m.name NOT LIKE '_cf%' AND p.name IN ('client_id','client') ORDER BY m.name",
  ).all()).results || [];
  const seen = new Map();
  for (const r of rows) if (!seen.has(r.tbl)) seen.set(r.tbl, r.col);
  return [...seen.entries()];
}

export async function exportWorkspace(env, clientId) {
  const client = cleanId(clientId);
  if (!client) throw new Error("valid client id required");
  const tables = await clientTables(env);
  const bundle = { client, exported_at: nowIso(), tables: {} };
  for (const [tbl, col] of tables) {
    try {
      const rows = (await env.DB.prepare(`SELECT * FROM ${tbl} WHERE ${col}=?`).bind(client).all()).results || [];
      if (rows.length) bundle.tables[tbl] = rows;
    } catch { /* a table without that column shape; skip */ }
  }
  bundle.row_count = Object.values(bundle.tables).reduce((n, rows) => n + rows.length, 0);
  return bundle;
}

export async function archiveWorkspace(env, clientId, actor = "operator") {
  const client = cleanId(clientId);
  const config = await env.DB.prepare("SELECT client, client_name, status FROM client_config WHERE client=?").bind(client).first();
  if (!config) return { ok: false, error: "unknown client" };
  if (config.status === "archived") return { ok: true, already: true, client };
  const bundle = await exportWorkspace(env, client);
  const stamp = nowIso().replace(/[:.]/g, "-");
  const key = `archive/workspaces/${client}/${stamp}.json`;
  if (env.MEDIA) await env.MEDIA.put(key, JSON.stringify(bundle, null, 2), { httpMetadata: { contentType: "application/json" } });
  await env.DB.prepare("UPDATE client_config SET status='archived', page_active=0, updated_at=? WHERE client=?").bind(nowIso(), client).run();
  // Any open client session or setup link for this workspace stops working.
  await env.DB.prepare("DELETE FROM client_sessions WHERE client_id=?").bind(client).run().catch(() => null);
  await env.DB.prepare("DELETE FROM client_setup_tokens WHERE client_id=?").bind(client).run().catch(() => null);
  await env.DB.prepare("INSERT INTO operator_events (actor, action, client, detail, created_at) VALUES (?,?,?,?,?)")
    .bind(str(actor), "workspace-archived", client, JSON.stringify({ export_key: key, rows: bundle.row_count, previous_status: config.status }), nowIso()).run().catch(() => null);
  return { ok: true, client, export_key: key, rows: bundle.row_count, bundle };
}

export async function restoreWorkspace(env, clientId, actor = "operator") {
  const client = cleanId(clientId);
  const config = await env.DB.prepare("SELECT client, status FROM client_config WHERE client=?").bind(client).first();
  if (!config) return { ok: false, error: "unknown client" };
  if (config.status !== "archived") return { ok: true, already: true, client };
  await env.DB.prepare("UPDATE client_config SET status='prospect', page_active=1, updated_at=? WHERE client=?").bind(nowIso(), client).run();
  await env.DB.prepare("INSERT INTO operator_events (actor, action, client, detail, created_at) VALUES (?,?,?,?,?)")
    .bind(str(actor), "workspace-restored", client, "{}", nowIso()).run().catch(() => null);
  return { ok: true, client };
}

export async function listArchives(env) {
  const rows = (await env.DB.prepare(
    "SELECT client, client_name, updated_at FROM client_config WHERE status='archived' ORDER BY updated_at DESC",
  ).all()).results || [];
  const out = [];
  for (const r of rows) {
    let exports = [];
    if (env.MEDIA) {
      const listed = await env.MEDIA.list({ prefix: `archive/workspaces/${r.client}/` }).catch(() => ({ objects: [] }));
      exports = (listed.objects || []).map((o) => ({ key: o.key, size: o.size, uploaded: o.uploaded })).sort((a, b) => String(b.key).localeCompare(String(a.key)));
    }
    out.push({ ...r, exports });
  }
  return out;
}
// Live push through Supabase Realtime, used as a signal channel only. Nothing
// sensitive travels here: payloads are opaque ids and kinds; browsers refetch
// details through Pulsify's own authenticated APIs. That is why the public
// (publishable) key is the only credential involved and it is set as a plain
// var, not a secret.
//   env.SUPABASE_URL      https://<ref>.supabase.co
//   env.SUPABASE_ANON_KEY sb_publishable_...
// Topics: "pulsify:operator" for the console, "pulsify:client:<id>" for a portal.
export function realtimeConfigured(env) {
  return Boolean(env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY);
}

export async function broadcast(env, topic, event, payload = {}, fetcher = fetch) {
  if (!realtimeConfigured(env)) return { ok: false, skipped: true };
  try {
    const r = await fetcher(`${String(env.SUPABASE_URL).replace(/\/$/, "")}/realtime/v1/api/broadcast`, {
      method: "POST",
      headers: { apikey: env.SUPABASE_ANON_KEY, authorization: `Bearer ${env.SUPABASE_ANON_KEY}`, "content-type": "application/json" },
      body: JSON.stringify({ messages: [{ topic, event, payload: { ...payload, at: new Date().toISOString() } }] }),
    });
    return { ok: r.status === 202 || r.ok, status: r.status };
  } catch (error) {
    return { ok: false, error: String(error?.message || error) };
  }
}

// Operator-side conveniences. Fire and forget; never let a push failure break the caller.
export const pushOperator = (env, event, payload) => broadcast(env, "pulsify:operator", event, payload).catch(() => ({ ok: false }));
export const pushClient = (env, clientId, event, payload) => broadcast(env, `pulsify:client:${clientId}`, event, payload).catch(() => ({ ok: false }));
// Zernio inbox: webhook handler (real time) plus a sweep (every minute, catches
// anything a webhook missed and pulls read receipts). Writes into the same
// ig_conversations / ig_messages / ig_outreach rows the tracker reads.
import { markSeen, refreshIdentity, resolveConversationId, storeMessage, zernioConfigured, zernioConnection, zernioFetch } from "../../../../functions/_shared/zernio.js";
import { nowIso, str } from "../../../../functions/_shared/common.js";
import { emitEvent } from "../../../../functions/_shared/outbound-webhooks.js";
import { notifyReply } from "./outreach-notify.js";
import { pushOperator } from "../../../../functions/_shared/realtime.js";

// Free plan allows 60 requests a minute; one list call plus one messages call
// per changed conversation keeps a sweep well inside that.
const MAX_CONVERSATIONS_PER_SWEEP = 15;
const LOCK_MINUTES = 4;

export async function zernioActive(env) {
  if (!zernioConfigured(env)) return false;
  const c = await zernioConnection(env).catch(() => ({ connected: false }));
  return Boolean(c.connected);
}

// ---- webhook ----
export async function handleZernioEvent(env, payload, eventId) {
  const operatorEmail = env.OPERATOR_EMAIL || "operator";
  const id = str(eventId || payload?.id);
  if (id) {
    const seen = await env.DB.prepare("SELECT id FROM zernio_events WHERE id=?").bind(id).first().catch(() => null);
    if (seen) return { ok: true, duplicate: true };
    await env.DB.prepare("INSERT OR IGNORE INTO zernio_events(id,event,received_at) VALUES(?,?,?)").bind(id, str(payload?.event), nowIso()).run().catch(() => null);
  }
  const event = str(payload?.event);
  const zc = payload?.conversation || {};
  const zm = payload?.message || {};
  if (!zc.id && !zm.conversationId) return { ok: true, ignored: event };
  const conversationId = await resolveConversationId(env, { ...zc, id: zc.id || zm.conversationId, accountId: payload?.account?.accountId || payload?.account?.id }, operatorEmail);
  await refreshIdentity(env, conversationId, zc);

  if (event === "message.received" || event === "message.sent") {
    const isNew = await storeMessage(env, conversationId, zm, operatorEmail);
    if (isNew && event === "message.received") {
      const row = await env.DB.prepare("SELECT participant_username AS handle, participant_name AS name FROM ig_conversations WHERE id=?").bind(conversationId).first();
      await notifyReply(env, { conversationId, handle: row?.handle || zc.participantUsername, name: row?.name || zc.participantName, text: zm.text, messageId: zm.platformMessageId || zm.id }).catch(() => null);
      await emitEvent(env, { scope: "operator", event: "conversation.new_message", data: { message_id: zm.platformMessageId || zm.id, conversation_id: conversationId, handle: row?.handle || "", name: row?.name || "", direction: "inbound", text: zm.text, ts: zm.sentAt, source: "instagram" } }).catch(() => null);
    }
    if (isNew) await pushOperator(env, "tracker.changed", { conversation_id: conversationId, reason: event === "message.received" ? "reply" : "sent" });
    return { ok: true, conversationId, stored: isNew };
  }
  if (event === "message.read") {
    const at = str(payload?.statusAt || payload?.timestamp) || nowIso();
    const changed = await markSeen(env, conversationId, new Date(at).toISOString());
    if (changed) await pushOperator(env, "tracker.changed", { conversation_id: conversationId, reason: "seen" });
    return { ok: true, conversationId, seen: changed };
  }
  if (event === "message.deleted") {
    const mid = str(zm.platformMessageId) || str(zm.id);
    await env.DB.prepare("UPDATE ig_messages SET text=COALESCE(text,'') || ' (unsent)' WHERE id=? AND text NOT LIKE '%(unsent)'").bind(mid).run().catch(() => null);
    return { ok: true, conversationId, deleted: mid };
  }
  return { ok: true, conversationId, ignored: event };
}

// ---- sweep ----
// Lists conversations newest first, pulls messages for any whose updatedTime
// moved since we last saw it. Read receipts ride on outgoing messages (readAt).
export async function syncZernioInbox(env, { fetcher = fetch } = {}) {
  if (!(await zernioActive(env))) return 0;
  // One sweep at a time: a long replay must not overlap the next cron minute.
  const running = await env.DB.prepare(
    "SELECT COUNT(*) AS n FROM sync_runs WHERE job='zernio-inbox' AND status='running' AND started_at>? AND started_at<?",
  ).bind(new Date(Date.now() - LOCK_MINUTES * 60000).toISOString(), new Date(Date.now() - 5000).toISOString()).first().catch(() => ({ n: 0 }));
  if (Number(running?.n || 0) > 0) return 0;
  const operatorEmail = env.OPERATOR_EMAIL || "operator";
  const known = new Map(((await env.DB.prepare("SELECT zernio_id, updated_time FROM zernio_conversation_map").all()).results || []).map((r) => [r.zernio_id, r.updated_time || ""]));
  let written = 0, processed = 0, cursor = "";
  for (let page = 0; page < 5 && processed < MAX_CONVERSATIONS_PER_SWEEP; page += 1) {
    const qs = new URLSearchParams({ platform: "instagram", limit: "100", sortOrder: "desc" });
    if (cursor) qs.set("cursor", cursor);
    const list = await zernioFetch(env, `/v1/inbox/conversations?${qs}`, {}, fetcher);
    const rows = list.data || [];
    // Unchanged conversations are skipped before any per-thread request is made.
    for (const zc of rows) {
      if (processed >= MAX_CONVERSATIONS_PER_SWEEP) break;
      const prior = known.get(String(zc.id));
      if (prior !== undefined && prior && String(zc.updatedTime || "") <= prior) continue;
      processed += 1;
      const conversationId = await resolveConversationId(env, zc, operatorEmail);
      await refreshIdentity(env, conversationId, zc);
      const msgs = await zernioFetch(env, `/v1/inbox/conversations/${encodeURIComponent(zc.id)}/messages?accountId=${encodeURIComponent(zc.accountId)}&limit=100&sortOrder=desc`, {}, fetcher).catch((error) => {
        if (String(error?.message || "").includes("429")) throw error; // stop the sweep, the next minute retries
        return { messages: [] };
      });
      let added = 0;
      for (const zm of (msgs.messages || []).slice().reverse()) {
        if (await storeMessage(env, conversationId, zm, operatorEmail)) added += 1;
      }
      written += added;
      if (added) await pushOperator(env, "tracker.changed", { conversation_id: conversationId, reason: "sync" });
      await env.DB.prepare("UPDATE zernio_conversation_map SET updated_time=?, synced_at=? WHERE zernio_id=?").bind(str(zc.updatedTime) || null, nowIso(), String(zc.id)).run();
    }
    if (!list.pagination?.hasMore || !list.pagination?.nextCursor) break;
    cursor = list.pagination.nextCursor;
  }
  return written;
}

