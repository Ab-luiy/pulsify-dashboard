+  gap: 2px;
+  margin-top: 12px;
+}
+
+.leaderboard-row {
+  display: grid;
+  grid-template-columns: 108px minmax(0, 1fr) 52px;
+  gap: 10px;
+  align-items: center;
+  padding: 7px 0;
+}
+
+.leaderboard-row > span {
+  overflow: hidden;
+  font-size: 11.5px;
+  font-weight: 700;
+  text-overflow: ellipsis;
+  text-transform: capitalize;
+  white-space: nowrap;
+}
+
+.leaderboard-row > strong {
+  font-size: 11px;
+  text-align: right;
+}
+
+.leaderboard-row.empty {
+  opacity: 0.48;
+}
+
+.leaderboard-track {
+  height: 8px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--ui-panel-2);
+}
+
+.leaderboard-track i {
+  display: block;
+  height: 100%;
+  border-radius: inherit;
+  background: linear-gradient(90deg, var(--ui-accent), var(--ui-accent-2));
+}
+
