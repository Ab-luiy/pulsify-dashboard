+  border: 1px solid color-mix(in srgb, var(--ui-accent) 30%, var(--ui-line));
+  border-radius: var(--ui-radius);
+  background: radial-gradient(100% 180% at 0 0, var(--ui-accent-soft), transparent 48%), var(--ui-panel);
