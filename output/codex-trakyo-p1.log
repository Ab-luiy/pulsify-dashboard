+/* Client portal: This week and Performance depth */
+.week-strip {
+  display: grid;
+  grid-template-columns: 1.35fr repeat(3, minmax(0, 1fr));
+  gap: 14px;
+  margin-bottom: 16px;
+}
+
+.week-strip > * {
+  min-width: 0;
+}
+
+.week-loading {
+  grid-column: 1 / -1;
+  padding: 28px;
+  border: 1px solid var(--ui-line);
+  border-radius: var(--ui-radius);
+  background: var(--ui-panel);
+  color: var(--ui-muted);
+  text-align: center;
+}
+
+.week-hero,
+.week-mini {
+  display: flex;
+  min-height: 150px;
+  flex-direction: column;
+  justify-content: center;
+  overflow: hidden;
+  border-radius: var(--ui-radius);
+}
+
+.week-hero {
+  position: relative;
