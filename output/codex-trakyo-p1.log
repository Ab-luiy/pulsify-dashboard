+}
+
+.home-count.success {
+  background: var(--ui-accent-soft);
+  color: var(--ui-accent);
+}
+
+.home-count.warning {
+  background: var(--ui-amber-soft);
+  color: var(--ui-amber);
+}
+
+.home-count.danger {
+  background: var(--ui-rose-soft);
+  color: var(--ui-rose);
+}
+
+.home-list {
+  display: grid;
+  padding: 5px 20px;
+}
+
+.home-list-item {
+  display: grid;
+  grid-template-columns: 28px minmax(0, 1fr);
+  gap: 10px;
+  align-items: center;
+  padding: 13px 0;
