+          <small>${payments.length
+            ? esc(`${weekPayments.length} payment${weekPayments.length === 1 ? "" : "s"} this week, ${currency(totalCash, currencyCode)} all time`)
+            : "Connect a payment rail to see revenue here."}</small>
+        </article>
+        ${renderWeekMetric(
