+          <span>${esc(label)}</span>
+          <strong class="mono">${value == null ? "Not logged" : esc(value)}</strong>
+          <small>${esc(detail)}</small>
+        </article>
+      `;
+    }
+
+    function renderHomeLists(currentWeekStart, nextWeekStart) {
