diff --git a/output/standard-preview/shared/pulsify-ui.css b/output/standard-preview/shared/pulsify-ui.css
index 09b4e9c7ce81ee7f28647ac4bde12542d979981a..688fc1e82f0a4ed6b638d5fa7648744d4a6be4d5
--- a/output/standard-preview/shared/pulsify-ui.css
