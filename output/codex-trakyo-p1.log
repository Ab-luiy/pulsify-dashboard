                    <input id="sequenceProfileVisitsInput" type="number" min="0" placeholder="Optional">
                  </label>
                </div>
                <label for="sequenceNotesInput">Notes
                  <textarea id="sequenceNotesInput" placeholder="What mattered here?"></textarea>
                </label>
