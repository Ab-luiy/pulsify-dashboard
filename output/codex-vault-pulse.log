function parseSections(rows) {
  const sections = { plans: null, todos: null, team: null, momentum: null };
  for (const row of rows) {
    if (!row?.section) continue;
    try {
      sections[row.section] = JSON.parse(row.json);
    } catch {
      sections[row.section] = null;
    }
  }
  return sections;
}


