CREATE TABLE IF NOT EXISTS studio_sequences (
  id            INTEGER PRIMARY KEY AUTOINCREMENT,
  client_id     TEXT NOT NULL,
  type          TEXT,
  intent        TEXT,
  topic         TEXT NOT NULL,
  goal          TEXT,
  trigger_word  TEXT,
  params_json   TEXT NOT NULL,
  output_json   TEXT,
  manual_prompt TEXT,
  status        TEXT NOT NULL DEFAULT 'draft',
