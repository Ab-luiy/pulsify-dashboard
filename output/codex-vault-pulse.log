+  ).bind(claim || null, id, client).run();
+  if (!Number(result?.meta?.changes || 0)) {
+    return json({ ok: false, error: "proof item not found" }, 404);
+  }
+
+  return json({ ok: true, client, proof_item: { id, claim } });
+}
