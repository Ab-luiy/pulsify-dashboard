+  align-content: center;
+  padding: 20px;
+  border-left: 1px solid var(--ui-line);
+  background: var(--ui-panel-2);
+}
+
+.studio-stat span,
+.studio-stat strong,
+.studio-stat small {
+  display: block;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.studio-stat span {
+  color: var(--ui-muted);
+  font-size: 9.5px;
+  font-weight: 800;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.studio-stat strong {
