  color: var(--ui-ink-2);
  font-size: 12.5px;
  line-height: 1.55;
}

.home-list-grid,
.performance-insight-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.home-list-card {
  overflow: hidden;
}

.home-count {
  display: inline-flex;
  max-width: min(48vw, 260px);
