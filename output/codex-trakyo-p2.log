  place-items: center;
  border-radius: 13px;
  background: linear-gradient(135deg, var(--ui-accent), var(--ui-accent-2));
  color: #042b1b;
  font-family: var(--ui-font-mono);
  font-size: 18px;
  font-weight: 900;
}

.next-move h3 {
  margin: 0;
  font-size: 16px;
  letter-spacing: -0.02em;
}

.next-move p {
