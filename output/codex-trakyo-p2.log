}

.leaderboard-row {
  display: grid;
  grid-template-columns: 108px minmax(0, 1fr) 52px;
  gap: 10px;
  align-items: center;
  padding: 7px 0;
}

.leaderboard-row > span {
  overflow: hidden;
  font-size: 11.5px;
  font-weight: 700;
  text-overflow: ellipsis;
  text-transform: capitalize;
  white-space: nowrap;
}

.leaderboard-row > strong {
  font-size: 11px;
  text-align: right;
}

.leaderboard-row.empty {
  opacity: 0.48;
}

.leaderboard-track {
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: var(--ui-panel-2);
}

.leaderboard-track i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--ui-accent), var(--ui-accent-2));
}

@media (max-width: 1120px) {
  .week-strip,
  .performance-kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 820px) {
  .week-strip,
  .performance-kpi-grid,
  .home-list-grid,
  .performance-insight-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .next-move {
    grid-template-columns: minmax(0, 1fr);
  }

  .next-move-icon {
    display: none;
  }

  .next-move button,
  .home-actions button,
  .performance-head-actions button {
    width: 100%;
  }

  .home-actions,
  .performance-head-actions {
    width: 100%;
  }
}

@media (max-width: 420px) {
  .week-hero,
  .week-mini,
  .next-move,
  .retention-card,
  .leaderboard-card {
    padding: 16px;
  }

  .performance-card-heading,
  .curve-note {
    align-items: flex-start;
    flex-direction: column;
  }

  .leaderboard-row {
    grid-template-columns: 90px minmax(0, 1fr) 45px;
    gap: 7px;
  }
}

