      .rail-actions { grid-template-columns: 1fr 1fr; }
      main { padding: 24px 16px 60px; }
      .metric-grid,
      .two-col,
      .field-grid.two,
      .type-grid,
      .sequence-summary,
      .mode-grid,
      .translate,
      .angle-lib,
      .capture-in { grid-template-columns: 1fr; }
      .pulse-item { grid-template-columns: 38px minmax(0, 1fr); }
      .pulse-time { grid-column: 2; }
    }
    @media (max-width: 390px) {
      .rail-actions { grid-template-columns: 1fr; }
      main { padding-inline: 12px; }
      .message,
      .list-card,
      .todo-card,
      .studio-card,
      .history-card,
      .review-card,
      .manual-card,
      .performance-card,
      .card,
      .metric,
      .empty-card,
      .pending-card { padding-left: 16px; padding-right: 16px; }
    }
  </style>
</head>
