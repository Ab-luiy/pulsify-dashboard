+  letter-spacing: 0.09em;
+  text-transform: uppercase;
+}
+
+.studio-insight-lines {
+  display: grid;
+  gap: 10px;
+  margin-top: 13px;
+}
+
+.studio-insight-line {
+  display: grid;
+  grid-template-columns: 24px minmax(0, 1fr);
+  gap: 9px;
+  align-items: start;
+}
+
+.studio-insight-line p {
+  margin: 1px 0 0;
+  color: var(--ui-ink-2);
+  font-size: 12.5px;
+  line-height: 1.55;
+}
+
+.insight-mark {
