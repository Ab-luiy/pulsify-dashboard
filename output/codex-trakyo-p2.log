+    function parseMoneyToCents(value) {
+      if (value && typeof value === "object" && !Array.isArray(value)) {
+        if (Number.isFinite(Number(value.amount_cents)) && Number(value.amount_cents) > 0) return Math.round(Number(value.amount_cents));
