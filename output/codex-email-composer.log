diff --git a/output/standard-preview/functions/api/email-compose.js b/output/standard-preview/functions/api/email-compose.js
new file mode 100644
index 0000000000000000000000000000000000000000..342eccfca60e7361dfca611e039c429503d458ad
--- /dev/null
+++ b/output/standard-preview/functions/api/email-compose.js
@@ -0,0 +1,290 @@
+import { checkAdmin, cleanId, escapeHtml, json, nowIso, str, strOrNull } from "../_shared/common.js";
+import { getIntegration, recordFailure, recordIntegrationEvent } from "../_shared/integrations.js";
+
+const KIT_TAGS_URL = "https://api.kit.com/v4/tags";
+const KIT_BROADCASTS_URL = "https://api.kit.com/v4/broadcasts";
+const FAILURE_KIND = "kit_email_compose";
+
+export async function onRequestGet({ request, env }) {
+  const auth = checkAdmin(request, env);
+  if (auth) return auth;
+  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);
+
+  const url = new URL(request.url);
+  const action = str(url.searchParams.get("action") || "drafts").toLowerCase();
+  if (action === "drafts") return listDrafts(env, url.searchParams.get("client"));
+  if (action !== "tags") return json({ ok: false, error: "unknown action" }, 422);
+
+  const kit = await getIntegration(env, "operator", "", "kit");
+  const apiKey = kit?.secrets?.api_key;
+  if (!apiKey) {
+    return json({
+      ok: true,
+      configured: false,
+      api_key_set: false,
+      tags: [],
+      message: "Connect the operator Kit account in Integrations to load tags and send email.",
+    });
+  }
+
+  try {
+    const response = await fetch(`${KIT_TAGS_URL}?per_page=100`, {
+      headers: { "X-Kit-Api-Key": apiKey },
+    });
+    const data = await response.json().catch(() => ({}));
+    if (!response.ok) {
+      return json({
+        ok: false,
+        configured: true,
+        api_key_set: true,
+        tags: [],
+        error: `Kit tags request failed with status ${response.status}.`,
+      }, 502);
+    }
+
+    const tags = Array.isArray(data.tags)
+      ? data.tags.map((tag) => ({ id: String(tag.id), name: str(tag.name) || `Tag ${tag.id}` }))
+      : [];
+    return json({ ok: true, configured: true, api_key_set: true, tags });
+  } catch (error) {
+    return json({
+      ok: false,
+      configured: true,
+      api_key_set: true,
+      tags: [],
+      error: `Kit tags request failed: ${error?.message || error}`,
+    }, 502);
+  }
+}
+
+export async function onRequestPost({ request, env }) {
+  const auth = checkAdmin(request, env);
+  if (auth) return auth;
+  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);
+
+  const url = new URL(request.url);
+  const body = await request.json().catch(() => ({}));
+  const action = str(url.searchParams.get("action") || body.action).toLowerCase();
+  if (action !== "draft" && action !== "send") {
+    return json({ ok: false, error: "action must be draft or send" }, 422);
+  }
+
+  const input = normalizeDraftInput(body);
+  if (!input.subject) return json({ ok: false, error: "subject is required" }, 422);
+  if (!input.body) return json({ ok: false, error: "body_html or body_text is required" }, 422);
+  if (action === "send" && !input.tag_id) {
+    return json({ ok: false, error: "tag_id is required to send" }, 422);
+  }
+
+  if (action === "draft") {
+    const draft = await saveDraft(env, input, "draft", null);
+    return json({ ok: true, sent: false, status: "draft", draft });
+  }
+
+  const kit = await getIntegration(env, "operator", "", "kit");
+  const apiKey = kit?.secrets?.api_key;
+  if (!apiKey) {
+    const draft = await saveDraft(env, input, "draft", null);
+    await recordFailure(
+      env,
+      input.client,
+      FAILURE_KIND,
+      "operator Kit integration not configured; email saved as draft",
+      { skipDiscord: true },
+    );
+    return json({
+      ok: true,
+      sent: false,
+      configured: false,
+      api_key_set: false,
+      status: "draft",
+      message: "Kit is not connected. The email was saved as a draft for copy and paste.",
+      draft,
+    });
+  }
+
+  const pendingDraft = await saveDraft(env, input, "draft", null);
+  try {
+    const sendAt = new Date(Date.now() + 60 * 1000).toISOString();
+    const response = await fetch(KIT_BROADCASTS_URL, {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        "X-Kit-Api-Key": apiKey,
+      },
+      // Kit creates the broadcast now and schedules it one minute ahead for the selected tag only.
+      body: JSON.stringify(buildBroadcast(input, kit, sendAt)),
+    });
+    const data = await response.json().catch(() => ({}));
+    const broadcastId = data?.broadcast?.id;
+    if (!response.ok || !broadcastId) {
+      const detail = `broadcast_${response.status}: ${summarize(data)}`;
+      const draft = await updateDraftStatus(env, pendingDraft, "failed", null);
+      await recordFailure(env, input.client, FAILURE_KIND, detail, { skipDiscord: true });
+      return json({
+        ok: false,
+        sent: false,
+        configured: true,
+        api_key_set: true,
+        status: "failed",
+        error: "Kit rejected the broadcast. The email is stored below for copy and paste.",
+        draft,
+      }, 502);
+    }
+
+    const sentAt = nowIso();
+    const draft = await updateDraftStatus(env, pendingDraft, "sent", sentAt);
+    await recordIntegrationEvent(env, {
+      provider: "kit",
+      kind: "operator_email",
+      client: input.client,
+      externalId: String(broadcastId),
+      payloadSummary: {
+        subject: input.subject,
+        tag_id: input.tag_id,
+        send_at: sendAt,
+      },
+    }).catch((error) => recordFailure(
+      env,
+      input.client,
+      "kit_email_event",
+      `broadcast ${broadcastId} sent but event logging failed: ${error?.message || error}`,
+      { skipDiscord: true },
+    ));
+    return json({
+      ok: true,
+      sent: true,
+      configured: true,
+      api_key_set: true,
+      status: "sent",
+      broadcast_id: broadcastId,
+      send_at: sendAt,
+      draft,
+    });
+  } catch (error) {
+    const detail = `network_error: ${error?.message || error}`;
+    const draft = await updateDraftStatus(env, pendingDraft, "failed", null);
+    await recordFailure(env, input.client, FAILURE_KIND, detail, { skipDiscord: true });
+    return json({
+      ok: false,
+      sent: false,
+      configured: true,
+      api_key_set: true,
+      status: "failed",
+      error: "Kit could not be reached. The email is stored below for copy and paste.",
+      draft,
+    }, 502);
+  }
+}
+
+export async function onRequestOptions() {
+  return new Response(null, {
+    status: 204,
+    headers: {
+      "access-control-allow-origin": "*",
+      "access-control-allow-methods": "GET, POST, OPTIONS",
+      "access-control-allow-headers": "content-type, x-admin-key",
+      "access-control-max-age": "86400",
+    },
+  });
+}
+
+async function listDrafts(env, clientValue) {
+  const client = cleanId(clientValue);
+  const statement = client
+    ? env.DB.prepare(
+      `SELECT id, client, subject, body, tag_id, status, created_at, sent_at
+         FROM email_drafts WHERE client=? ORDER BY created_at DESC, id DESC LIMIT 30`,
+    ).bind(client)
+    : env.DB.prepare(
+      `SELECT id, client, subject, body, tag_id, status, created_at, sent_at
+         FROM email_drafts ORDER BY created_at DESC, id DESC LIMIT 30`,
+    );
+  const result = await statement.all();
+  return json({ ok: true, drafts: result.results || [] });
+}
+
+function normalizeDraftInput(body) {
+  const bodyHtml = str(body.body_html);
+  const bodyText = str(body.body_text);
+  return {
+    client: cleanId(body.client, "operator"),
+    subject: str(body.subject).slice(0, 240),
+    body: bodyHtml || bodyText,
+    body_html: bodyHtml || textToHtml(bodyText),
+    body_text: bodyText || null,
+    tag_id: strOrNull(body.tag_id),
+  };
+}
+
+function textToHtml(value) {
+  return String(value || "")
+    .split(/\n{2,}/)
+    .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, "<br>")}</p>`)
+    .join("");
+}
+
+function buildBroadcast(input, kit, sendAt) {
+  return {
+    content: input.body_html,
+    description: `Pulsify operator email for ${input.client}`,
+    public: false,
+    published_at: nowIso(),
+    subject: input.subject,
+    send_at: sendAt,
+    email_template_id: kit?.config?.email_template_id
+      ? Number(kit.config.email_template_id)
+      : undefined,
+    email_address: kit?.config?.onboarding_sender_email || null,
+    subscriber_filter: [
+      {
+        all: [{ type: "tag", ids: [input.tag_id] }],
+        any: null,
+        none: null,
+      },
+    ],
+  };
+}
+
+async function saveDraft(env, input, status, sentAt) {
+  const createdAt = nowIso();
+  const result = await env.DB.prepare(
+    `INSERT INTO email_drafts (client, subject, body, tag_id, status, created_at, sent_at)
+     VALUES (?,?,?,?,?,?,?)`,
+  ).bind(
+    input.client,
+    input.subject,
+    input.body,
+    input.tag_id,
+    status,
+    createdAt,
+    sentAt,
+  ).run();
+  return {
+    id: result.meta?.last_row_id ?? null,
+    client: input.client,
+    subject: input.subject,
+    body: input.body,
+    body_html: input.body_html,
+    body_text: input.body_text,
+    tag_id: input.tag_id,
+    status,
+    created_at: createdAt,
+    sent_at: sentAt,
+  };
+}
+
+async function updateDraftStatus(env, draft, status, sentAt) {
+  await env.DB.prepare(
+    "UPDATE email_drafts SET status=?, sent_at=? WHERE id=?",
+  ).bind(status, sentAt, draft.id).run();
+  return { ...draft, status, sent_at: sentAt };
+}
+
+function summarize(value) {
+  try {
+    return JSON.stringify(value).slice(0, 300);
+  } catch {
+    return String(value || "").slice(0, 300);
+  }
+}
diff --git a/output/standard-preview/migrations/0017_email_drafts.sql b/output/standard-preview/migrations/0017_email_drafts.sql
new file mode 100644
index 0000000000000000000000000000000000000000..6cb83453b481f63ce1ad66a2bef52ae0a68ceed2
--- /dev/null
+++ b/output/standard-preview/migrations/0017_email_drafts.sql
@@ -0,0 +1,18 @@
+-- Operator email composer drafts and Kit delivery outcomes.
+
+CREATE TABLE IF NOT EXISTS email_drafts (
+  id         INTEGER PRIMARY KEY AUTOINCREMENT,
+  client     TEXT NOT NULL,
+  subject    TEXT NOT NULL,
+  body       TEXT NOT NULL,
+  tag_id     TEXT,
+  status     TEXT NOT NULL CHECK (status IN ('draft', 'sent', 'failed')),
+  created_at TEXT NOT NULL,
+  sent_at    TEXT
+);
+
+CREATE INDEX IF NOT EXISTS idx_email_drafts_created_at
+  ON email_drafts (created_at DESC);
+
+CREATE INDEX IF NOT EXISTS idx_email_drafts_client_created_at
+  ON email_drafts (client, created_at DESC);
diff --git a/output/standard-preview/tests/email-compose.test.mjs b/output/standard-preview/tests/email-compose.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..9a012301ccd59aa6b7565d9bded400708dd5bb26
--- /dev/null
+++ b/output/standard-preview/tests/email-compose.test.mjs
@@ -0,0 +1,304 @@
+import { strict as assert } from "node:assert";
+import * as emailApi from "../functions/api/email-compose.js";
+
+class MockDB {
+  constructor({ apiKey = null } = {}) {
+    this.state = {
+      integrations: apiKey ? [{
+        scope: "operator",
+        client_id: "",
+        provider: "kit",
+        config_json: JSON.stringify({ onboarding_sender_email: "sender@example.com" }),
+        secret_json: JSON.stringify({ api_key: apiKey }),
+        created_at: "2026-07-16T00:00:00.000Z",
+        updated_at: "2026-07-16T00:00:00.000Z",
+      }] : [],
+      integration_events: [],
+      email_drafts: [],
+      delivery_failures: [],
+    };
+  }
+
+  prepare(sql) {
+    return new MockStatement(this, sql);
+  }
+}
+
+class MockStatement {
+  constructor(db, sql) {
+    this.db = db;
+    this.sql = sql.replace(/\s+/g, " ").trim();
+    this.params = [];
+  }
+
+  bind(...params) {
+    this.params = params;
+    return this;
+  }
+
+  async all() {
+    const { state } = this.db;
+    if (this.sql.includes("FROM integrations")) {
+      let rows = [...state.integrations];
+      let index = 0;
+      if (this.sql.includes("scope=?")) rows = rows.filter((row) => row.scope === this.params[index++]);
+      if (this.sql.includes("COALESCE(client_id,'')=?")) {
+        rows = rows.filter((row) => (row.client_id || "") === this.params[index++]);
+      }
+      if (this.sql.includes("provider=?")) rows = rows.filter((row) => row.provider === this.params[index]);
+      return { results: rows };
+    }
+    if (this.sql.includes("MAX(ts) AS last_event_ts") && this.sql.includes("FROM integration_events")) {
+      return { results: [] };
+    }
+    if (this.sql.includes("FROM email_drafts")) {
+      let rows = [...state.email_drafts];
+      if (this.sql.includes("WHERE client=?")) rows = rows.filter((row) => row.client === this.params[0]);
+      rows.sort((a, b) => b.id - a.id);
+      return { results: rows.slice(0, 30) };
+    }
+    throw new Error(`Unexpected all query: ${this.sql}`);
+  }
+
+  async run() {
+    const { state } = this.db;
+    if (this.sql.startsWith("INSERT INTO email_drafts")) {
+      const [client, subject, body, tagId, status, createdAt, sentAt] = this.params;
+      const id = state.email_drafts.length + 1;
+      state.email_drafts.push({
+        id,
+        client,
+        subject,
+        body,
+        tag_id: tagId,
+        status,
+        created_at: createdAt,
+        sent_at: sentAt,
+      });
+      return { meta: { changes: 1, last_row_id: id } };
+    }
+    if (this.sql.startsWith("UPDATE email_drafts SET status=?")) {
+      const [status, sentAt, id] = this.params;
+      const row = state.email_drafts.find((item) => item.id === id);
+      if (!row) return { meta: { changes: 0 } };
+      row.status = status;
+      row.sent_at = sentAt;
+      return { meta: { changes: 1 } };
+    }
+    if (this.sql.startsWith("INSERT INTO delivery_failures")) {
+      const [client, kind, detail, at] = this.params;
+      state.delivery_failures.push({ client, kind, detail, at });
+      return { meta: { changes: 1 } };
+    }
+    if (this.sql.startsWith("INSERT INTO integration_events")) {
+      const [provider, kind, client, externalId, payloadSummaryJson, ts] = this.params;
+      state.integration_events.push({
+        provider,
+        kind,
+        client,
+        external_id: externalId,
+        payload_summary_json: payloadSummaryJson,
+        ts,
+      });
+      return { meta: { changes: 1, last_row_id: state.integration_events.length } };
+    }
+    throw new Error(`Unexpected run query: ${this.sql}`);
+  }
+}
+
+function env(options = {}) {
+  return { ADMIN_KEY: "secret", DB: new MockDB(options) };
+}
+
+function getRequest(action, key = "secret") {
+  return new Request(`https://funnels.test/api/email-compose?action=${action}`, {
+    headers: key ? { "x-admin-key": key } : {},
+  });
+}
+
+function postRequest(action, body, key = "secret") {
+  return new Request(`https://funnels.test/api/email-compose?action=${action}`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      ...(key ? { "x-admin-key": key } : {}),
+    },
+    body: JSON.stringify(body),
+  });
+}
+
+const composed = {
+  client: "alpha",
+  subject: "Alpha weekly note",
+  body_text: "Line one\n\nLine two",
+  tag_id: "42",
+};
+
+async function testAuthEveryAction() {
+  const testEnv = env({ apiKey: "kit-secret" });
+  const calls = [
+    emailApi.onRequestGet({ request: getRequest("tags", "wrong"), env: testEnv }),
+    emailApi.onRequestGet({ request: getRequest("drafts", "wrong"), env: testEnv }),
+    emailApi.onRequestPost({ request: postRequest("draft", composed, "wrong"), env: testEnv }),
+    emailApi.onRequestPost({ request: postRequest("send", composed, "wrong"), env: testEnv }),
+  ];
+  for (const call of calls) assert.equal((await call).status, 401);
+}
+
+async function testTagsWithoutKey() {
+  const testEnv = env();
+  let fetchCalled = false;
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async () => {
+    fetchCalled = true;
+    throw new Error("fetch should not run");
+  };
+  try {
+    const response = await emailApi.onRequestGet({ request: getRequest("tags"), env: testEnv });
+    const data = await response.json();
+    assert.equal(response.status, 200);
+    assert.equal(data.configured, false);
+    assert.equal(data.api_key_set, false);
+    assert.deepEqual(data.tags, []);
+    assert.match(data.message, /Connect the operator Kit account/);
+    assert.equal(fetchCalled, false);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+async function testTagsWithKey() {
+  const testEnv = env({ apiKey: "kit-secret" });
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async (url, options) => {
+    assert.equal(String(url), "https://api.kit.com/v4/tags?per_page=100");
+    assert.equal(options.headers["X-Kit-Api-Key"], "kit-secret");
+    return new Response(JSON.stringify({ tags: [{ id: 42, name: "Clients" }] }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  };
+  try {
+    const response = await emailApi.onRequestGet({ request: getRequest("tags"), env: testEnv });
+    const data = await response.json();
+    assert.equal(data.configured, true);
+    assert.equal(data.api_key_set, true);
+    assert.deepEqual(data.tags, [{ id: "42", name: "Clients" }]);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+async function testDraftActionAndList() {
+  const testEnv = env();
+  const response = await emailApi.onRequestPost({
+    request: postRequest("draft", { ...composed, tag_id: null }),
+    env: testEnv,
+  });
+  const data = await response.json();
+  assert.equal(response.status, 200);
+  assert.equal(data.status, "draft");
+  assert.equal(data.draft.status, "draft");
+  assert.equal(testEnv.DB.state.email_drafts.length, 1);
+
+  const listResponse = await emailApi.onRequestGet({ request: getRequest("drafts"), env: testEnv });
+  const list = await listResponse.json();
+  assert.equal(list.drafts.length, 1);
+  assert.equal(list.drafts[0].subject, composed.subject);
+}
+
+async function testSendSuccess() {
+  const testEnv = env({ apiKey: "kit-secret" });
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async (url, options) => {
+    assert.equal(testEnv.DB.state.email_drafts[0]?.status, "draft", "email must be stored before Kit is called");
+    assert.equal(String(url), "https://api.kit.com/v4/broadcasts");
+    assert.equal(options.method, "POST");
+    assert.equal(options.headers["X-Kit-Api-Key"], "kit-secret");
+    const payload = JSON.parse(options.body);
+    assert.equal(payload.subject, composed.subject);
+    assert.equal(payload.content, "<p>Line one</p><p>Line two</p>");
+    assert.deepEqual(payload.subscriber_filter[0].all, [{ type: "tag", ids: ["42"] }]);
+    return new Response(JSON.stringify({ broadcast: { id: 701 } }), {
+      status: 201,
+      headers: { "content-type": "application/json" },
+    });
+  };
+  try {
+    const response = await emailApi.onRequestPost({ request: postRequest("send", composed), env: testEnv });
+    const data = await response.json();
+    assert.equal(response.status, 200);
+    assert.equal(data.sent, true);
+    assert.equal(data.status, "sent");
+    assert.equal(data.broadcast_id, 701);
+    assert.equal(testEnv.DB.state.email_drafts[0].status, "sent");
+    assert.ok(testEnv.DB.state.email_drafts[0].sent_at);
+    assert.equal(testEnv.DB.state.delivery_failures.length, 0);
+    assert.equal(testEnv.DB.state.integration_events[0].kind, "operator_email");
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+async function testSendFailure() {
+  const testEnv = env({ apiKey: "kit-secret" });
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async () => {
+    assert.equal(testEnv.DB.state.email_drafts[0]?.status, "draft", "email must be stored before Kit is called");
+    return new Response(JSON.stringify({ errors: ["bad tag"] }), {
+      status: 422,
+      headers: { "content-type": "application/json" },
+    });
+  };
+  try {
+    const response = await emailApi.onRequestPost({ request: postRequest("send", composed), env: testEnv });
+    const data = await response.json();
+    assert.equal(response.status, 502);
+    assert.equal(data.sent, false);
+    assert.equal(data.status, "failed");
+    assert.equal(data.draft.subject, composed.subject);
+    assert.equal(data.draft.body_text, composed.body_text);
+    assert.equal(data.draft.tag_id, composed.tag_id);
+    assert.equal(testEnv.DB.state.email_drafts[0].status, "failed");
+    assert.equal(testEnv.DB.state.delivery_failures.length, 1);
+    assert.equal(testEnv.DB.state.delivery_failures[0].kind, "kit_email_compose");
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+async function testSendWithoutKey() {
+  const testEnv = env();
+  const originalFetch = globalThis.fetch;
+  globalThis.fetch = async () => {
+    throw new Error("fetch should not run");
+  };
+  try {
+    const response = await emailApi.onRequestPost({ request: postRequest("send", composed), env: testEnv });
+    const data = await response.json();
+    assert.equal(response.status, 200);
+    assert.equal(data.configured, false);
+    assert.equal(data.sent, false);
+    assert.equal(data.status, "draft");
+    assert.equal(data.draft.subject, composed.subject);
+    assert.equal(data.draft.body, composed.body_text);
+    assert.equal(testEnv.DB.state.email_drafts[0].status, "draft");
+    assert.equal(testEnv.DB.state.delivery_failures.length, 1);
+  } finally {
+    globalThis.fetch = originalFetch;
+  }
+}
+
+try {
+  await testAuthEveryAction();
+  await testTagsWithoutKey();
+  await testTagsWithKey();
+  await testDraftActionAndList();
+  await testSendSuccess();
+  await testSendFailure();
+  await testSendWithoutKey();
+  console.log("PASS email composer: auth, tags, drafts, Kit send, and fail-soft storage");
+} catch (error) {
+  console.error(`FAIL email composer: ${error?.stack || error}`);
+  process.exitCode = 1;
+}

