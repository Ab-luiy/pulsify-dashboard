.shared-client-wrap > .button { margin-bottom: 24px; white-space: nowrap; }
.route, .global-message { max-width: 1240px; margin-inline: auto; }
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 16px;
}
.section-head h2 { margin: 4px 0 6px; }
.section-head > div { max-width: 720px; }
.section-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }

.panel, .integration-card, .metric-card, .env-card {
  border: 1px solid var(--line);
  background: var(--surface);
  border-radius: var(--radius);
  box-shadow: var(--ui-shadow-sm);
}
.panel:hover,
.integration-card:hover,
.metric-card:hover,
.env-card:hover {
  border-color: var(--ui-line-2);
  box-shadow: var(--ui-shadow-md);
}
.panel { padding: 24px; margin-top: 16px; }
.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}
.panel-head h3, .subsection-head h3 { margin: 4px 0; }
.subsection { border-top: 1px solid var(--line); margin-top: 24px; padding-top: 24px; }
.subsection.compact { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; }
.subsection.compact .field { flex: 1 1 300px; }
.subsection-head { margin-bottom: 16px; }
.subsection-head.outside { margin: 32px 0 12px; }

.advanced {
  min-width: 0;
  margin-top: 16px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface-2);
}
