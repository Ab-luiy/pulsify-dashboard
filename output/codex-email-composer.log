+      return;
+    }
+
+    status.textContent = "Connected";
+    status.className = "provider-status connected";
+    $("emailKitHeading").textContent = "Kit is connected";
+    if (!response.ok || !data.ok) {
+      $("emailKitHint").textContent = data.error || "The API key is set, but Kit tags could not be loaded.";
+      $("emailTagHint").textContent = "Refresh after the Kit connection can return tags.";
+      select.innerHTML = '<option value="">Tags unavailable</option>';
+      select.disabled = true;
+      return;
+    }
+
+    $("emailKitHint").textContent = "The saved operator API key is active. Send creates a real Kit broadcast for one selected tag.";
+    if (!state.emailTags.length) {
+      $("emailTagHint").textContent = "The connected Kit account returned no tags. Create a tag in Kit, then refresh.";
+      select.innerHTML = '<option value="">No Kit tags found</option>';
+      select.disabled = true;
+      return;
+    }
+
+    $("emailTagHint").textContent = "Choose the exact Kit audience tag for this broadcast.";
+    select.innerHTML = [
+      '<option value="">Select a Kit tag</option>',
+      ...state.emailTags.map((tag) => `<option value="${esc(tag.id)}">${esc(tag.name)} (${esc(tag.id)})</option>`),
+    ].join("");
+    if (state.emailTags.some((tag) => String(tag.id) === previousTag)) select.value = previousTag;
+    select.disabled = false;
+  }
+
+  async function loadEmailDrafts() {
+    const response = await api("/api/email-compose?action=drafts");
+    const data = await response.json().catch(() => ({}));
+    if (!response.ok || !data.ok) throw new Error(data.error || "Could not load stored email.");
+    state.emailDrafts = Array.isArray(data.drafts) ? data.drafts : [];
+    renderEmailDraftRows();
+    $("emailDraftsUpdated").textContent = `Updated ${new Date().toLocaleTimeString()}`;
+    $("emailDraftsUpdated").className = "status-pill success";
+  }
+
+  function renderEmailClient() {
+    const active = state.clients.find((client) => client.client === state.client);
+    $("emailClientLabel").textContent = active
+      ? `${active.client_name || active.client} email`
+      : "No active client";
+    syncEmailComposerUi();
+  }
+
+  function syncEmailComposerUi() {
+    const hasClient = Boolean(state.client);
+    const hasTag = Boolean($("emailTag").value);
+    $("saveEmailDraftButton").disabled = state.emailBusy || !hasClient;
+    $("sendEmailButton").disabled = state.emailBusy || !hasClient || !state.emailConfigured || !hasTag;
+    $("emailComposerPanel").classList.toggle("email-no-client", !hasClient);
+  }
+
+  async function submitEmail(action) {
+    const subject = $("emailSubject").value.trim();
+    const bodyText = $("emailBody").value.trim();
+    const tagId = $("emailTag").value;
+    const message = $("emailComposeMessage");
+    hideMessage(message);
+
+    if (!state.client) {
+      showMessage(message, "Select a client before saving or sending email.", "error");
+      return;
+    }
+    if (!subject || !bodyText) {
+      showMessage(message, "Subject and body are required.", "error");
+      return;
+    }
+    if (action === "send" && !tagId) {
+      showMessage(message, "Select the Kit tag before sending.", "error");
+      return;
+    }
+
+    state.emailBusy = true;
+    syncEmailComposerUi();
+    try {
+      const response = await api(`/api/email-compose?action=${encodeURIComponent(action)}`, {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({
+          client: state.client,
+          subject,
+          body_text: bodyText,
+          tag_id: tagId || null,
+        }),
+      });
+      const data = await response.json().catch(() => ({}));
+      await loadEmailDrafts();
+
+      if (data.status === "sent" && data.sent) {
+        showMessage(message, `Sent through Kit. Broadcast ${data.broadcast_id}.`, "success");
+        return;
+      }
+      if (data.status === "draft") {
+        showMessage(message, data.message || "Draft saved. No email was sent.", "neutral");
+        return;
+      }
+      if (data.status === "failed") {
+        showMessage(message, data.error || "Kit failed. The complete email is stored for copy and paste.", "error");
+        return;
+      }
+      if (!response.ok || !data.ok) throw new Error(data.error || "The email action failed.");
+      showMessage(message, "Draft saved. No email was sent.", "neutral");
+    } catch (error) {
+      if (state.key) showMessage(message, error.message || "The email action failed.", "error");
+    } finally {
+      state.emailBusy = false;
+      syncEmailComposerUi();
+    }
+  }
+
+  function renderEmailDraftRows() {
+    const rows = state.emailDrafts || [];
+    $("emailDraftsEmpty").hidden = rows.length > 0;
+    $("emailDraftsTableWrap").hidden = rows.length === 0;
+    $("emailDraftRows").innerHTML = rows.map((draft) => {
+      const statusClass = draft.status === "sent" ? "success" : draft.status === "failed" ? "failure" : "";
+      const tag = state.emailTags.find((item) => String(item.id) === String(draft.tag_id));
+      return `<tr>
+        <td><strong>${esc(draft.client || "operator")}</strong></td>
+        <td><strong>${esc(draft.subject)}</strong><span class="muted email-body-preview">${esc(String(draft.body || "").slice(0, 90))}</span></td>
+        <td>${esc(tag?.name || draft.tag_id || "Not selected")}</td>
+        <td><span class="badge ${statusClass}">${esc(draft.status || "draft")}</span></td>
+        <td>${esc(formatDate(draft.sent_at || draft.created_at))}</td>
+        <td><div class="row-actions"><button data-email-load="${esc(draft.id)}" type="button">Load</button><button data-email-copy="${esc(draft.id)}" type="button">Copy</button></div></td>
+      </tr>`;
+    }).join("");
+  }
+
+  async function handleEmailDraftAction(event) {
+    const loadButton = event.target.closest("[data-email-load]");
+    const copyButton = event.target.closest("[data-email-copy]");
+    const id = loadButton?.dataset.emailLoad || copyButton?.dataset.emailCopy;
+    if (!id) return;
+    const draft = state.emailDrafts.find((item) => String(item.id) === String(id));
+    if (!draft) return;
+
+    if (loadButton) {
+      $("emailSubject").value = draft.subject || "";
+      $("emailBody").value = draft.body || "";
+      if (draft.tag_id && !Array.from($("emailTag").options).some((option) => option.value === String(draft.tag_id))) {
+        $("emailTag").add(new Option(`Stored tag ${draft.tag_id}`, String(draft.tag_id)));
+        $("emailTag").disabled = false;
+      }
+      $("emailTag").value = draft.tag_id || "";
+      syncEmailComposerUi();
+      showMessage($("emailComposeMessage"), `Loaded ${draft.status} email. No email was sent by this action.`, "neutral");
+      $("emailSubject").focus();
+      return;
+    }
+
+    const copied = await copyText(`Subject: ${draft.subject}\n\n${draft.body}`);
+    showMessage(
+      $("emailComposeMessage"),
+      copied ? "Email copied." : "The browser blocked copying. Load the email and copy it manually.",
+      copied ? "neutral" : "error",
+    );
+  }
+
+  async function markPaid(event) {
     event.preventDefault();
     if (!state.client) return;
     const button = $("markPaidButton");
diff --git a/output/standard-preview/functions/api/email-compose.js b/output/standard-preview/functions/api/email-compose.js
new file mode 100644
index 0000000000000000000000000000000000000000..342eccfca60e7361dfca611e039c429503d458ad
--- /dev/null
+++ b/output/standard-preview/functions/api/email-compose.js
@@ -0,0 +1,290 @@
+import { checkAdmin, cleanId, escapeHtml, json, nowIso, str, strOrNull } from "../_shared/common.js";
+import { getIntegration, recordFailure, recordIntegrationEvent } from "../_shared/integrations.js";
+
+const KIT_TAGS_URL = "https://api.kit.com/v4/tags";
+const KIT_BROADCASTS_URL = "https://api.kit.com/v4/broadcasts";
+const FAILURE_KIND = "kit_email_compose";
+
+export async function onRequestGet({ request, env }) {
+  const auth = checkAdmin(request, env);
+  if (auth) return auth;
+  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);
+
+  const url = new URL(request.url);
+  const action = str(url.searchParams.get("action") || "drafts").toLowerCase();
+  if (action === "drafts") return listDrafts(env, url.searchParams.get("client"));
+  if (action !== "tags") return json({ ok: false, error: "unknown action" }, 422);
+
+  const kit = await getIntegration(env, "operator", "", "kit");
+  const apiKey = kit?.secrets?.api_key;
+  if (!apiKey) {
+    return json({
+      ok: true,
+      configured: false,
+      api_key_set: false,
+      tags: [],
+      message: "Connect the operator Kit account in Integrations to load tags and send email.",
+    });
+  }
+
+  try {
+    const response = await fetch(`${KIT_TAGS_URL}?per_page=100`, {
+      headers: { "X-Kit-Api-Key": apiKey },
+    });
+    const data = await response.json().catch(() => ({}));
+    if (!response.ok) {
+      return json({
+        ok: false,
+        configured: true,
+        api_key_set: true,
+        tags: [],
+        error: `Kit tags request failed with status ${response.status}.`,
+      }, 502);
+    }
+
+    const tags = Array.isArray(data.tags)
+      ? data.tags.map((tag) => ({ id: String(tag.id), name: str(tag.name) || `Tag ${tag.id}` }))
+      : [];
+    return json({ ok: true, configured: true, api_key_set: true, tags });
+  } catch (error) {
+    return json({
+      ok: false,
+      configured: true,
+      api_key_set: true,
+      tags: [],
+      error: `Kit tags request failed: ${error?.message || error}`,
+    }, 502);
+  }
+}
+
+export async function onRequestPost({ request, env }) {
+  const auth = checkAdmin(request, env);
+  if (auth) return auth;
+  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);
+
+  const url = new URL(request.url);
+  const body = await request.json().catch(() => ({}));
+  const action = str(url.searchParams.get("action") || body.action).toLowerCase();
+  if (action !== "draft" && action !== "send") {
+    return json({ ok: false, error: "action must be draft or send" }, 422);
+  }
+
+  const input = normalizeDraftInput(body);
+  if (!input.subject) return json({ ok: false, error: "subject is required" }, 422);
+  if (!input.body) return json({ ok: false, error: "body_html or body_text is required" }, 422);
+  if (action === "send" && !input.tag_id) {
+    return json({ ok: false, error: "tag_id is required to send" }, 422);
+  }
+
+  if (action === "draft") {
+    const draft = await saveDraft(env, input, "draft", null);
+    return json({ ok: true, sent: false, status: "draft", draft });
+  }
+
+  const kit = await getIntegration(env, "operator", "", "kit");
+  const apiKey = kit?.secrets?.api_key;
+  if (!apiKey) {
+    const draft = await saveDraft(env, input, "draft", null);
+    await recordFailure(
+      env,
+      input.client,
+      FAILURE_KIND,
+      "operator Kit integration not configured; email saved as draft",
+      { skipDiscord: true },
+    );
+    return json({
+      ok: true,
+      sent: false,
+      configured: false,
+      api_key_set: false,
+      status: "draft",
+      message: "Kit is not connected. The email was saved as a draft for copy and paste.",
+      draft,
+    });
+  }
+
+  const pendingDraft = await saveDraft(env, input, "draft", null);
+  try {
+    const sendAt = new Date(Date.now() + 60 * 1000).toISOString();
+    const response = await fetch(KIT_BROADCASTS_URL, {
+      method: "POST",
+      headers: {
+        "content-type": "application/json",
+        "X-Kit-Api-Key": apiKey,
+      },
+      // Kit creates the broadcast now and schedules it one minute ahead for the selected tag only.
+      body: JSON.stringify(buildBroadcast(input, kit, sendAt)),
+    });
+    const data = await response.json().catch(() => ({}));
+    const broadcastId = data?.broadcast?.id;
+    if (!response.ok || !broadcastId) {
+      const detail = `broadcast_${response.status}: ${summarize(data)}`;
+      const draft = await updateDraftStatus(env, pendingDraft, "failed", null);
+      await recordFailure(env, input.client, FAILURE_KIND, detail, { skipDiscord: true });
+      return json({
+        ok: false,
+        sent: false,
+        configured: true,
+        api_key_set: true,
+        status: "failed",
+        error: "Kit rejected the broadcast. The email is stored below for copy and paste.",
+        draft,
+      }, 502);
+    }
+
+    const sentAt = nowIso();
+    const draft = await updateDraftStatus(env, pendingDraft, "sent", sentAt);
+    await recordIntegrationEvent(env, {
+      provider: "kit",
+      kind: "operator_email",
+      client: input.client,
+      externalId: String(broadcastId),
+      payloadSummary: {
+        subject: input.subject,
+        tag_id: input.tag_id,
+        send_at: sendAt,
+      },
+    }).catch((error) => recordFailure(
+      env,
+      input.client,
+      "kit_email_event",
+      `broadcast ${broadcastId} sent but event logging failed: ${error?.message || error}`,
+      { skipDiscord: true },
+    ));
+    return json({
+      ok: true,
+      sent: true,
+      configured: true,
+      api_key_set: true,
+      status: "sent",
+      broadcast_id: broadcastId,
+      send_at: sendAt,
+      draft,
+    });
+  } catch (error) {
+    const detail = `network_error: ${error?.message || error}`;
+    const draft = await updateDraftStatus(env, pendingDraft, "failed", null);
+    await recordFailure(env, input.client, FAILURE_KIND, detail, { skipDiscord: true });
+    return json({
+      ok: false,
+      sent: false,
+      configured: true,
+      api_key_set: true,
+      status: "failed",
+      error: "Kit could not be reached. The email is stored below for copy and paste.",
+      draft,
+    }, 502);
+  }
+}
+
+export async function onRequestOptions() {
+  return new Response(null, {
+    status: 204,
+    headers: {
+      "access-control-allow-origin": "*",
+      "access-control-allow-methods": "GET, POST, OPTIONS",
+      "access-control-allow-headers": "content-type, x-admin-key",
+      "access-control-max-age": "86400",
+    },
+  });
+}
+
+async function listDrafts(env, clientValue) {
+  const client = cleanId(clientValue);
+  const statement = client
+    ? env.DB.prepare(
+      `SELECT id, client, subject, body, tag_id, status, created_at, sent_at
+         FROM email_drafts WHERE client=? ORDER BY created_at DESC, id DESC LIMIT 30`,
+    ).bind(client)
+    : env.DB.prepare(
+      `SELECT id, client, subject, body, tag_id, status, created_at, sent_at
+         FROM email_drafts ORDER BY created_at DESC, id DESC LIMIT 30`,
+    );
+  const result = await statement.all();
+  return json({ ok: true, drafts: result.results || [] });
+}
+
+function normalizeDraftInput(body) {
+  const bodyHtml = str(body.body_html);
+  const bodyText = str(body.body_text);
+  return {
+    client: cleanId(body.client, "operator"),
+    subject: str(body.subject).slice(0, 240),
+    body: bodyHtml || bodyText,
+    body_html: bodyHtml || textToHtml(bodyText),
+    body_text: bodyText || null,
+    tag_id: strOrNull(body.tag_id),
+  };
+}
+
+function textToHtml(value) {
+  return String(value || "")
+    .split(/\n{2,}/)
+    .map((paragraph) => `<p>${escapeHtml(paragraph).replace(/\n/g, "<br>")}</p>`)
+    .join("");
+}
+
+function buildBroadcast(input, kit, sendAt) {
+  return {
+    content: input.body_html,
+    description: `Pulsify operator email for ${input.client}`,
+    public: false,
+    published_at: nowIso(),
+    subject: input.subject,
+    send_at: sendAt,
+    email_template_id: kit?.config?.email_template_id
+      ? Number(kit.config.email_template_id)
+      : undefined,
+    email_address: kit?.config?.onboarding_sender_email || null,
+    subscriber_filter: [
+      {
+        all: [{ type: "tag", ids: [input.tag_id] }],
+        any: null,
+        none: null,
+      },
+    ],
+  };
+}
+
+async function saveDraft(env, input, status, sentAt) {
+  const createdAt = nowIso();
+  const result = await env.DB.prepare(
+    `INSERT INTO email_drafts (client, subject, body, tag_id, status, created_at, sent_at)
+     VALUES (?,?,?,?,?,?,?)`,
+  ).bind(
+    input.client,
+    input.subject,
+    input.body,
+    input.tag_id,
+    status,
+    createdAt,
+    sentAt,
+  ).run();
+  return {
+    id: result.meta?.last_row_id ?? null,
+    client: input.client,
+    subject: input.subject,
+    body: input.body,
+    body_html: input.body_html,
+    body_text: input.body_text,
+    tag_id: input.tag_id,
+    status,
+    created_at: createdAt,
+    sent_at: sentAt,
+  };
+}
+
+async function updateDraftStatus(env, draft, status, sentAt) {
+  await env.DB.prepare(
+    "UPDATE email_drafts SET status=?, sent_at=? WHERE id=?",
+  ).bind(status, sentAt, draft.id).run();
+  return { ...draft, status, sent_at: sentAt };
+}
+
+function summarize(value) {
+  try {
+    return JSON.stringify(value).slice(0, 300);
+  } catch {
+    return String(value || "").slice(0, 300);
+  }
+}
