    renderPerformanceTypeOptions();
    renderIntegrationShell();
    bindEvents();
    routeFromHash();

    const saved = readStoredKey();
    if (saved) {
      $("adminKey").value = saved;
      unlockWithKey(saved, true);
    }
  }

