import {
  adminJsonError,
  deleteIntegration,
  getIntegration,
  listIntegrations,
  maskIntegration,
  normalizeScope,
  optionsResponse,
  sendDiscordTest,
  sendKitTest,
  upsertIntegration,
  validateProvider,
} from "../_shared/integrations.js";
import { checkAdmin, cleanId, hasOwn, json, str } from "../_shared/common.js";

export async function onRequestGet({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const url = new URL(request.url);
  const scope = normalizeScope(url.searchParams.get("scope") || "client");
  const client = scope === "client" ? cleanId(url.searchParams.get("client")) : "";
  const provider = str(url.searchParams.get("provider")).toLowerCase() || "";
  const action = str(url.searchParams.get("action")).toLowerCase();

  if (!scope) return adminJsonError("scope must be operator or client");
  if (scope === "client" && !client && !action) {
    return adminJsonError("client is required for client scope");
  }

  if (action === "test") {
    if (!provider) return adminJsonError("provider is required for tests");
    const record = await getIntegration(env, scope, client, provider);
    if (!record) return adminJsonError("integration not found", 404);

    if (provider === "kit") {
      const test = await sendKitTest(env, record);
      return json({ ok: test.ok, provider, test });
    }
    if (provider === "discord") {
      const test = await sendDiscordTest(env);
      return json({ ok: test.ok, provider, test });
    }
    return json({
      ok: true,
      provider,
      test: {
        status: record.connected ? "config_present" : "not_configured",
        connected: record.connected,
      },
    });
  }

  const records = await listIntegrations(env, { scope, client, provider: provider || null });
  return json({
    ok: true,
    scope,
    client: scope === "client" ? client : null,
    integrations: records.map(maskIntegration),
  });
}

export async function onRequestPost({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const scope = normalizeScope(body.scope);
  const client = scope === "client" ? cleanId(body.client) : "";
  const provider = str(body.provider).toLowerCase();
  if (!scope) return adminJsonError("scope must be operator or client");
  const checked = validateProvider(provider, scope);
  if (checked.error) return adminJsonError(checked.error);
  if (scope === "client" && !client) return adminJsonError("valid client id required");

  const result = await upsertIntegration(env, {
    scope,
    client,
    provider,
    config: hasOwn(body, "config") && body.config && typeof body.config === "object" ? body.config : {},
    secrets: hasOwn(body, "secrets") && body.secrets && typeof body.secrets === "object" ? body.secrets : {},
    origin: new URL(request.url).origin,
  });

  if (!result.ok) return adminJsonError(result.error, 422);
  return json({
    ok: true,
    integration: result.integration,
    one_time: result.one_time,
  });
}

export async function onRequestDelete({ request, env }) {
  const auth = checkAdmin(request, env);
  if (auth) return auth;
  if (!env.DB) return json({ ok: false, error: "no database bound" }, 500);

  const body = await request.json().catch(() => ({}));
  const scope = normalizeScope(body.scope);
  const client = scope === "client" ? cleanId(body.client) : "";
  const provider = str(body.provider).toLowerCase();
  if (!scope) return adminJsonError("scope must be operator or client");

  const result = await deleteIntegration(env, scope, client, provider);
  if (!result.ok) return adminJsonError(result.error, 422);
  return json(result);
}

export async function onRequestOptions() {
  return optionsResponse("GET, POST, DELETE, OPTIONS");
}


===== SHARED INTEGRATIONS =====

import {
  cleanId,
  constantTimeEqual,
  generateOpaqueToken,
  hasOwn,
  json,
  normalizeEmail,
  nowIso,
  parseJson,
  str,
  strOrNull,
  titleCase,
} from "./common.js";

export const DEFAULT_ONBOARDING_FORM_URL =
  "https://docs.google.com/forms/d/1zXVRhwBgX3WF1ie194m-FvG7Vd4-OFpwNA9wtKu_gTE/viewform";
export const DEFAULT_ONBOARDING_DOC_URL =
  "https://docs.google.com/document/d/1b3DyzRQ0h9u91l80kl_iqyrhKd6FiGe2xQe1rqN-FdE/view";

export const PROVIDERS = {
  kit: {
    scope: "both",
    configFields: [
      "tag_id",
      "contact_email",
      "contact_name",
      "onboarding_form_url",
      "onboarding_doc_url",
      "onboarding_subject",
      "onboarding_preview_text",
      "onboarding_sender_email",
      "email_template_id",
    ],
    secretFields: ["api_key"],
    operatorConnected(record) {
      return Boolean(record.secrets.api_key);
    },
    clientConnected(record) {
      return Boolean(record.secrets.api_key && record.config.tag_id);
    },
  },
  discord: {
    scope: "operator",
    configFields: [],
    secretFields: ["webhook_url"],
    operatorConnected(record) {
      return Boolean(record.secrets.webhook_url);
    },
  },
  calcom: {
    scope: "client",
    configFields: ["contact_email", "contact_name", "booking_url", "booking_note"],
    secretFields: ["api_key", "path_secret"],
    pathSecret: true,
    clientConnected(record) {
      return Boolean(record.secrets.path_secret);
    },
  },
  calendly: {
    scope: "client",
    configFields: ["contact_email", "contact_name", "booking_url", "booking_note"],
    secretFields: ["path_secret"],
    pathSecret: true,
    clientConnected(record) {
      return Boolean(record.secrets.path_secret);
    },
  },
  whop: {
    scope: "client",
    configFields: ["contact_email", "contact_name", "company_id"],
    secretFields: ["api_key", "path_secret"],
    pathSecret: true,
    clientConnected(record) {
      return Boolean(record.secrets.path_secret);
    },
  },
  stripe: {
    scope: "client",
    configFields: ["contact_email", "contact_name", "webhook_description"],
    secretFields: ["path_secret", "webhook_secret"],
    pathSecret: true,
    clientConnected(record) {
      return Boolean(record.secrets.path_secret || record.secrets.webhook_secret);
    },
  },
  youtube: {
    scope: "client",
    configFields: ["confirmed", "confirmed_at", "channel_note"],
    secretFields: [],
    clientConnected(record) {
      return Boolean(record.config.confirmed);
    },
  },
  instagram: {
    scope: "client",
    configFields: ["confirmed", "confirmed_at", "channel_note"],
    secretFields: [],
    clientConnected(record) {
      return Boolean(record.config.confirmed);
    },
  },
  zapier: {
    scope: "client",
    configFields: ["note"],
    secretFields: ["webhook_url"],
    clientConnected(record) {
      return Boolean(record.secrets.webhook_url);
    },
  },
};

export function validateProvider(provider, scope) {
  const safeProvider = str(provider).toLowerCase();
  const def = PROVIDERS[safeProvider];
  if (!def) return { error: `unknown provider: ${provider}` };
  if (def.scope !== "both" && def.scope !== scope) {
    return { error: `${safeProvider} is not valid for ${scope} scope` };
  }
  return { provider: safeProvider, def };
}

export function normalizeScope(value) {
  return value === "operator" ? "operator" : value === "client" ? "client" : "";
}

export async function listIntegrations(env, filters = {}) {
  if (!env.DB) return [];
  const where = [];
  const params = [];
  if (filters.scope) {
    where.push("scope=?");
    params.push(filters.scope);
  }
  if (hasOwn(filters, "client")) {
    where.push("COALESCE(client_id,'')=?");
    params.push(filters.client ? cleanId(filters.client) : "");
  }
  if (filters.provider) {
    where.push("provider=?");
    params.push(str(filters.provider).toLowerCase());
  }
  const result = await env.DB.prepare(
    `SELECT scope, client_id, provider, config_json, secret_json, created_at, updated_at
       FROM integrations${where.length ? ` WHERE ${where.join(" AND ")}` : ""}
       ORDER BY scope, COALESCE(client_id,''), provider`,
  ).bind(...params).all();

  const rows = result.results || [];
  const eventRows = await env.DB.prepare(
    `SELECT provider, COALESCE(client,'') AS client_key, MAX(ts) AS last_event_ts
       FROM integration_events GROUP BY provider, COALESCE(client,'')`,
  ).all().catch(() => ({ results: [] }));
  const eventMap = new Map(
    (eventRows.results || []).map((row) => [`${row.provider}:${row.client_key}`, row.last_event_ts]),
  );

  return rows.map((row) => inflateIntegrationRow(row, eventMap));
}

export async function getIntegration(env, scope, client, provider) {
  const rows = await listIntegrations(env, { scope, client, provider });
  return rows[0] || null;
}

export async function upsertIntegration(env, input) {
  if (!env.DB) return { ok: false, error: "no database bound" };
  const scope = normalizeScope(input.scope);
  const client = scope === "client" ? cleanId(input.client) : "";
  const checked = validateProvider(input.provider, scope);
  if (checked.error) return { ok: false, error: checked.error };
  if (scope === "client" && !client) return { ok: false, error: "valid client id required" };

  const existing = await getIntegration(env, scope, client, checked.provider);
  const existingConfig = existing?.config || {};
  const existingSecrets = existing?.secrets || {};

  const nextConfig = mergeObject(existingConfig, input.config || {}, checked.def.configFields);
  const nextSecrets = mergeObject(existingSecrets, input.secrets || {}, checked.def.secretFields, true);
  let generatedPathSecret = null;
  if (checked.def.pathSecret && !nextSecrets.path_secret) {
    generatedPathSecret = generateOpaqueToken(18);
    nextSecrets.path_secret = generatedPathSecret;
  }

  const createdAt = existing?.created_at || nowIso();
  const updatedAt = nowIso();
  await env.DB.prepare(
    `INSERT INTO integrations (scope, client_id, provider, config_json, secret_json, created_at, updated_at)
     VALUES (?,?,?,?,?,?,?)
     ON CONFLICT(scope, client_id, provider) DO UPDATE SET
       config_json=excluded.config_json,
       secret_json=excluded.secret_json,
       updated_at=excluded.updated_at`,
  ).bind(
    scope,
    client,
    checked.provider,
    JSON.stringify(nextConfig),
    JSON.stringify(nextSecrets),
    createdAt,
    updatedAt,
  ).run();

  const saved = await getIntegration(env, scope, client, checked.provider);
  const webhookUrl = generatedPathSecret || input?.secrets?.path_secret
    ? buildWebhookUrl(input.origin, checked.provider, generatedPathSecret || str(input.secrets.path_secret))
    : null;

  return {
    ok: true,
    integration: saved ? maskIntegration(saved) : null,
    one_time: webhookUrl ? { webhook_url: webhookUrl } : null,
  };
}

export async function deleteIntegration(env, scope, client, provider) {
  if (!env.DB) return { ok: false, error: "no database bound" };
  const safeScope = normalizeScope(scope);
  const safeClient = safeScope === "client" ? cleanId(client) : "";
  const checked = validateProvider(provider, safeScope);
  if (checked.error) return { ok: false, error: checked.error };
  const result = await env.DB.prepare(
    "DELETE FROM integrations WHERE scope=? AND COALESCE(client_id,'')=? AND provider=?",
  ).bind(safeScope, safeClient, checked.provider).run();
  return { ok: true, deleted: Boolean(result.meta?.changes) };
}

export function maskIntegration(record) {
  const def = PROVIDERS[record.provider];
  const masked = {
    scope: record.scope,
    client: record.client,
    provider: record.provider,
    config: { ...record.config },
    created_at: record.created_at,
    updated_at: record.updated_at,
    last_event_ts: record.last_event_ts || null,
    connected: isIntegrationConnected(record),
  };
  for (const field of def.secretFields) {
    masked.config[`${field}_set`] = Boolean(record.secrets[field]);
  }
  return masked;
}

export function isIntegrationConnected(record) {
  const def = PROVIDERS[record.provider];
  if (!def) return false;
  if (record.scope === "operator" && typeof def.operatorConnected === "function") {
    return def.operatorConnected(record);
  }
  if (record.scope === "client" && typeof def.clientConnected === "function") {
    return def.clientConnected(record);
  }
  return false;
}

export async function recordIntegrationEvent(env, event) {
  if (!env.DB) return { ok: false, duplicate: false };
  const payload = event.payloadSummary || {};
  try {
    const result = await env.DB.prepare(
      `INSERT INTO integration_events (provider, kind, client, external_id, payload_summary_json, ts)
       VALUES (?,?,?,?,?,?)`,
    ).bind(
      str(event.provider).toLowerCase(),
      str(event.kind).toLowerCase(),
      cleanId(event.client, null),
      strOrNull(event.externalId),
      JSON.stringify(payload),
      event.ts || nowIso(),
    ).run();
    return { ok: true, duplicate: false, id: result.meta?.last_row_id ?? null };
  } catch (error) {
    if (String(error?.message || "").toLowerCase().includes("unique")) {
      return { ok: true, duplicate: true };
    }
    throw error;
  }
}

export async function getLatestEventFor(env, provider, client) {
  if (!env.DB) return null;
  return env.DB.prepare(
    `SELECT provider, kind, client, payload_summary_json, external_id, ts
       FROM integration_events
      WHERE provider=? AND COALESCE(client,'')=?
      ORDER BY ts DESC LIMIT 1`,
  ).bind(str(provider).toLowerCase(), client ? cleanId(client) : "").first();
}

export async function recordFailure(env, client, kind, detail, options = {}) {
  try {
    if (!env.DB) return;
    await env.DB.prepare(
      "INSERT INTO delivery_failures (client,kind,detail,at) VALUES (?,?,?,?)",
    ).bind(
      cleanId(client, "unknown"),
      str(kind).slice(0, 120),
      detail == null ? null : String(detail).slice(0, 500),
      nowIso(),
    ).run();
  } catch {
    return;
  }

  if (options.skipDiscord) return;
  await sendDiscordAlert(env, {
    title: "Delivery failure",
    lines: [
      `Client: ${client || "unknown"}`,
      `Kind: ${kind}`,
      String(detail || "").slice(0, 220),
    ],
  }, { skipFailureLog: true });
}

export async function sendDiscordAlert(env, alert, options = {}) {
  const discord = await getIntegration(env, "operator", "", "discord");
  const url = discord?.secrets?.webhook_url;
  if (!url) return { ok: false, status: "not_configured" };

  const content = formatDiscordMessage(alert);
  try {
    const response = await fetch(url, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify({ content }),
    });
    if (!response.ok) {
      const detail = `discord_${response.status}: ${await safeText(response)}`;
      if (!options.skipFailureLog) {
        await recordFailure(env, alert.client || "operator", "discord", detail, { skipDiscord: true });
      }
      return { ok: false, status: `http_${response.status}` };
    }
    return { ok: true, status: "sent" };
  } catch (error) {
    if (!options.skipFailureLog) {
      await recordFailure(
        env,
        alert.client || "operator",
        "discord",
        `network_error: ${error?.message || error}`,
        { skipDiscord: true },
      );
    }
    return { ok: false, status: "network_error" };
  }
}

export async function sendDiscordTest(env) {
  return sendDiscordAlert(env, {
    title: "Integrations test",
    lines: ["Discord webhook received the Pulsify test ping."],
  });
}

export async function sendKitTest(env, record) {
  if (!record?.secrets?.api_key) {
    return { ok: false, status: "not_configured", error: "Kit API key not configured" };
  }

  try {
    const response = await fetch("https://api.kit.com/v4/tags?per_page=5", {
      headers: { "X-Kit-Api-Key": record.secrets.api_key },
    });
    if (!response.ok) {
      return {
        ok: false,
        status: `http_${response.status}`,
        error: await safeText(response),
      };
    }
    const data = await response.json().catch(() => ({}));
    return {
      ok: true,
      status: "connected",
      tags: Array.isArray(data.tags) ? data.tags.slice(0, 5).map((tag) => tag.name) : [],
    };
  } catch (error) {
    return { ok: false, status: "network_error", error: error?.message || String(error) };
  }
}

export function buildWebhookUrl(origin, provider, secret) {
  return `${origin}/api/hooks/${encodeURIComponent(provider)}/${encodeURIComponent(secret)}`;
}

export async function resolveIntegrationBySecret(env, provider, secret) {
  const safeProvider = str(provider).toLowerCase();
  const safeSecret = str(secret);
  if (!env.DB || !safeProvider || !safeSecret) return null;
  const rows = await listIntegrations(env, { scope: "client", provider: safeProvider });
  return rows.find((row) => row.secrets.path_secret === safeSecret) || null;
}

export async function getClientKitConfig(env, client) {
  const integration = await getIntegration(env, "client", client, "kit");
  if (integration?.secrets?.api_key || integration?.config?.tag_id) {
    return {
      kit_api_key: integration.secrets.api_key || null,
      kit_tag_id: integration.config.tag_id || null,
      contact_email: normalizeEmail(integration.config.contact_email),
      contact_name: strOrNull(integration.config.contact_name),
    };
  }

  if (!env.DB) return null;
  const legacy = await env.DB.prepare(
    `SELECT kit_api_key, kit_tag_id FROM client_config WHERE client=?`,
  ).bind(cleanId(client)).first().catch(() => null);
  return legacy || null;
}

export async function getClientIntegrationStatuses(env, client) {
  const safeClient = cleanId(client);
  const rows = await listIntegrations(env, { scope: "client", client: safeClient });
  const statuses = new Map(
    rows.map((row) => [
      row.provider,
      {
        provider: row.provider,
        connected: isIntegrationConnected(row),
        last_event_ts: row.last_event_ts || null,
      },
    ]),
  );

  if (!statuses.has("kit") && env.DB) {
    const legacy = await env.DB.prepare(
      `SELECT kit_api_key FROM client_config WHERE client=?`,
    ).bind(safeClient).first().catch(() => null);
    if (legacy) {
      statuses.set("kit", {
        provider: "kit",
        connected: Boolean(legacy.kit_api_key),
        last_event_ts: (await getLatestEventFor(env, "kit", safeClient))?.ts || null,
      });
    }
  }

  return ["kit", "calcom", "calendly", "whop", "stripe", "youtube", "instagram", "zapier"]
    .map((provider) => statuses.get(provider))
    .filter(Boolean);
}

export async function ensureClientConfigRow(env, client) {
  if (!env.DB) return;
  const safeClient = cleanId(client);
  if (!safeClient) return;
  await env.DB.prepare(
    `INSERT INTO client_config (client, client_name, status, updated_at)
     VALUES (?,?,?,?)
     ON CONFLICT(client) DO UPDATE SET
       client_name=COALESCE(client_config.client_name, excluded.client_name),
       updated_at=excluded.updated_at`,
  ).bind(safeClient, titleCase(safeClient), "prospect", nowIso()).run();
}

function inflateIntegrationRow(row, eventMap) {
  const scope = row.scope === "operator" ? "operator" : "client";
  const client = scope === "client" ? cleanId(row.client_id) : "";
  return {
    scope,
    client,
    provider: str(row.provider).toLowerCase(),
    config: parseJson(row.config_json),
    secrets: parseJson(row.secret_json),
    created_at: row.created_at || null,
    updated_at: row.updated_at || null,
    last_event_ts: eventMap.get(`${row.provider}:${client}`) || null,
  };
}

function mergeObject(existing, incoming, allowedFields, preserveBlank = false) {
  const next = { ...(existing || {}) };
  for (const field of allowedFields) {
    if (!hasOwn(incoming, field)) continue;
    const value = incoming[field];
    if (value === null) {
      delete next[field];
      continue;
    }
    if (preserveBlank && str(value) === "") continue;
    if (!preserveBlank && typeof value === "string" && str(value) === "") continue;
    next[field] = typeof value === "string" ? value.trim() : value;
  }
  for (const key of Object.keys(next)) {
    if (!allowedFields.includes(key)) delete next[key];
  }
  return next;
}

function formatDiscordMessage(alert) {
  const bits = [`**${alert.title || "Pulsify alert"}**`];
  for (const line of alert.lines || []) {
    if (line) bits.push(String(line));
  }
  return bits.join("\n").slice(0, 1900);
}

async function safeText(response) {
  try {
    return (await response.text()).slice(0, 300);
  } catch {
    return "";
  }
}

export function optionsResponse(methods, headers = "content-type, x-admin-key") {
  return new Response(null, {
    headers: {
      "access-control-allow-origin": "*",
      "access-control-allow-methods": methods,
      "access-control-allow-headers": headers,
      "access-control-max-age": "86400",
    },
  });
}

export function adminJsonError(message, status = 422) {
  return json({ ok: false, error: message }, status);
}


===== PAYMENTS EMAIL PATTERN =====

import {
  amountToCents,
  centsToAmount,
  cleanId,
  escapeHtml,
  humanCurrency,
  normalizeEmail,
  nowIso,
  str,
  strOrNull,
  titleCase,
} from "./common.js";
import {
  DEFAULT_ONBOARDING_DOC_URL,
  DEFAULT_ONBOARDING_FORM_URL,
  ensureClientConfigRow,
  getIntegration,
  recordFailure,
  recordIntegrationEvent,
  sendDiscordAlert,
} from "./integrations.js";
import { mintPortalToken } from "./portal-tokens.js";

export async function processNormalizedPayment(env, input) {
  if (!env.DB) return { ok: false, error: "no database bound" };

  const client = cleanId(input.client);
  const reference = str(input.reference);
  const currency = str(input.currency || "USD").toUpperCase();
  const rail = str(input.rail || "manual").toLowerCase();
  const occurredAt = input.occurredAt || nowIso();
  const recordedBy = str(input.recordedBy || `webhook:${rail}`);
  const amountCents = normalizeAmountCents(input.amountCents, input.amount);

  if (!client) return { ok: false, error: "valid client id required" };
  if (amountCents == null) return { ok: false, error: "valid amount required" };
  if (!reference) return { ok: false, error: "reference is required" };

  const existing = await env.DB.prepare(
    `SELECT id, client, amount_cents, currency, rail, reference, occurred_at, recorded_by, note
       FROM payments WHERE reference=?`,
  ).bind(reference).first().catch(() => null);
  if (existing) {
    return { ok: true, duplicate: true, payment: existing, side_effects: { skipped: true } };
  }

  await ensureClientConfigRow(env, client);
  await env.DB.prepare(
    `INSERT INTO payments (
      client, amount_cents, currency, rail, reference, occurred_at, recorded_by, note, created_at
    ) VALUES (?,?,?,?,?,?,?,?,?)`,
  ).bind(
    client,
    amountCents,
    currency,
    rail,
    reference,
    occurredAt,
    recordedBy,
    strOrNull(input.note),
    nowIso(),
  ).run();

  await recordIntegrationEvent(env, {
    provider: rail,
    kind: "payment",
    client,
    externalId: input.eventId || reference,
    payloadSummary: {
      reference,
      amount_cents: amountCents,
      currency,
      recorded_by: recordedBy,
      note: strOrNull(input.note),
    },
  });

  const payment = await env.DB.prepare(
    `SELECT id, client, amount_cents, currency, rail, reference, occurred_at, recorded_by, note
       FROM payments WHERE reference=?`,
  ).bind(reference).first();

  const sideEffects = await runPaymentSideEffects(env, {
    ...payment,
    origin: input.origin,
    client_name: input.clientName,
  });

  return { ok: true, duplicate: false, payment, side_effects: sideEffects };
}

async function runPaymentSideEffects(env, payment) {
  const client = cleanId(payment.client);
  const clientRow = await env.DB.prepare(
    `SELECT client, COALESCE(client_name, client) AS client_name, portal_token_hash
       FROM client_config WHERE client=?`,
  ).bind(client).first().catch(() => null);
  const clientName = clientRow?.client_name || titleCase(client);
  const recipient = await resolvePaymentRecipient(env, client, payment.rail);
  const operatorKit = await getIntegration(env, "operator", "", "kit");
  const draft = await buildOnboardingDraft(operatorKit, payment, {
    client,
    clientName,
    recipient,
    origin: payment.origin,
    hasPortalToken: Boolean(clientRow?.portal_token_hash),
  });

  let portal = null;
  if (!clientRow?.portal_token_hash || draft.needs_fresh_portal_link) {
    portal = await mintPortalToken(env, client, payment.origin);
    if (portal.ok) {
      draft.links.portal_url = portal.link;
      draft.html = renderOnboardingHtml({
        ...draft,
        links: draft.links,
      });
      draft.text = renderOnboardingText(draft);
    } else {
      await recordFailure(env, client, "portal_token", portal.error || "could not mint portal token");
    }
  }

  const email = await sendOnboardingEmail(env, operatorKit, draft, recipient, payment);

  await env.DB.prepare(
    `UPDATE client_config SET status='client', updated_at=? WHERE client=?`,
  ).bind(nowIso(), client).run().catch(async (error) => {
    await recordFailure(env, client, "client_status", error?.message || String(error));
  });

  const alert = await sendDiscordAlert(env, {
    client,
    title: "Payment recorded",
    lines: [
      `${clientName} paid ${humanCurrency(payment.amount_cents, payment.currency)} via ${payment.rail}.`,
      `Reference: ${payment.reference}`,
      email.status === "sent" ? "Onboarding email queued in Kit." : "Onboarding email fell back to operator draft.",
    ],
  });

  return {
    email,
    draft: email.status === "sent" ? null : {
      to: recipient.email || null,
      subject: draft.subject,
      preview_text: draft.preview_text,
      html: draft.html,
      text: draft.text,
      links: draft.links,
    },
    portal: portal || {
      ok: Boolean(clientRow?.portal_token_hash),
      reused: Boolean(clientRow?.portal_token_hash),
      link: draft.links.portal_url || null,
    },
    client_status: "client",
    discord: alert.status,
  };
}

async function resolvePaymentRecipient(env, client, rail) {
  const railIntegration = await getIntegration(env, "client", client, rail);
  const kitIntegration = await getIntegration(env, "client", client, "kit");
  const candidates = [
    {
      email: normalizeEmail(railIntegration?.config?.contact_email),
      name: strOrNull(railIntegration?.config?.contact_name),
    },
    {
      email: normalizeEmail(kitIntegration?.config?.contact_email),
      name: strOrNull(kitIntegration?.config?.contact_name),
    },
  ];

  if (env.DB) {
    const lead = await env.DB.prepare(
      `SELECT email, name FROM leads
         WHERE client=? AND email IS NOT NULL AND email!=''
         ORDER BY applied_at DESC, id DESC LIMIT 1`,
    ).bind(client).first().catch(() => null);
    candidates.push({
      email: normalizeEmail(lead?.email),
      name: strOrNull(lead?.name),
    });
  }

  return candidates.find((item) => item.email) || { email: null, name: null };
}

async function buildOnboardingDraft(operatorKit, payment, context) {
  const config = operatorKit?.config || {};
  const links = {
    onboarding_form_url: config.onboarding_form_url || DEFAULT_ONBOARDING_FORM_URL,
    onboarding_doc_url: config.onboarding_doc_url || DEFAULT_ONBOARDING_DOC_URL,
    portal_url: null,
  };

  const subject = config.onboarding_subject || `${context.clientName} - onboarding starts here`;
  const preview_text = config.onboarding_preview_text || "Your form, portal, and next steps are inside.";
  const draft = {
    client: context.client,
    client_name: context.clientName,
    subject,
    preview_text,
    links,
    amount_cents: payment.amount_cents,
    currency: payment.currency,
    recipient_name: context.recipient.name || context.clientName,
    needs_fresh_portal_link: true,
  };

  draft.html = renderOnboardingHtml(draft);
  draft.text = renderOnboardingText(draft);
  return draft;
}

function renderOnboardingHtml(draft) {
  return [
    `<p>${escapeHtml(draft.recipient_name)},</p>`,
    `<p>We've recorded ${escapeHtml(humanCurrency(draft.amount_cents, draft.currency))}.</p>`,
    "<p>Start here:</p>",
    "<ul>",
    `<li><a href="${escapeHtml(draft.links.onboarding_form_url)}">Complete the onboarding form</a></li>`,
    `<li><a href="${escapeHtml(draft.links.onboarding_doc_url)}">Read the CO1 onboarding doc</a></li>`,
    draft.links.portal_url
      ? `<li><a href="${escapeHtml(draft.links.portal_url)}">Open your private portal</a></li>`
      : "<li>Your portal link needs to be generated manually before sending.</li>",
    "</ul>",
    "<p>Next step: we'll set the game-plan call within 72 hours.</p>",
  ].join("");
}

function renderOnboardingText(draft) {
  return [
    `${draft.recipient_name},`,
    "",
    `We've recorded ${humanCurrency(draft.amount_cents, draft.currency)}.`,
    "",
    "Start here:",
    `1. Onboarding form: ${draft.links.onboarding_form_url}`,
    `2. CO1 onboarding doc: ${draft.links.onboarding_doc_url}`,
    `3. Private portal: ${draft.links.portal_url || "[generate link before sending]"}`,
    "",
    "Next step: we'll set the game-plan call within 72 hours.",
  ].join("\n");
}

async function sendOnboardingEmail(env, operatorKit, draft, recipient, payment) {
  const apiKey = operatorKit?.secrets?.api_key;
  if (!apiKey) {
    await recordFailure(env, payment.client, "kit_onboarding", "operator Kit integration not configured");
    return { ok: false, status: "not_configured" };
  }
  if (!recipient.email) {
    await recordFailure(env, payment.client, "kit_onboarding", "no client email found for onboarding");
    return { ok: false, status: "no_recipient" };
  }

  try {
    const subscriber = await fetch("https://api.kit.com/v4/subscribers", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "X-Kit-Api-Key": apiKey,
      },
      body: JSON.stringify({
        email_address: recipient.email,
        first_name: recipient.name || null,
        state: "active",
      }),
    });
    const subscriberData = await subscriber.json().catch(() => ({}));
    const subscriberId = subscriberData?.subscriber?.id;
    if (!subscriber.ok || !subscriberId) {
      await recordFailure(
        env,
        payment.client,
        "kit_onboarding",
        `subscriber_${subscriber.status}: ${summarizeObject(subscriberData)}`,
      );
      return { ok: false, status: "subscriber_error" };
    }

    const tagName = `pulsify-onboarding-${payment.reference}`;
    const tagResponse = await fetch("https://api.kit.com/v4/tags", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "X-Kit-Api-Key": apiKey,
      },
      body: JSON.stringify({ name: tagName }),
    });
    const tagData = await tagResponse.json().catch(() => ({}));
    const tagId = tagData?.tag?.id;
    if (!tagResponse.ok || !tagId) {
      await recordFailure(
        env,
        payment.client,
        "kit_onboarding",
        `tag_${tagResponse.status}: ${summarizeObject(tagData)}`,
      );
      return { ok: false, status: "tag_error" };
    }

    const attach = await fetch(`https://api.kit.com/v4/tags/${tagId}/subscribers/${subscriberId}`, {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "X-Kit-Api-Key": apiKey,
      },
      body: "{}",
    });
    if (!attach.ok) {
      await recordFailure(
        env,
        payment.client,
        "kit_onboarding",
        `tag_subscriber_${attach.status}: ${(await attach.text().catch(() => "")).slice(0, 240)}`,
      );
      return { ok: false, status: "tag_subscriber_error" };
    }

    const sendAt = new Date(Date.now() + 60 * 1000).toISOString();
    const broadcastResponse = await fetch("https://api.kit.com/v4/broadcasts", {
      method: "POST",
      headers: {
        "content-type": "application/json",
        "X-Kit-Api-Key": apiKey,
      },
      body: JSON.stringify({
        content: draft.html,
        description: `Pulsify onboarding for ${draft.client_name}`,
        public: false,
        published_at: nowIso(),
        preview_text: draft.preview_text,
        subject: draft.subject,
        send_at: sendAt,
        email_template_id: operatorKit?.config?.email_template_id
          ? Number(operatorKit.config.email_template_id)
          : undefined,
        email_address: operatorKit?.config?.onboarding_sender_email || null,
        subscriber_filter: [
          {
            all: [
              {
                type: "tag",
                ids: [tagId],
              },
            ],
            any: null,
            none: null,
          },
        ],
      }),
    });
    const broadcastData = await broadcastResponse.json().catch(() => ({}));
    if (!broadcastResponse.ok || !broadcastData?.broadcast?.id) {
      await recordFailure(
        env,
        payment.client,
        "kit_onboarding",
        `broadcast_${broadcastResponse.status}: ${summarizeObject(broadcastData)}`,
      );
      return { ok: false, status: "broadcast_error" };
    }

    await recordIntegrationEvent(env, {
      provider: "kit",
      kind: "onboarding_email",
      client: payment.client,
      externalId: String(broadcastData.broadcast.id),
      payloadSummary: {
        reference: payment.reference,
        recipient: recipient.email,
        subject: draft.subject,
        send_at: sendAt,
      },
    });

    return {
      ok: true,
      status: "sent",
      recipient: recipient.email,
      broadcast_id: broadcastData.broadcast.id,
      send_at: sendAt,
    };
  } catch (error) {
    await recordFailure(
      env,
      payment.client,
      "kit_onboarding",
      `network_error: ${error?.message || error}`,
    );
    return { ok: false, status: "network_error" };
  }
}

function summarizeObject(value) {
  try {
    return JSON.stringify(value).slice(0, 240);
  } catch {
    return String(value || "");
  }
}

function normalizeAmountCents(amountCents, amount) {
  if (amountCents != null) {
    const parsed = Number(amountCents);
    return Number.isFinite(parsed) ? Math.round(parsed) : null;
  }
  return amountToCents(amount);
}

export function normalizedPaymentFromManual(body, origin) {
  return {
    client: cleanId(body.client),
    amount: body.amount,
    currency: body.currency,
    rail: body.rail || "manual",
    reference: body.reference,
    note: body.note,
    recordedBy: "operator",
    occurredAt: nowIso(),
    origin,
  };
}


===== DELIVERY MIGRATION =====

-- Records silent failures in the funnel pipe: rejected Typeform webhooks
-- (bad signature or unparseable payload) and failed Kit API deliveries.
-- Nothing here blocks the original request path â€” it's write-only telemetry
-- for the operator (see functions/api/health.js and the campaign board).
-- Run once against the pulsify-portal D1 database.

CREATE TABLE IF NOT EXISTS delivery_failures (
  id     INTEGER PRIMARY KEY AUTOINCREMENT,
  client TEXT NOT NULL,
  kind   TEXT NOT NULL,
  detail TEXT,
  at     TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_delivery_failures_client_at ON delivery_failures (client, at);


===== INTEGRATIONS MIGRATION =====

-- Integrations hub I1: operator/client connections, webhook event log, payments,
-- and client lifecycle status.

ALTER TABLE client_config ADD COLUMN status TEXT DEFAULT 'prospect';

CREATE TABLE IF NOT EXISTS integrations (
  scope       TEXT NOT NULL,
  client_id   TEXT NOT NULL DEFAULT '',
  provider    TEXT NOT NULL,
  config_json TEXT,
  secret_json TEXT,
  created_at  TEXT NOT NULL,
  updated_at  TEXT NOT NULL,
  PRIMARY KEY (scope, client_id, provider)
);

CREATE TABLE IF NOT EXISTS integration_events (
  id                   INTEGER PRIMARY KEY AUTOINCREMENT,
  provider             TEXT NOT NULL,
  kind                 TEXT NOT NULL,
  client               TEXT,
  external_id          TEXT,
  payload_summary_json TEXT NOT NULL,
  ts                   TEXT NOT NULL
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_integration_events_external
  ON integration_events (provider, kind, external_id)
  WHERE external_id IS NOT NULL;

CREATE INDEX IF NOT EXISTS idx_integration_events_client_ts
  ON integration_events (client, ts);

CREATE TABLE IF NOT EXISTS payments (
  id           INTEGER PRIMARY KEY AUTOINCREMENT,
  client       TEXT NOT NULL,
  amount_cents INTEGER NOT NULL,
  currency     TEXT NOT NULL,
  rail         TEXT NOT NULL,
  reference    TEXT NOT NULL UNIQUE,
  occurred_at  TEXT NOT NULL,
  recorded_by  TEXT NOT NULL,
  note         TEXT,
  created_at   TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_payments_client_occurred
  ON payments (client, occurred_at);


===== COMMON AUTH =====

export function json(object, status = 200, extraHeaders = {}) {
  return new Response(JSON.stringify(object), {
    status,
    headers: {
      "content-type": "application/json",
      "access-control-allow-origin": "*",
      "cache-control": "no-store",
      ...extraHeaders,
    },
  });
}

export function cleanId(value, fallback = "") {
  return String(value || "")
    .toLowerCase()
    .replace(/[^a-z0-9_-]/g, "")
    .slice(0, 64) || fallback;
}

export function hasOwn(object, key) {
  return Object.prototype.hasOwnProperty.call(object || {}, key);
}

export function parseJson(value, fallback = {}) {
  if (!value) return fallback;
  try {
    const parsed = JSON.parse(value);
    return parsed && typeof parsed === "object" ? parsed : fallback;
  } catch {
    return fallback;
  }
}

export function str(value) {
  return String(value ?? "").trim();
}

export function strOrNull(value) {
  const text = str(value);
  return text || null;
}

export function nowIso() {
  return new Date().toISOString();
}

export async function sha256Hex(value) {
  const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value));
  return [...new Uint8Array(digest)].map((b) => b.toString(16).padStart(2, "0")).join("");
}

export function checkAdmin(request, env) {
  if (!env.ADMIN_KEY) return json({ ok: false, error: "ADMIN_KEY not configured" }, 500);
  if (request.headers.get("x-admin-key") !== env.ADMIN_KEY) {
    return json({ ok: false, error: "unauthorized" }, 401);
  }
  return null;
}

export function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#39;");
}

export function titleCase(slug) {
  return String(slug || "")
    .split(/[-_]+/)
    .filter(Boolean)
    .map((part) => part[0].toUpperCase() + part.slice(1))
    .join(" ") || "Pulsify";
}

export function generateOpaqueToken(byteLength = 18) {
  const bytes = new Uint8Array(byteLength);
  crypto.getRandomValues(bytes);
  let binary = "";
  for (const byte of bytes) binary += String.fromCharCode(byte);
  return btoa(binary).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}

export function constantTimeEqual(a, b) {
  if (!a || !b || a.length !== b.length) return false;
  let mismatch = 0;
  for (let i = 0; i < a.length; i += 1) mismatch |= a.charCodeAt(i) ^ b.charCodeAt(i);
  return mismatch === 0;
}

export function normalizeEmail(value) {
  const email = String(value || "").trim().toLowerCase();
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) ? email : null;
}

export function numberOrNull(value) {
  if (value == null || value === "") return null;
  const number = Number(value);
  return Number.isFinite(number) ? number : null;
}

export function amountToCents(value) {
  if (value == null || value === "") return null;
  if (typeof value === "number" && Number.isInteger(value)) return value;
  const number = Number(value);
  return Number.isFinite(number) ? Math.round(number * 100) : null;
}

export function centsToAmount(cents) {
  return (Number(cents || 0) / 100).toFixed(2);
}

export function humanCurrency(amountCents, currency) {
  const normalized = String(currency || "USD").toUpperCase();
  return `${centsToAmount(amountCents)} ${normalized}`;
}


