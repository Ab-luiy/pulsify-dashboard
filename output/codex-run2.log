              <strong>${esc(row.topic || row.type || "Sequence")}</strong>
              <div class="sequence-meta">${esc(row.type || "sequence")} | ${esc(row.posted_on || "")} | ${row.dms == null ? "DMs not logged" : `${number(row.dms)} DMs`}</div>
