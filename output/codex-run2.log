    .empty-card,
    .list-card,
    .todo-card,
    .studio-card,
    .slide-card,
    .history-card,
    .review-card,
    .manual-card,
    .performance-card,
    .content-item,
    .history-item,
    .sequence-row,
    .weekly-metric,
    .mix-chip,
    .snapshot-item {
      background: var(--ui-panel);
      border: 1px solid var(--ui-line);
      border-radius: 18px;
      box-shadow: var(--ui-shadow-sm);
    }
    .metric {
      padding: 19px 20px;
      transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }
    .metric:hover {
      transform: translateY(-3px);
      box-shadow: var(--ui-shadow-md);
      border-color: var(--ui-line-2);
    }
    .metric span {
      display: block;
      color: var(--ui-muted);
      font-size: 11px;
      font-weight: 700;
      margin-bottom: 9px;
      text-transform: uppercase;
      letter-spacing: .08em;
    }
    .metric strong { display: block; font-size: 30px; letter-spacing: -.05em; }
    .metric small { display: block; color: var(--ui-muted); font-size: 11px; margin-top: 9px; }
    .card-head {
      padding: 18px 20px;
      border-bottom: 1px solid var(--ui-line);
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
    }
    .card-head h3 { margin: 0; font-size: 15px; }
    .table-wrap { overflow: auto; }
    table { width: 100%; min-width: 680px; border-collapse: collapse; }
    th,
    td {
      text-align: left;
      padding: 13px 20px;
      border-top: 1px solid var(--ui-line);
      font-size: 12.5px;
      vertical-align: top;
    }
    th {
      color: var(--ui-muted);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
      background: color-mix(in srgb, var(--ui-panel-2) 92%, transparent);
    }
    td:nth-child(2),
    td:nth-child(4),
    .sequence-bar span,
    .weekly-metric span,
    .mix-chip span,
    .snapshot-item span,
    .hint-text,
    code.inline {
      font-family: var(--ui-font-mono);
      font-variant-numeric: tabular-nums;
    }
    .amount { font-weight: 800; }
    .muted { color: var(--ui-muted); }
    .empty-card,
    .pending-card {
      padding: 34px 28px;
      text-align: center;
    }
    .empty-card h3,
    .pending-card h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -.03em; }
    .empty-card p,
    .pending-card p { margin: 0; color: var(--ui-ink-2); font-size: 14px; line-height: 1.62; }
    .stack,
    .history-list,
    .review-list,
    .slide-list,
    .photo-list,
    .weekly-metric-list,
    .mix-list,
    .snapshot-list,
    .sequence-list,
    .content-list { display: grid; gap: 14px; }
    .list-card,
    .todo-card,
    .studio-card,
    .history-card,
    .review-card,
    .manual-card,
    .performance-card { padding: 20px; }
    .list-card h3,
    .todo-card h3,
    .studio-card h3,
    .history-card h3,
    .manual-card h3,
    .performance-card h3 {
      margin: 0 0 14px;
      font-size: 18px;
      letter-spacing: -.03em;
    }
    .list-card ul,
    .todo-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .list-card li,
    .todo-card li,
    .type-card,
    .photo-box,
    .review-note,
    .slide-card,
    .content-item,
    .history-item,
    .weekly-metric,
    .mix-chip,
    .snapshot-item,
    .sequence-row {
      padding: 14px;
      background: color-mix(in srgb, var(--ui-panel-2) 92%, transparent);
    }
    .item-title { display: block; font-weight: 800; margin-bottom: 4px; }
    .item-note,
    .history-item p,
    .review-card p,
    .manual-card p,
    .studio-card p,
    .slide-card p,
    .weekly-metric span,
    .mix-chip span,
    .snapshot-item span,
    .sequence-row p,
    .sequence-meta,
    .hint-text,
    .photo-item span,
    .empty-inline { color: var(--ui-ink-2); font-size: 12px; line-height: 1.58; }
    .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .todo-row { display: flex; align-items: flex-start; gap: 12px; }
    .todo-row input,
    .photo-item input { margin-top: 4px; accent-color: var(--ui-accent); }
    .todo-meta { margin-top: 6px; color: var(--ui-muted); font-size: 11.5px; }
    .todo-done .item-title,
    .todo-done .item-note { text-decoration: line-through; opacity: .7; }
    .pending-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      background:
        radial-gradient(circle at top, rgba(14, 169, 104, .14), transparent 45%),
        linear-gradient(140deg, color-mix(in srgb, var(--ui-panel) 94%, transparent), color-mix(in srgb, var(--ui-panel-2) 96%, transparent));
    }
    .pending-pill,
    .status-pill,
    .pill,
    .diagnostic-badge,
    code.inline {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      max-width: 100%;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--ui-panel-2);
      color: var(--ui-ink-2);
      font-size: 11px;
      font-weight: 800;
      line-height: 1.25;
      border: 1px solid transparent;
    }
    .status-pill.draft { background: var(--ui-indigo-soft); color: var(--ui-indigo); }
    .status-pill.review,
    .diagnostic-badge { background: var(--ui-amber-soft); color: var(--ui-amber); }
    .status-pill.approved,
    .diagnostic-badge.healthy { background: var(--ui-accent-soft); color: var(--ui-accent); }
    .status-pill.rejected { background: var(--ui-rose-soft); color: var(--ui-rose); }
    .diagnostic-badge {
      white-space: normal;
      text-transform: none;
      letter-spacing: 0;
      overflow-wrap: anywhere;
    }
    .studio-grid,
    .performance-grid {
      display: grid;
      grid-template-columns: minmax(320px, 380px) minmax(0, 1fr);
      gap: 16px;
      align-items: start;
    }
    .field-grid { display: grid; gap: 12px; }
    .field-grid.two,
    .type-grid,
    .sequence-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .field-grid label { display: grid; gap: 7px; font-size: 12px; font-weight: 700; }
    .field-grid input,
    .field-grid select,
    .field-grid textarea,
    .manual-card textarea,
    .paste-box textarea {
      width: 100%;
      border: 1px solid var(--ui-line);
      border-radius: 14px;
      background: color-mix(in srgb, var(--ui-panel) 88%, transparent);
      color: var(--ui-ink);
      padding: 12px 13px;
    }
    .field-grid textarea { resize: vertical; min-height: 110px; }
    .manual-card textarea,
    .paste-box textarea {
      margin-top: 12px;
      min-height: 190px;
      font: 12px/1.62 var(--ui-font-mono);
      font-variant-numeric: tabular-nums;
    }
    .type-card { cursor: pointer; text-align: left; transition: border-color .16s ease, transform .16s ease, background .16s ease; }
    .type-card strong { display: block; font-size: 13px; }
    .type-card span { display: block; margin-top: 5px; color: var(--ui-ink-2); font-size: 11.5px; line-height: 1.45; }
    .type-card.active {
      border-color: color-mix(in srgb, var(--ui-accent) 55%, var(--ui-line));
      background: linear-gradient(140deg, var(--ui-accent-soft), color-mix(in srgb, var(--ui-panel-2) 94%, transparent));
    }
    .type-card:hover { transform: translateY(-1px); }
    .button-row,
    .inline-form-actions,
    .slide-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 14px;
    }
    .button-row button,
    .button-row .ghost-button,
    .history-card button,
    .slide-actions button,
    .inline-form-actions button {
      border: 0;
      border-radius: 12px;
      padding: 11px 14px;
      cursor: pointer;
      font: 800 12px var(--ui-font);
      transition: transform .18s ease, box-shadow .18s ease, opacity .18s ease;
    }
    .button-row button,
    .button-row button.secondary,
    .history-card button.secondary,
    .slide-actions button.secondary,
    .inline-form-actions button:not(.outline) {
      color: #042b1b;
      background: linear-gradient(135deg, var(--ui-accent), var(--ui-accent-2));
      box-shadow: 0 14px 28px -18px rgba(14, 169, 104, .78);
    }
    .button-row button.outline,
    .history-card button.outline,
    .slide-actions button.outline,
    .ghost-button,
    .inline-form-actions button.outline {
      background: var(--ui-panel);
      color: var(--ui-ink);
      border: 1px solid var(--ui-line);
      box-shadow: none;
    }
    .button-row button[disabled],
    .history-card button[disabled] { opacity: .6; cursor: wait; }
    .history-item.active {
      border-color: color-mix(in srgb, var(--ui-accent) 55%, var(--ui-line));
      background: var(--ui-accent-soft);
    }
    .history-item.editing {
      border-color: color-mix(in srgb, var(--ui-accent) 45%, var(--ui-line));
      background: color-mix(in srgb, var(--ui-accent-soft) 88%, var(--ui-panel));
    }
    .history-top,
    .review-top,
    .slide-head,
    .sequence-top {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: flex-start;
    }
    .history-item strong,
    .review-card strong,
    .weekly-metric strong,
    .mix-chip strong,
    .snapshot-item strong { display: block; font-size: 13px; }
    .slide-number {
      color: var(--ui-indigo);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .pill-list,
    .content-meta,
    .snapshot-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    .pill { background: var(--ui-indigo-soft); color: var(--ui-indigo); }
    .photo-box strong,
    .review-note strong,
    .manual-card strong { display: block; font-size: 12px; }
    .sequence-strip {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(24px, 1fr));
      gap: 6px;
      margin: 12px 0;
    }
    .sequence-bar {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      min-height: 62px;
      padding-bottom: 8px;
      border-radius: 10px;
      background: color-mix(in srgb, var(--ui-accent) 10%, transparent);
      position: relative;
      overflow: hidden;
    }
    .sequence-bar i {
      position: absolute;
      inset: auto 0 0 0;
      background: linear-gradient(180deg, var(--ui-accent-2), var(--ui-accent));
      opacity: .95;
    }
    .sequence-bar span { position: relative; color: var(--ui-ink); font-size: 10px; font-weight: 800; }
    .photo-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      padding: 10px 0;
      border-top: 1px solid var(--ui-line);
    }
    .photo-item:first-child { border-top: 0; }
    .empty-inline { color: var(--ui-muted); font-size: 12px; }
    code.inline {
      padding: 2px 8px;
      background: var(--ui-indigo-soft);
      color: var(--ui-indigo);
      font-size: 11px;
      border: 0;
    }
    @media (max-width: 1100px) {
      .studio-grid,
      .performance-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 980px) {
      #app { display: block; }
      .rail {
        position: sticky;
        z-index: 20;
        height: auto;
        padding: 10px 12px 12px;
      }
      .top-inner { padding: 0 0 10px; }
      #tabs {
        flex-direction: row;
        overflow: auto;
        padding-top: 10px;
      }
      .nav-group-h { display: none; }
      .tab-btn { width: auto; flex: 0 0 auto; }
      .rail-actions { grid-template-columns: 1fr 1fr; }
      main { padding: 24px 16px 60px; }
      .metric-grid,
      .two-col,
      .field-grid.two,
      .type-grid,
      .sequence-summary { grid-template-columns: 1fr; }
    }
    @media (max-width: 390px) {
      .rail-actions { grid-template-columns: 1fr; }
      main { padding-inline: 12px; }
      .message,
      .list-card,
      .todo-card,
      .studio-card,
      .history-card,
      .review-card,
      .manual-card,
      .performance-card,
      .card,
      .metric,
      .empty-card,
      .pending-card { padding-left: 16px; padding-right: 16px; }
    }
  </style>
</head>
<body>
  <div id="app">
    <aside class="rail rail-shell">
      <div class="top-inner">
        <div class="brand">
          <div class="brand-lockup">
            <span class="brand-mark" aria-hidden="true">P</span>
            <div class="brand-copy">
              <div class="brand-name">Pulsify dashboard</div>
            </div>
          </div>
          <div>
            <div class="client-name" id="clientName">Loading</div>
          </div>
        </div>
        <div class="client-subtitle" id="clientSubtitle">Private client workspace</div>
      </div>
      <nav id="tabs">
        <div class="nav-group-h">Dashboard</div>
        <button class="tab-btn nav-item active" data-tab="revenue" type="button">Revenue</button>
        <button class="tab-btn nav-item" data-tab="content" type="button">Content</button>
        <button class="tab-btn nav-item" data-tab="performance" type="button">Performance</button>
        <button class="tab-btn nav-item" data-tab="team" type="button">Team</button>
        <button class="tab-btn nav-item" data-tab="momentum" type="button">Momentum</button>
        <div class="nav-group-h">Execution</div>
        <button class="tab-btn nav-item" data-tab="plans" type="button">Plans</button>
        <button class="tab-btn nav-item" data-tab="todos" type="button">To-dos</button>
        <button class="tab-btn nav-item" data-tab="studio" type="button">Studio</button>
      </nav>
      <div class="rail-actions">
        <button class="theme-btn nav-item" id="themeButton" type="button">Switch theme</button>
        <button class="logout-btn nav-item" id="logoutButton" type="button">Log out</button>
      </div>
    </aside>

    <main>
      <div class="message" id="message" hidden></div>

      <section class="panel active" id="panel-revenue">
        <div class="panel-head">
          <div>
            <h2>Revenue</h2>
            <div class="panel-note">Read-only from the live payments table.</div>
          </div>
          <div class="panel-note" id="revenueUpdated">Waiting on data</div>
        </div>
        <div class="metric-grid" id="revenueMetrics"></div>
        <div class="card" id="paymentsCard">
          <div class="card-head">
            <h3>Payment history</h3>
            <span class="panel-note" id="paymentCount">0 payments</span>
          </div>
          <div class="table-wrap" id="paymentsTableWrap">
            <table>
              <thead>
                <tr><th>When</th><th>Amount</th><th>Rail</th><th>Reference</th><th>Note</th></tr>
              </thead>
              <tbody id="paymentRows"></tbody>
            </table>
          </div>
          <div class="empty-card" id="paymentsEmpty" hidden>
            <h3>No payments recorded yet</h3>
            <p>Revenue appears here as soon as Pulsify records a verified payment for this client.</p>
          </div>
        </div>
      </section>

      <section class="panel" id="panel-content">
        <div class="panel-head"><div><h2>Content</h2><div class="panel-note">Read-only pipeline items already saved for this client.</div></div></div>
        <div id="contentSection"></div>
      </section>

      <section class="panel" id="panel-performance">
        <div class="panel-head">
          <div>
            <h2>Performance</h2>
            <div class="panel-note">Manual story tracking now runs here. Week over week only.</div>
          </div>
          <div class="panel-note" id="performanceStatus">Waiting on metrics</div>
        </div>
        <div class="performance-grid">
          <div class="stack">
            <div class="performance-card">
              <h3>Log a sequence</h3>
              <div class="field-grid">
                <div class="field-grid two">
                  <label for="sequenceDateInput">Date
                    <input id="sequenceDateInput" type="date">
                  </label>
                  <label for="sequenceTypeSelect">Type
                    <select id="sequenceTypeSelect"></select>
                  </label>
                </div>
                <label for="sequenceTopicInput">Topic
                  <input id="sequenceTopicInput" placeholder="What was this sequence about?">
                </label>
                <div class="field-grid two">
                  <label for="sequenceSlideCountInput">Slide count
                    <input id="sequenceSlideCountInput" type="number" min="1" max="30" value="8">
                  </label>
                  <label for="sequenceViewsInput">Per-slide views
                    <input id="sequenceViewsInput" placeholder="1000, 400, 380, 370">
                  </label>
                </div>
                <div class="field-grid two">
                  <label for="sequenceDmsInput">DMs
                    <input id="sequenceDmsInput" type="number" min="0" placeholder="Optional">
                  </label>
                  <label for="sequenceProfileVisitsInput">Profile visits
                    <input id="sequenceProfileVisitsInput" type="number" min="0" placeholder="Optional">
                  </label>
                </div>
                <label for="sequenceNotesInput">Notes
                  <textarea id="sequenceNotesInput" placeholder="What mattered here?"></textarea>
                </label>
              </div>
              <div class="inline-form-actions">
                <button id="saveSequenceLogButton" type="button">Save sequence</button>
                <button class="outline" id="clearSequenceLogButton" type="button">Clear</button>
              </div>
            </div>

            <div class="performance-card">
              <h3>Log followers</h3>
              <div class="field-grid">
                <div class="field-grid two">
                  <label for="snapshotDateInput">Date
                    <input id="snapshotDateInput" type="date">
                  </label>
                  <label for="snapshotFollowersInput">Followers
                    <input id="snapshotFollowersInput" type="number" min="0" placeholder="Required">
                  </label>
                </div>
                <div class="field-grid two">
                  <label for="snapshotIcpLeadsInput">ICP leads
                    <input id="snapshotIcpLeadsInput" type="number" min="0" placeholder="Optional">
                  </label>
                  <label for="snapshotAvgViewsInput">Average views
                    <input id="snapshotAvgViewsInput" type="number" min="0" placeholder="Optional">
                  </label>
                </div>
                <label for="snapshotNotesInput">Notes
                  <textarea id="snapshotNotesInput" placeholder="What changed this week?"></textarea>
                </label>
              </div>
              <div class="inline-form-actions">
                <button id="saveSnapshotButton" type="button">Save snapshot</button>
              </div>
            </div>
          </div>

          <div class="stack">
            <div class="performance-card">
              <h3>Weekly card</h3>
              <div class="sequence-summary" id="performanceMetricGrid"></div>
              <div class="weekly-metric-list" id="performanceWeeklyList"></div>
              <div class="mix-list" id="performanceMixList"></div>
              <div class="snapshot-list" id="snapshotList"></div>
            </div>

            <div class="performance-card">
              <h3>Sequence log</h3>
              <div class="sequence-list" id="sequenceList"></div>
              <div class="empty-inline" id="sequenceListEmpty" hidden>No sequences logged yet.</div>
            </div>
          </div>
        </div>
      </section>

      <section class="panel" id="panel-team">
        <div class="panel-head"><div><h2>Team</h2><div class="panel-note">Operator-maintained from the admin console.</div></div></div>
        <div id="teamContent"></div>
      </section>

      <section class="panel" id="panel-momentum">
        <div class="panel-head"><div><h2>Momentum</h2><div class="panel-note">Operator-maintained weekly movement view.</div></div></div>
        <div id="momentumContent"></div>
      </section>

      <section class="panel" id="panel-plans">
        <div class="panel-head"><div><h2>Plans</h2><div class="panel-note">Operator-maintained roadmap and phase view.</div></div></div>
        <div id="plansContent"></div>
      </section>

      <section class="panel" id="panel-todos">
        <div class="panel-head"><div><h2>To-dos</h2><div class="panel-note">Check off the items you have finished. State saves back to the dashboard.</div></div></div>
        <div id="todosContent"></div>
      </section>

      <section class="panel" id="panel-studio">
        <div class="panel-head">
          <div>
            <h2>Studio</h2>
            <div class="panel-note">Draft the story sequence, send it for review, and keep approved sequences in one place.</div>
          </div>
          <div class="panel-note" id="studioStatus">Waiting on history</div>
        </div>

        <div class="studio-grid">
          <div class="stack">
            <div class="studio-card">
              <h3>Sequence builder</h3>
              <p>Pick a sequence type or describe the intent in plain English. The builder writes the prompt contract and returns a draft.</p>
              <div class="field-grid">
                <div>
                  <div class="panel-note">Type</div>
                  <div class="type-grid" id="typeGrid"></div>
                </div>
                <label for="intentInput">Intent
                  <textarea id="intentInput" placeholder="If you do not want to pick a type, describe what you want to talk about."></textarea>
                </label>
                <label for="topicInput">Topic
                  <input id="topicInput" placeholder="What is the exact topic of this sequence?">
                </label>
                <div class="field-grid two">
                  <label for="goalSelect">Goal
                    <select id="goalSelect">
                      <option value="reach">Reach</option>
                      <option value="dms">DMs</option>
                      <option value="booked calls">Booked calls</option>
                    </select>
                  </label>
                  <label for="slideCountInput">Slide count
                    <input id="slideCountInput" type="number" min="3" max="12" value="8">
                  </label>
                </div>
                <label for="triggerWordInput">Trigger word
                  <input id="triggerWordInput" placeholder="Required if you want a hard CTA">
                </label>
                <label for="proofLinesInput">Proof lines
                  <textarea id="proofLinesInput" placeholder="One proof line per row. Use only real proof and real numbers."></textarea>
                </label>
              </div>
              <div class="button-row" style="margin-top:16px">
                <button id="generateSequenceButton" class="secondary" type="button">Generate sequence</button>
              </div>
            </div>

            <div class="history-card">
              <h3>Sequence history</h3>
              <p>Open any prior draft, review state, or approved sequence.</p>
              <div class="history-list" id="historyList"></div>
              <div class="empty-inline" id="historyEmpty" hidden>No sequences saved yet.</div>
            </div>
          </div>

          <div class="stack" id="studioDetail">
            <div class="empty-card" id="studioEmpty">
              <h3>No sequence open yet</h3>
              <p>Generate a new sequence or open one from history. Manual-mode runs still save the prompt and can be sent for review after you draft the copy elsewhere.</p>
            </div>
          </div>
        </div>
      </section>
    </main>
  </div>

  <script>
    const params = new URLSearchParams(location.search);
    const initialToken = params.get("t") || "";
    if (initialToken) {
      sessionStorage.setItem("pulsify_portal_token", initialToken);
      const clean = new URL(location.href);
      clean.searchParams.delete("t");
      history.replaceState(null, "", clean.pathname + clean.search);
    }

    const TOKEN = sessionStorage.getItem("pulsify_portal_token") || "";
    const CLIENT = params.get("client") || "";
    const $ = (id) => document.getElementById(id);
    const STUDIO_TYPES = [
      ["value-driven", "Teach something genuinely useful."],
      ["credibility", "Stack proof and position the result."],
      ["q&a", "Answer the question your ICP already has."],
      ["day-in-the-life", "Document the day while carrying value."],
      ["breakdown", "Walk one topic step by step."],
      ["lifestyle", "Humanity without flex."],
      ["cta", "Run the conversion sequence."],
      ["start-here", "Build the permanent first highlight."],
      ["story launch", "Run the campaign story sequence."],
    ];
    const state = {
      client: CLIENT,
      sections: {},
      contentItems: [],
      performance: {
        rows: [],
        weekSummary: null,
        weeklyReport: null,
        latestSnapshot: null,
        priorSnapshot: null,
        editingSequenceId: null,
      },
      studio: {
        selectedType: "",
        rows: [],
        current: null,
      },
    };

    document.querySelectorAll(".tab-btn").forEach((button) => {
      button.addEventListener("click", () => openTab(button.dataset.tab));
    });
    $("themeButton").addEventListener("click", toggleTheme);
    $("logoutButton").addEventListener("click", logout);

    const dark = localStorage.getItem("pulsify_client_dashboard_theme") === "dark";
    document.body.classList.toggle("dark", dark);

    renderTypeGrid();
    renderSequenceTypeSelect();
    $("generateSequenceButton").addEventListener("click", generateSequence);
    $("saveSequenceLogButton").addEventListener("click", saveSequenceLog);
    $("clearSequenceLogButton").addEventListener("click", clearSequenceForm);
    $("saveSnapshotButton").addEventListener("click", saveSnapshot);
    setTodayDefaults();
    loadDashboard();

    async function loadDashboard() {
      try {
        const response = await fetch(`/api/client-dashboard?client=${encodeURIComponent(state.client)}`, {
          headers: authHeaders(),
          credentials: "same-origin",
        });
        if (response.status === 401 || response.status === 403) {
          redirectToLogin();
          return;
        }
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not load the dashboard.");
        renderDashboard(data);
        await Promise.all([loadStudioHistory(), loadPerformanceData()]);
      } catch (error) {
        showMessage(error.message || "Could not load the dashboard.");
      }
    }

    async function loadPerformanceData() {
      try {
        const [sequenceResponse, weeklyResponse] = await Promise.all([
          fetch(`/api/metrics-sequences?client=${encodeURIComponent(state.client)}`, {
            headers: authHeaders(),
            credentials: "same-origin",
          }),
          fetch(`/api/metrics-weekly?client=${encodeURIComponent(state.client)}`, {
            headers: authHeaders(),
            credentials: "same-origin",
          }),
        ]);
        if ([sequenceResponse, weeklyResponse].some((response) => response.status === 401 || response.status === 403)) {
          redirectToLogin();
          return;
        }
        const sequenceData = await sequenceResponse.json().catch(() => ({}));
        const weeklyData = await weeklyResponse.json().catch(() => ({}));
        if (!sequenceResponse.ok || !sequenceData.ok) throw new Error(sequenceData.error || "Could not load sequence metrics.");
        if (!weeklyResponse.ok || !weeklyData.ok) throw new Error(weeklyData.error || "Could not load the weekly report.");
        state.performance.rows = Array.isArray(sequenceData.rows) ? sequenceData.rows : [];
        state.performance.weekSummary = sequenceData.week_summary || null;
        state.performance.weeklyReport = weeklyData.report || null;
        state.performance.latestSnapshot = weeklyData.latest || null;
        state.performance.priorSnapshot = weeklyData.prior || null;
        renderPerformance();
      } catch (error) {
        $("performanceStatus").textContent = "Metrics unavailable";
        showMessage(error.message || "Could not load the performance metrics.");
      }
    }

    async function loadStudioHistory() {
      try {
        const response = await fetch("/api/studio-sequences", {
          headers: authHeaders(),
          credentials: "same-origin",
        });
        if (response.status === 401 || response.status === 403) {
          redirectToLogin();
          return;
        }
        const data = await response.json().catch(() => ({}));
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not load sequence history.");
        state.studio.rows = Array.isArray(data.rows) ? data.rows : [];
        state.studio.current = state.studio.current
          ? state.studio.rows.find((row) => row.id === state.studio.current.id) || state.studio.rows[0] || null
          : state.studio.rows[0] || null;
        renderHistory();
        renderCurrentSequence();
        $("studioStatus").textContent = `${state.studio.rows.length} sequence${state.studio.rows.length === 1 ? "" : "s"} saved`;
      } catch (error) {
        showMessage(error.message || "Could not load sequence history.");
        $("studioStatus").textContent = "History unavailable";
      }
    }

    function renderDashboard(data) {
      state.client = data.client;
      state.sections = data.sections || {};
      state.contentItems = Array.isArray(data.content_items) ? data.content_items : [];
      $("clientName").textContent = data.client_name || data.client;
      $("clientSubtitle").textContent = data.auth_mode === "token"
        ? "Private token access is active for this session."
        : "Signed in with saved client credentials.";
      const clean = new URL(location.href);
      clean.searchParams.set("client", state.client);
      history.replaceState(null, "", clean.pathname + clean.search);

      renderRevenue(data.revenue || {});
      renderContentSection();
      renderListSection("teamContent", "Team", state.sections.team, emptyText("No team records yet", "Pulsify will list the working team here as soon as the client setup is filled in."));
      renderListSection("plansContent", "Plans", state.sections.plans, emptyText("No plan loaded yet", "Pulsify will add the current roadmap here once the client plan is written."));
      renderMomentum("momentumContent", state.sections.momentum);
      renderTodos(state.sections.todos);
    }

    function renderContentSection() {
      const target = $("contentSection");
      if (!state.contentItems.length) {
        target.innerHTML = emptyText("No content items yet", "This section will show scheduled, in-production, and published work once items are saved in the operator console.");
        return;
      }
      target.innerHTML = `
        <div class="content-list">
          ${state.contentItems.map((item) => `
            <div class="content-item">
              <strong>${esc(item.title || "Untitled item")}</strong>
              <span class="hint-text">${esc(contentStageLabel(item.stage))}</span>
              ${item.notes ? `<p>${esc(item.notes)}</p>` : `<p>No extra note saved.</p>`}
              <div class="content-meta">
                <span>${esc(item.platform || "No platform")}</span>
                <span>${item.scheduled_for ? `Scheduled ${esc(item.scheduled_for)}` : `Updated ${date(item.updated_at)}`}</span>
                ${item.url ? `<span><a href="${esc(item.url)}" target="_blank" rel="noopener">Open link</a></span>` : ""}
              </div>
            </div>
          `).join("")}
        </div>
      `;
    }

    function renderRevenue(revenue) {
      const total = Number(revenue.total_revenue_cents || 0);
      const currentMonth = Number(revenue.current_month_revenue_cents || 0);
      const payments = revenue.payments || [];
      $("revenueUpdated").textContent = `Updated ${new Date().toLocaleTimeString()}`;
      $("revenueMetrics").innerHTML = [
        metricCard("Total cash collected", currency(total), "all recorded payments"),
        metricCard("This month", currency(currentMonth), "recorded in the current month"),
        metricCard("Payment count", number(payments.length), "verified rows in the payments table"),
      ].join("");
      $("paymentCount").textContent = `${payments.length} payment${payments.length === 1 ? "" : "s"}`;
      $("paymentsEmpty").hidden = payments.length > 0;
      $("paymentsTableWrap").hidden = payments.length === 0;
      $("paymentRows").innerHTML = payments.map((payment) => `
        <tr>
          <td>${date(payment.occurred_at)}</td>
          <td class="amount">${currency(payment.amount_cents, payment.currency)}</td>
          <td>${esc(payment.rail || "Manual")}</td>
          <td><span class="muted">${esc(payment.reference || "-")}</span></td>
          <td>${esc(payment.note || "-")}</td>
        </tr>
      `).join("");
    }

    function renderTypeGrid() {
      $("typeGrid").innerHTML = STUDIO_TYPES.map(([type, note]) => `
        <button class="type-card${state.studio.selectedType === type ? " active" : ""}" type="button" data-sequence-type="${type}">
          <strong>${esc(type)}</strong>
          <span>${esc(note)}</span>
        </button>
      `).join("");
      document.querySelectorAll("[data-sequence-type]").forEach((button) => {
        button.addEventListener("click", () => {
          state.studio.selectedType = button.dataset.sequenceType === state.studio.selectedType ? "" : button.dataset.sequenceType;
          renderTypeGrid();
        });
      });
    }

    function renderSequenceTypeSelect() {
      $("sequenceTypeSelect").innerHTML = STUDIO_TYPES.map(([type]) => `
        <option value="${esc(type)}">${esc(type)}</option>
      `).join("");
    }

    async function generateSequence() {
      const payload = {
        type: state.studio.selectedType || "",
        intent: $("intentInput").value.trim(),
        topic: $("topicInput").value.trim(),
        goal: $("goalSelect").value,
        trigger_word: $("triggerWordInput").value.trim(),
        proof_lines: $("proofLinesInput").value.split(/\r?\n/).map((line) => line.trim()).filter(Boolean),
        slide_count: Number($("slideCountInput").value || 8),
      };
      if (!payload.type && !payload.intent) {
        showMessage("Pick a type or write the intent.");
        openTab("studio");
        return;
      }
      if (!payload.topic) {
        showMessage("Topic is required.");
        openTab("studio");
        return;
      }
      const button = $("generateSequenceButton");
      button.disabled = true;
      showMessage("Generating sequence...");
      try {
        const response = await fetch("/api/studio-generate", {
          method: "POST",
          headers: {
            ...authHeaders(),
            "content-type": "application/json",
          },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));
        if (response.status === 401 || response.status === 403) {
          redirectToLogin();
          return;
        }
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not generate the sequence.");
        await loadStudioHistory();
        state.studio.current = state.studio.rows.find((row) => row.id === data.id) || state.studio.current;
        renderHistory();
        renderCurrentSequence();
        showMessage(data.mode === "manual"
          ? "No LLM key is configured here. The manual prompt was saved and is ready to copy."
          : (data.warning ? data.warning : "Sequence draft generated."), data.warning ? "warning" : "success");
        openTab("studio");
      } catch (error) {
        showMessage(error.message || "Could not generate the sequence.");
      } finally {
        button.disabled = false;
      }
    }

    function renderPerformance() {
      const rows = state.performance.rows;
      const summary = state.performance.weekSummary || {};
      const report = state.performance.weeklyReport || {};
      const latest = state.performance.latestSnapshot;
      const prior = state.performance.priorSnapshot;

      $("performanceStatus").textContent = rows.length
        ? `${rows.length} sequence${rows.length === 1 ? "" : "s"} logged`
        : "No sequences logged yet";

      $("performanceMetricGrid").innerHTML = [
        metricCard("This week", `${number(summary.sequences_this_week || 0)}`, `${number(summary.cadence_floor || 3)} minimum, ${number(summary.cadence_target_min || 5)}-${number(summary.cadence_target_max || 7)} target`),
        metricCard("Last week", `${number(summary.sequences_last_week || 0)}`, summary.cadence_status || "week status"),
      ].join("");

      $("performanceWeeklyList").innerHTML = [
        renderWeeklyMetric("Followers", report.followers),
        renderWeeklyMetric("ICP leads", report.icp_leads),
        renderWeeklyMetric("Follower to view", report.follower_to_view_ratio, "", true),
        renderWeeklyMetric("Dollars per follower", report.dollars_per_follower),
      ].join("");

      $("performanceMixList").innerHTML = `
        <div class="mix-chip">
          <strong>Cadence status</strong>
          <span>${esc(`${number(summary.sequences_this_week || 0)} of ${number(summary.cadence_floor || 3)} minimum this week`)}</span>
        </div>
        <div class="mix-chip">
          <strong>This week type mix</strong>
          <span>${esc(formatTypeMix(summary.type_mix_current_week))}</span>
        </div>
        <div class="mix-chip">
          <strong>Last week type mix</strong>
          <span>${esc(formatTypeMix(summary.type_mix_prior_week))}</span>
        </div>
      `;

      $("snapshotList").innerHTML = [latest, prior].filter(Boolean).map((snapshot, index) => `
        <div class="snapshot-item">
          <strong>${index === 0 ? "Latest snapshot" : "Prior snapshot"}</strong>
          <span>${esc(snapshot.taken_on || "")}</span>
          <div class="snapshot-meta">
            <span>${number(snapshot.followers)} followers</span>
            <span>${snapshot.icp_leads == null ? "ICP leads not logged" : `${number(snapshot.icp_leads)} ICP leads`}</span>
            <span>${snapshot.avg_views == null ? "Average views not logged" : `${number(snapshot.avg_views)} avg views`}</span>
          </div>
          ${snapshot.notes ? `<p>${esc(snapshot.notes)}</p>` : ""}
        </div>
      `).join("") || `<div class="empty-inline">No snapshots saved yet.</div>`;

      $("sequenceList").innerHTML = rows.map((row) => renderSequenceRow(row)).join("");
      $("sequenceListEmpty").hidden = rows.length > 0;
      document.querySelectorAll("[data-edit-sequence]").forEach((button) => {
        button.addEventListener("click", () => loadSequenceIntoForm(Number(button.dataset.editSequence)));
      });
    }

    async function saveSequenceLog() {
      try {
        const payload = {
          id: state.performance.editingSequenceId || undefined,
          posted_on: $("sequenceDateInput").value,
          type: $("sequenceTypeSelect").value,
          topic: $("sequenceTopicInput").value.trim(),
          slide_count: Number($("sequenceSlideCountInput").value || 0),
          slide_views: parseViewsInput($("sequenceViewsInput").value),
          dms: $("sequenceDmsInput").value.trim(),
          profile_visits: $("sequenceProfileVisitsInput").value.trim(),
          notes: $("sequenceNotesInput").value.trim(),
        };
        const response = await fetch("/api/metrics-sequences", {
          method: "POST",
          headers: {
            ...authHeaders(),
            "content-type": "application/json",
          },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));
        if (response.status === 401 || response.status === 403) {
          redirectToLogin();
          return;
        }
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not save the sequence log.");
        clearSequenceForm();
        await loadPerformanceData();
        showMessage(data.updated ? "Sequence log updated." : "Sequence logged.", "success");
      } catch (error) {
        showMessage(error.message || "Could not save the sequence log.");
      }
    }

    async function saveSnapshot() {
      try {
        const payload = {
          taken_on: $("snapshotDateInput").value,
          followers: $("snapshotFollowersInput").value.trim(),
          icp_leads: $("snapshotIcpLeadsInput").value.trim(),
          avg_views: $("snapshotAvgViewsInput").value.trim(),
          notes: $("snapshotNotesInput").value.trim(),
        };
        const response = await fetch("/api/metrics-weekly", {
          method: "POST",
          headers: {
            ...authHeaders(),
            "content-type": "application/json",
          },
          credentials: "same-origin",
          body: JSON.stringify(payload),
        });
        const data = await response.json().catch(() => ({}));
        if (response.status === 401 || response.status === 403) {
          redirectToLogin();
          return;
        }
        if (!response.ok || !data.ok) throw new Error(data.error || "Could not save the snapshot.");
        clearSnapshotForm();
        await loadPerformanceData();
        showMessage("Snapshot saved.", "success");
      } catch (error) {
        showMessage(error.message || "Could not save the snapshot.");
      }
    }

    function loadSequenceIntoForm(id) {
      const row = state.performance.rows.find((item) => item.id === id);
      if (!row) return;
      state.performance.editingSequenceId = id;
      $("sequenceDateInput").value = row.posted_on || "";
      $("sequenceTypeSelect").value = row.type || STUDIO_TYPES[0][0];
      $("sequenceTopicInput").value = row.topic || "";
      $("sequenceSlideCountInput").value = row.slide_count || row.slide_views.length || 1;
      $("sequenceViewsInput").value = Array.isArray(row.slide_views) ? row.slide_views.join(", ") : "";
      $("sequenceDmsInput").value = row.dms == null ? "" : row.dms;
      $("sequenceProfileVisitsInput").value = row.profile_visits == null ? "" : row.profile_visits;
      $("sequenceNotesInput").value = row.notes || "";
      renderPerformance();
      openTab("performance");
      showMessage("Editing sequence log entry.");
    }

    function clearSequenceForm() {
      state.performance.editingSequenceId = null;
      $("sequenceDateInput").value = todayIso();
      $("sequenceTypeSelect").value = STUDIO_TYPES[0][0];
      $("sequenceTopicInput").value = "";
      $("sequenceSlideCountInput").value = 8;
      $("sequenceViewsInput").value = "";
      $("sequenceDmsInput").value = "";
      $("sequenceProfileVisitsInput").value = "";
      $("sequenceNotesInput").value = "";
      renderPerformance();
    }

    function clearSnapshotForm() {
      $("snapshotDateInput").value = todayIso();
      $("snapshotFollowersInput").value = "";
      $("snapshotIcpLeadsInput").value = "";
      $("snapshotAvgViewsInput").value = "";
      $("snapshotNotesInput").value = "";
    }

    function setTodayDefaults() {
      $("sequenceDateInput").value = todayIso();
      $("snapshotDateInput").value = todayIso();
      $("sequenceTypeSelect").value = STUDIO_TYPES[0][0];
    }

    function renderHistory() {
      $("historyList").innerHTML = state.studio.rows.map((row) => `
        <div class="history-item${state.studio.current?.id === row.id ? " active" : ""}">
          <div class="history-top">
            <div>
              <strong>${esc(row.topic || row.type || "Sequence")}</strong>
              <p>${esc(row.type || row.intent || "sequence")} Â· ${esc(row.goal || "reach")}</p>
            </div>
            <span class="status-pill ${esc(row.status || "draft")}">${esc(labelStatus(row.status))}</span>
          </div>
          <p>Updated ${relativeTime(row.updated_at)}</p>
          <div class="button-row" style="margin-top:12px">
            <button class="outline" type="button" data-open-sequence="${row.id}">Open</button>
            ${row.status === "draft" || row.status === "rejected"
              ? `<button class="secondary" type="button" data-submit-review="${row.id}">Send for review</button>`
              : ""}
            ${row.status === "draft"
              ? `<button class="outline" type="button" data-delete-sequence="${row.id}">Delete draft</button>`
              : ""}
          </div>
        </div>
      `).join("");
      $("historyEmpty").hidden = state.studio.rows.length > 0;
      document.querySelectorAll("[data-open-sequence]").forEach((button) => {
        button.addEventListener("click", () => {
          state.studio.current = state.studio.rows.find((row) => row.id === Number(button.dataset.openSequence)) || null;
          renderHistory();
          renderCurrentSequence();
        });
      });
      document.querySelectorAll("[data-submit-review]").forEach((button) => {
        button.addEventListener("click", () => submitForReview(Number(button.dataset.submitReview)));
      });
      document.querySelectorAll("[data-delete-sequence]").forEach((button) => {
        button.addEventListener("click", () => deleteDraft(Number(button.dataset.deleteSequence)));
      });
    }

    function renderCurrentSequence() {
      const target = $("studioDetail");
      const row = state.studio.current;
      if (!row) {
        target.innerHTML = `<div class="empty-card" id="studioEmpty"><h3>No sequence open yet</h3><p>Generate a new sequence or open one from history.</p></div>`;
        return;
      }

      const slides = Array.isArray(row.output?.slides) ? row.output.slides : [];
      const hooks = Array.isArray(row.output?.hooks) ? row.output.hooks : [];
      target.innerHTML = `
        <div class="review-card">
          <div class="review-top">
            <div>
              <strong>${esc(row.topic || "Sequence")}</strong>
              <p>${esc(row.type || row.intent || "sequence")} Â· ${esc(row.goal || "reach")}</p>
            </div>
            <span class="status-pill ${esc(row.status || "draft")}">${esc(labelStatus(row.status))}</span>
          </div>
          <div class="button-row" style="margin-top:14px">
            <button class="outline" type="button" id="copyAllButton">Copy all slides</button>
            ${row.manual_prompt ? `<button class="outline" type="button" id="copyManualPromptButton">Copy manual prompt</button>` : ""}
          </div>
          ${row.review_note ? `<div class="review-note"><strong>Review note</strong><p>${esc(row.review_note)}</p></div>` : ""}
        </div>
        ${row.manual_prompt && !slides.length ? `
          <div class="manual-card">
            <h3>Manual prompt</h3>
            <p>No model output was returned here, so the contract prompt is saved for copy-paste.</p>
            <textarea readonly id="manualPromptBox">${esc(row.manual_prompt)}</textarea>
          </div>
        ` : ""}
        <div class="manual-card paste-box">
          <h3>Paste finished sequence</h3>
          <p>Paste the final Claude-written output here. Valid JSON is stored as-is. Everything else is saved as raw text and sent to review.</p>
          <textarea id="finishedSequenceInput" placeholder='Paste the final sequence JSON or raw text'></textarea>
          <div class="inline-form-actions">
            <button id="saveFinishedSequenceButton" type="button">Save finished sequence</button>
          </div>
        </div>
        ${hooks.length ? `
          <div class="studio-card">
            <h3>Hook alternates</h3>
            <div class="pill-list">${hooks.map((hook) => `<span class="pill">${esc(hook)}</span>`).join("")}</div>
            <p>${esc(row.output?.why_order || "")}</p>
            <p>${esc(row.output?.posting_note || "")}</p>
          </div>
        ` : ""}
        ${slides.length ? `
          <div class="studio-card">
            <h3>Photo checklist</h3>
            <div class="photo-list" id="photoList">
              ${slides.map((slide) => `
                <label class="photo-item">
                  <input type="checkbox" data-photo-check="${row.id}-${slide.n}" ${isPhotoChecked(row.id, slide.n) ? "checked" : ""}>
                  <span><strong>Slide ${Number(slide.n || 0)}</strong><br>${esc(slide.photo?.primary || "")}<br>${slide.photo?.alternative ? `Alternative: ${esc(slide.photo.alternative)}` : ""}</span>
                </label>
              `).join("")}
            </div>
            <p>Uploads are not wired in v1. The existing media path is admin-only, not client-scoped.</p>
          </div>
        ` : ""}
        <div class="slide-list">
          ${slides.map((slide) => `
            <div class="slide-card">
              <div class="slide-head">
                <div>
                  <div class="slide-number">Slide ${Number(slide.n || 0)}</div>
                  <strong>${esc(slide.job || "")}</strong>
                </div>
                <span class="status-pill draft">${esc(slide.interactive || "none")}</span>
              </div>
              <div class="pill-list">${(slide.text_pills || []).map((pill) => `<span class="pill">${esc(pill)}</span>`).join("") || `<span class="pill">No pills returned</span>`}</div>
              ${slide.emphasis ? `<p><strong>Emphasis:</strong> ${esc(slide.emphasis)}</p>` : ""}
              <div class="photo-box">
                <strong>Photo request</strong>
                <p>${esc(slide.photo?.primary || "")}</p>
                ${slide.photo?.alternative ? `<p>Alternative: ${esc(slide.photo.alternative)}</p>` : ""}
              </div>
              <div class="slide-actions">
                <button class="outline" type="button" data-copy-slide="${row.id}-${slide.n}">Copy slide</button>
              </div>
            </div>
          `).join("") || `
            <div class="empty-card">
              <h3>No structured slide output</h3>
              <p>This draft only has the manual prompt or a raw model response. Use the prompt and paste the final copy back through a new run.</p>
            </div>
          `}
        </div>
      `;

      const copyAllButton = $("copyAllButton");
      if (copyAllButton) {
        copyAllButton.addEventListener("click", async () => {
          const copied = await copyText(formatSequenceForCopy(row));
          showMessage(copied ? "All slides copied." : "Copy failed. Select the text manually.", copied ? "success" : undefined);
        });
      }
      const copyManualPromptButton = $("copyManualPromptButton");
      if (copyManualPromptButton) {
        copyManualPromptButton.addEventListener("click", async () => {
          const copied = await copyText(row.manual_prompt || "");
