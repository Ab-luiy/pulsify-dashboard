import { onRequestPost as generatePost } from './output/standard-preview/functions/api/studio-generate.js';
import { onRequestPost as sequencesPost } from './output/standard-preview/functions/api/studio-sequences.js';
import { sha256Hex } from './output/standard-preview/functions/_shared/common.js';

const allowedImageClasses = new Set(['proof-screenshot', 'device-mockup', 'proof-wall', 'real-workspace']);

function makeDb(tokenHash) {
  const db = {
    tokenHash,
    sequences: [],
    nextId: 1,
    prepare(sql) {
      const normalized = sql.replace(/\\s+/g, ' ').trim();
      return {
        values: [],
        bind(...values) {
          this.values = values;
          return this;
        },
        async first() {
          if (normalized.includes('FROM client_config') && normalized.includes('portal_token_hash')) {
            return this.values[0] === db.tokenHash ? { client: 'demo', client_name: 'Demo Client' } : null;
          }
          if (normalized.includes('FROM client_config') && normalized.includes('WHERE client=?')) {
            return { client: 'demo', client_name: 'Demo Client', page_content_json: JSON.stringify({ AUDIENCE_PILL: 'coaches', HEADLINE_LINE_ONE: 'Help students win' }) };
          }
          if (normalized.includes('SELECT id, client_id, status FROM studio_sequences WHERE id=?')) {
            return db.sequences.find((row) => row.id === Number(this.values[0])) || null;
          }
          throw new Error('Unhandled first SQL: ' + normalized);
        },
        async all() {
          if (normalized.includes('FROM client_dashboard_content')) return { results: [] };
          if (normalized.includes('FROM studio_sequences') && normalized.includes('WHERE client_id=?')) {
            return { results: db.sequences.filter((row) => row.client_id === this.values[0]) };
          }
          if (normalized.includes(\"WHERE status='review'\")) {
            return { results: db.sequences.filter((row) => row.status === 'review') };
          }
          throw new Error('Unhandled all SQL: ' + normalized);
        },
        async run() {
          if (normalized.startsWith('INSERT INTO studio_sequences')) {
            const [client_id, type, intent, topic, goal, trigger_word, params_json, output_json, manual_prompt, status, review_note, created_at, updated_at] = this.values;
            const id = db.nextId++;
            db.sequences.push({ id, client_id, type, intent, topic, goal, trigger_word, params_json, output_json, manual_prompt, status, review_note, created_at, updated_at });
            return { meta: { last_row_id: id, changes: 1 } };
          }
          if (normalized.includes(\"SET status='review'\")) {
            const [updated_at, id] = this.values;
            const row = db.sequences.find((item) => item.id === Number(id));
            if (row) {
              row.status = 'review';
              row.review_note = null;
              row.updated_at = updated_at;
              return { meta: { changes: 1 } };
            }
            return { meta: { changes: 0 } };
          }
          if (normalized.includes('SET status=?, review_note=?, updated_at=?')) {
            const [status, review_note, updated_at, id] = this.values;
            const row = db.sequences.find((item) => item.id === Number(id));
            if (row) {
              row.status = status;
              row.review_note = review_note;
              row.updated_at = updated_at;
              return { meta: { changes: 1 } };
            }
            return { meta: { changes: 0 } };
          }
          if (normalized.startsWith('DELETE FROM studio_sequences')) {
            const before = db.sequences.length;
            db.sequences = db.sequences.filter((row) => row.id "'!== Number(this.values[0]));
            return { meta: { changes: before - db.sequences.length } };
          }
          throw new Error('"'Unhandled run SQL: ' + normalized);
        },
      };
    },
  };
  return db;
}

function authedRequest(body, token = 'portal-token') {
  return new Request('https://local.test/api', {
    method: 'POST',
    headers: { 'content-type': 'application/json', 'x-portal-token': token },
    body: JSON.stringify(body),
  });
}

function assertDesign(output, label) {
  if ("'!output?.slides?.length) throw new Error(label + '"': missing slides');
  for (const slide of output.slides) {
    if ("'!slide.design || !slide.design_direction) throw new Error(label + '"': missing design aliases');
    const imageClass = slide.design.image_class?.type || slide.design_direction.image_class;
    if ("'!allowedImageClasses.has(imageClass)) throw new Error(label + '"': invalid image class ' + imageClass);
    if ("'!Array.isArray(slide.design.annotation) || !slide.design.annotation.length) throw new Error(label + '"': missing annotation');
    if ("'!slide.design.treatment) throw new Error(label + '"': missing treatment');
    if ("'!Array.isArray(slide.design.chips)) throw new Error(label + '"': chips must be array');
  }
}

