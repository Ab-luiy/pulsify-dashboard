+      { n: 4, role: "type 3", headline: "Belief type", design: { image_class: "device-mockup" } },
+      { n: 5, role: "proof and CTA", headline: "Close", cta: "DM SYSTEM", design: { image_class: "proof-wall" } },
+    ],
