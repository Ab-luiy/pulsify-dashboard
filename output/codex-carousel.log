index 9757d82ae9958390bca59dfca82616f3a0b30a01..dd5605701c1ea2e359a90f630bd7d6f2246b50f7
--- a/output/standard-preview/portal/index.html
+++ b/output/standard-preview/portal/index.html
@@ -444,6 +444,62 @@
       gap: 16px;
       align-items: start;
     }
+    .carousel-studio-block {
+      display: grid;
+      gap: 16px;
+      margin-top: 24px;
+      padding-top: 24px;
+      border-top: 1px solid var(--ui-line);
+    }
+    .carousel-studio-head {
+      display: flex;
+      justify-content: space-between;
+      align-items: end;
+      gap: 16px;
+    }
+    .carousel-studio-head h3 { margin: 0 0 5px; font-size: 22px; letter-spacing: -.04em; }
+    .carousel-studio-head p { margin: 0; color: var(--ui-ink-2); font-size: 12px; line-height: 1.58; }
