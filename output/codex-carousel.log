+                      ${slide.body ? `<p>${esc(slide.body)}</p>` : ""}
+                      ${slide.cta ? `<p class="carousel-cta">${esc(slide.cta)}</p>` : ""}
+                    </div>
+                    ${renderDesignDirection(slide)}
