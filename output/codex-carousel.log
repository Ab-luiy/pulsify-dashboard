+async function testImpersonationReadOnly() {
+  const { env, db } = await createEnv();
+  db.carousels.push({
+    id: db.nextId++,
+    client_id: "alpha",
+    structure: "philosophy",
+    topic: "Beliefs",
+    goal: "reach",
