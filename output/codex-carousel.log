+  db.configs.push(
+    { client: "alpha", client_name: "Alpha Coach", page_content_json: "{}", portal_token_hash: await sha256Hex(alphaToken) },
+    { client: "beta", client_name: "Beta Coach", page_content_json: "{}", portal_token_hash: await sha256Hex(betaToken) },
+  );
+  db.brain.push({
