+                      ${slide.headline ? `<strong>${esc(slide.headline)}</strong>` : `<span class="pill">Copy pending in manual prompt</span>`}
+                      ${slide.body ? `<p>${esc(slide.body)}</p>` : ""}
+                      ${slide.cta ? `<p class="carousel-cta">${esc(slide.cta)}</p>` : ""}
+                    </div>
