    function toggleThought(index) {
      state.reels.thoughts = state.reels.thoughts.map((thought, thoughtIndex) => ({
        ...thought,
        open: thoughtIndex === index ? !thought.open : thought.open,
      }));
      saveThoughts();
      renderThoughts();
