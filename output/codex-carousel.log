+      renderCarouselReviewQueue();
+      showMessage($("globalMessage"), `Carousel ${action === "approve" ? "approved" : "rejected"}.`, "success");
+    } catch (error) {
+      if (state.key) showMessage($("globalMessage"), error.message || `Could not ${action} this carousel.`, "error");
+    }
+  }
+
