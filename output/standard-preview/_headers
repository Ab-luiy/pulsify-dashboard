

# App code must revalidate on every load (ETag makes the hit cheap). Without this,
# browsers kept scripts for four hours after a deploy.
/shared/*
  Cache-Control: no-cache
/admin/*
  Cache-Control: no-cache
/portal/*
  Cache-Control: no-cache
/onboard/*
  Cache-Control: no-cache
/admin.html
  Cache-Control: no-cache
/portal.html
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache
